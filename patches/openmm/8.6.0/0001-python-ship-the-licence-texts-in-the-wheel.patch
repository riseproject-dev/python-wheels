From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 2 Oct 2026 23:49:48 +0000
Subject: [PATCH] python: ship the licence texts in the wheel

The Python wheel carries no licence file at all: dist-info has only
METADATA/WHEEL/RECORD/top_level.txt, and OpenMM.libs/ holds the core
libraries and plugins without any notice. The MIT licence covering the
API, Reference and CPU platforms requires the notice to accompany
copies, the OpenCL plugins in the wheel are LGPL, and the bundled
SFMT, Hilbert, irrXML, L-BFGS and VkFFT code carry their own notices --
all of which upstream already collects in docs-source/licenses/.

Stage that directory next to setup.py and list it in license_files, so
Licenses.txt, LGPL.txt and GPL.txt land in dist-info/licenses.

Upstream's own PyPI wheels have the same gap on every platform.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against openmm/openmm]
---
 wrappers/python/CMakeLists.txt | 1 +
 wrappers/python/setup.py       | 1 +
 2 files changed, 2 insertions(+)

diff --git a/wrappers/python/CMakeLists.txt b/wrappers/python/CMakeLists.txt
index b7400fa..93d72bf 100644
--- a/wrappers/python/CMakeLists.txt
+++ b/wrappers/python/CMakeLists.txt
@@ -13,6 +13,7 @@ file(MAKE_DIRECTORY ${OPENMM_PYTHON_STAGING_DIR}/simtk/openmm)
 file(MAKE_DIRECTORY ${OPENMM_PYTHON_STAGING_DIR}/simtk/unit)
 file(MAKE_DIRECTORY ${OPENMM_PYTHON_STAGING_DIR}/src/swig_doxygen/swig_lib/python)
 file(MAKE_DIRECTORY ${OPENMM_PYTHON_STAGING_DIR}/tests)
+file(COPY "${CMAKE_SOURCE_DIR}/docs-source/licenses/" DESTINATION "${OPENMM_PYTHON_STAGING_DIR}/licenses")
 
 ##############################################################################
 ### Identify files that need to be copied from source area to staging area ###
diff --git a/wrappers/python/setup.py b/wrappers/python/setup.py
index 356e6de..f008244 100644
--- a/wrappers/python/setup.py
+++ b/wrappers/python/setup.py
@@ -135,6 +135,7 @@ def buildKeywordDictionary(major_version_num=MAJOR_VERSION_NUM,
     setupKeywords["author"]            = "Peter Eastman"
     setupKeywords["license"]           = \
     "Python Software Foundation License (BSD-like)"
+    setupKeywords["license_files"]     = ["licenses/*.txt"]
     setupKeywords["url"]               = "https://openmm.org"
     setupKeywords["download_url"]      = "https://openmm.org"
     setupKeywords["packages"]          = [
