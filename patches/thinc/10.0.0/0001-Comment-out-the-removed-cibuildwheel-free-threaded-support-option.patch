From 7383053d05c61d5c6b60aa44f2908c3b779af44f Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 27 Aug 2026 02:40:35 +0200
Subject: [PATCH] Comment out the removed cibuildwheel free-threaded-support
 option

cibuildwheel dropped `free-threaded-support` in 3.0: the option is now
rejected outright ("Option 'free-threaded-support' not supported in a
config file"), so any build of this tag with a current cibuildwheel fails
before it starts.

Upstream made exactly this change in 6f3a08b1 ("Hack at free-threaded
option"), which landed after v9.1.1 was tagged.

Upstream-Status: Backport [https://github.com/explosion/thinc/commit/6f3a08b1c076013790156852555410ba559e80ef]
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 9981b5e..c46c517 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -15,7 +15,7 @@ build-backend = "setuptools.build_meta"
 build = "*"
 skip = "pp* cp36* cp37* cp38*"
 test-skip = ""
-free-threaded-support = false
+#free-threaded-support = false
 
 archs = ["native"]
 
