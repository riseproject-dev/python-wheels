From 04df5386716615fcd126e78ff3289bec30a6c643 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 14 Oct 2026 01:38:30 +0000
Subject: [PATCH] Switch to non-deprecated API to call callbacks

PyEval_CallObject was deprecated in Python 3.9 and removed from the
headers in Python 3.13, so compiling against 3.13+ leaves an implicit
declaration that GCC 14 rejects as an error (and that would otherwise
fail at import with an undefined symbol). PyObject_CallObject is the
documented, equivalent replacement.

This is the same change pyinstrument made to its vendored copy of this
module (pyinstrument/low_level/stat_profile.c) after folding
pyinstrument_cext into pyinstrument 4.0.

Upstream-Status: Backport [https://github.com/joerick/pyinstrument/commit/1fdf8a0c48d549bff936530c1d26aa6a008113e8]
---
 pyinstrument_cext.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyinstrument_cext.c b/pyinstrument_cext.c
index 0777b50..2872cf1 100644
--- a/pyinstrument_cext.c
+++ b/pyinstrument_cext.c
@@ -184,7 +184,7 @@ call_target(ProfilerState *pState, PyFrameObject *frame, int what, PyObject *arg
     PyTuple_SET_ITEM(args, 2, arg);
 
     /* call the Python-level target function */
-    result = PyEval_CallObject(pState->target, args);
+    result = PyObject_CallObject(pState->target, args);
 
     PyFrame_LocalsToFast(frame, 1);
     if (result == NULL)
-- 
2.43.0

