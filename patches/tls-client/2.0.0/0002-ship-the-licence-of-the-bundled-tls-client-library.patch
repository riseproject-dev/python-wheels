From a2c93bea534ce374c1873d5ae4c4d20365aabb14 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 12:34:56 +0000
Subject: [PATCH 2/2] ship the licence of the bundled tls-client library

Upstream-Status: To upstream [not submitted yet; affects every platform wheel upstream publishes, not only riscv64]

Every wheel bundles one prebuilt bogdanfinn/tls-client shared library,
which is distributed under its own BSD-4-Clause licence. Its clause 2
requires binary redistributions to reproduce the copyright notice, but
license-files only lists this project's own MIT LICENSE, so the
library's notice never reaches the wheel.

Add the library's LICENSE as of the v1.16.0 tag that
scripts/fetch_library.py pins, as LICENSE.tls-client, to license-files
and to the sdist include list, so it lands in
dist-info/licenses/ next to LICENSE.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 LICENSE.tls-client | 27 +++++++++++++++++++++++++++
 pyproject.toml     |  4 ++--
 2 files changed, 29 insertions(+), 2 deletions(-)
 create mode 100644 LICENSE.tls-client

diff --git a/LICENSE.tls-client b/LICENSE.tls-client
new file mode 100644
index 0000000..1ec3d9e
--- /dev/null
+++ b/LICENSE.tls-client
@@ -0,0 +1,27 @@
+Copyright (c) 2023, Bogdan Finn
+All rights reserved.
+
+Redistribution and use in source and binary forms, with or without
+modification, are permitted provided that the following conditions are met:
+1. Redistributions of source code must retain the above copyright
+   notice, this list of conditions and the following disclaimer.
+2. Redistributions in binary form must reproduce the above copyright
+   notice, this list of conditions and the following disclaimer in the
+   documentation and/or other materials provided with the distribution.
+3. All advertising materials mentioning features or use of this software
+   must display the following acknowledgement:
+   This product includes software developed by the <organization>.
+4. Neither the name of the <organization> nor the
+   names of its contributors may be used to endorse or promote products
+   derived from this software without specific prior written permission.
+
+THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDER ''AS IS'' AND ANY
+EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED
+WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE
+DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE
+FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
+DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
+SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER
+CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,
+OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE
+USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
\ No newline at end of file
diff --git a/pyproject.toml b/pyproject.toml
index e459c5e..feb7820 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -8,7 +8,7 @@ dynamic = ["version"]
 description = "Advanced Python HTTP Client."
 readme = "README.md"
 license = "MIT"
-license-files = ["LICENSE"]
+license-files = ["LICENSE", "LICENSE.tls-client"]
 authors = [{ name = "Florian Zager" }]
 requires-python = ">=3.10"
 dependencies = []
@@ -38,7 +38,7 @@ Source = "https://github.com/FlorianREGAZ/Python-Tls-Client"
 path = "tls_client/__version__.py"
 
 [tool.hatch.build.targets.sdist]
-include = ["/tls_client", "/hatch_build.py", "/scripts/fetch_library.py", "/README.md", "/LICENSE"]
+include = ["/tls_client", "/hatch_build.py", "/scripts/fetch_library.py", "/README.md", "/LICENSE", "/LICENSE.tls-client"]
 
 # hatch_build.py adds the native library and tags the wheel for its platform.
 [tool.hatch.build.targets.wheel.hooks.custom]
