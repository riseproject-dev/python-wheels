From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 12:00:00 +0000
Subject: [PATCH] ship LICENSE.txt in the wheel's dist-info

meson-python only copies the files named in `[project] license-files`
into `.dist-info/licenses/` and, unlike setuptools and scikit-build-core,
has no PEP 639 default glob to fall back on when the key is absent. With
just `license = "BSD-3-Clause"`, every 1.1.0 wheel on PyPI ships no
licence text, which the BSD-3-Clause terms require for binary
redistribution.

Upstream-Status: To upstream [not yet submitted; no fork of numpy/numpy-financial to push from]
---
 pyproject.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/pyproject.toml b/pyproject.toml
index 842b423..2cf8d2e 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -12,6 +12,7 @@ dynamic = ['version']
 requires-python = ">=3.13"
 description = "Simple financial functions"
 license = "BSD-3-Clause"
+license-files = ["LICENSE.txt"]
 authors = [{name = "Travis E. Oliphant et al."}]
 maintainers = [{ name = "Numpy Financial Developers", email = "numpy-discussion@python.org" }]
 readme = "README.md"
