From b1622f5f49de75970c41a84938e5ac78e5bbe5e Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] pyproject.toml: match this tag's own version string

Upstream-Status: Inappropriate [this tag's own pyproject.toml bakes in a version string one build ahead of the tag that carries it, confirmed from this PR's own first CI run (`version 0.3.31.22.1 is not declared in the package YAML`); harmless to pin back down for this one historical tag]

Checking out `v0.3.31.22.0` gives a `pyproject.toml` whose `version` field
already reads "0.3.31.22.1" - one build ahead of the tag name itself, and
there is no `v0.3.31.22.1` tag to check out instead. The manylinux wheel
this repo already publishes for 0.3.31.22.0 (built elsewhere, before this
workflow existed) reports "0.3.31.22.0", so building the musllinux wheel
straight off this tag would report a different version than the sibling
manylinux wheel of the same nominal release - confirmed to otherwise fail
this repo's own publish validation, which requires the wheel's version to
match the declared `docs/packages/scipy-openblas64.yaml` entry.
tools/build_prepare_wheel.sh's own version check only requires a prefix
match against the OpenBLAS pkgconfig version (e.g. "0.3.31"), so pinning
the last component back down to the tag's own number keeps both the
manylinux and musllinux wheels of this release reporting the same
version, with no effect on that check.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 01c03a4..bc0f195 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -9,7 +9,7 @@ build-backend = "setuptools.build_meta"
 [project]
 name = "scipy-openblas64"
 # v0.3.31-22-g5ffbf38b
-version = "0.3.31.22.1"
+version = "0.3.31.22.0"
 requires-python = ">=3.7"
 description = "Provides OpenBLAS for python packaging"
 readme = "README.md"
--
2.43.0
