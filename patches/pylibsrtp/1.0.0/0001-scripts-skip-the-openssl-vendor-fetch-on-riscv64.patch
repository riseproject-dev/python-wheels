From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 6 Sep 2026 00:00:00 +0200
Subject: [PATCH] scripts: skip the OpenSSL vendor fetch on riscv64

aiortc/aioquic-openssl only publishes prebuilt OpenSSL tarballs for the
platforms upstream's own CI targets (x86_64/aarch64/i686 manylinux and
musllinux, macOS, Windows); there is no riscv64 entry, so
fetch-vendor.py's curl+tar always fails on that platform. Use the
build environment's own OpenSSL instead, the same way this script
already special-cases i686 to work around a different vendor gap.

Upstream-Status: Inappropriate [no riscv64 build in aiortc/aioquic-openssl; unrelated to any platform upstream's own CI targets]
---
 scripts/build-libsrtp.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/scripts/build-libsrtp.py b/scripts/build-libsrtp.py
index 3940581..6cb781d 100644
--- a/scripts/build-libsrtp.py
+++ b/scripts/build-libsrtp.py
@@ -39,7 +39,13 @@ if platform.system() == "Darwin" and "ARCHFLAGS" in os.environ:
     archs = [x for x in os.environ["ARCHFLAGS"].split() if x != "-arch"]
     cmake_args.append("-DCMAKE_OSX_ARCHITECTURES=" + ";".join(archs))

-run(["python", "scripts/fetch-vendor.py", dest_dir])
+if platform.system() == "Linux" and platform.machine() == "riscv64":
+    # No prebuilt OpenSSL for riscv64 in aiortc/aioquic-openssl; the build
+    # environment installs its own OpenSSL dev package instead (see the
+    # CIBW_BEFORE_ALL_LINUX step that installs openssl-devel).
+    pass
+else:
+    run(["python", "scripts/fetch-vendor.py", dest_dir])

 run(["git", "clone", "https://github.com/cisco/libsrtp/", source_dir])
 os.chdir(source_dir)
--
