From 17ec8da55f97261781ede418ee606ed56d6e6b21 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 2 Oct 2026 15:52:22 +0000
Subject: [PATCH] ship the vendored Eigen licences in the wheel

Upstream-Status: To upstream [not yet submitted; every scikit-survival wheel on PyPI has the same gap, so it needs raising with the maintainer rather than a drive-by PR]

sksurv/linear_model/_coxnet.pyx compiles the sksurv/linear_model/src/eigen
submodule's Eigen/Core headers (header-only) straight into the
sksurv.linear_model._coxnet extension. Eigen/Core is MPL-2.0, except
Eigen/src/Core/arch/Default/BFloat16.h, which Eigen/Core includes
unconditionally and which carries the TensorFlow Authors' Apache-2.0
notice. The built wheel ships only scikit-survival's own COPYING:
`license-files = ["COPYING"]` is an explicit PEP 639 list with no default
glob behind it, so Eigen's COPYING.* files never reach dist-info/licenses/.

List COPYING.MPL2 and COPYING.APACHE in place from the submodule. The
other Eigen notices are not reachable from Eigen/Core: Half.h's Fabian
Giesen notice grants redistribution unconditionally, and the *_BLAS.h /
*_MKL.h files are only compiled in with EIGEN_USE_BLAS / EIGEN_USE_MKL,
which scikit-survival never defines.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 pyproject.toml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 5f6fb0b..b16056b 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -22,7 +22,11 @@ authors = [
     {name = "Sebastian Pölsterl", email = "sebp@k-d-w.org"}
 ]
 license = "GPL-3.0-or-later"
-license-files = ["COPYING"]
+license-files = [
+    "COPYING",
+    "sksurv/linear_model/src/eigen/COPYING.MPL2",
+    "sksurv/linear_model/src/eigen/COPYING.APACHE",
+]
 requires-python = ">=3.11"
 classifiers = [
     "Development Status :: 4 - Beta",
-- 
2.43.0

