From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 13 Oct 2026 10:53:51 +0000
Subject: [PATCH] bundle the vendored swmm-solver LICENSE in the wheel

Upstream-Status: To upstream [not yet submitted; the same gap exists in every swmm-toolkit wheel on PyPI, so this needs a maintainer discussion rather than a drive-by PR]

The wheel statically links the swmm-solver git submodule
(OpenWaterAnalytics/Stormwater-Management-Model, MIT), but license-files
never lists its LICENSE file, so it never reaches
*.dist-info/licenses/ and the built wheel ships only swmm-toolkit's own
CC0/openmp notices. Add it so the MIT notice travels with the binary that
statically embeds its code.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 swmm-toolkit/pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/swmm-toolkit/pyproject.toml b/swmm-toolkit/pyproject.toml
index 48c313b..e93562d 100644
--- a/swmm-toolkit/pyproject.toml
+++ b/swmm-toolkit/pyproject.toml
@@ -8,7 +8,7 @@ version = "0.17.0"
 description = "PySWMM SWMM Python Toolkit"
 readme = { file = "README.md", content-type = "text/markdown" }
 license = "CC0-1.0 AND (MIT OR Apache-2.0)"
-license-files = ["LICEN[CS]E*", "AUTHORS", "extern/openmp.LICENSE"]
+license-files = ["LICEN[CS]E*", "AUTHORS", "extern/openmp.LICENSE", "swmm-solver/LICENSE"]
 authors = [{ name = "See AUTHORS" }]
 maintainers = [{ email = "bemcdonnell@gmail.com" }]
 keywords = ["swmm5", "swmm", "stormwater", "hydraulics", "hydrology"]
