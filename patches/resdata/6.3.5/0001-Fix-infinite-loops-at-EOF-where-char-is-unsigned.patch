         if (fscanf(stream, "%32s", buffer.get()) == 1) {
             if (strcmp(buffer.get(), RD_COMMENT_STRING) == 0) {
                 // We have read a comment marker - just read up to the end of line.
-                char c;
+                int c;
                 while (true) {
                     c = fgetc(stream);
                     if (c == newline)
