+++ b/lib/resdata/rd_kw.cpp
@@ -1043,7 +1043,7 @@ static bool rd_kw_qskip(FILE *stream) {
     const char newline = '\n';
     const char tab = '\t';
     bool OK = true;
-    char c;
+    int c;
     bool cont = true;
     while (cont) {
         c = fgetc(stream);
