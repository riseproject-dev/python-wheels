From c79b8cf8377c3e7d5dff0ea0bce1a98eb9f8e7da Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 26 Aug 2026 17:42:59 +0200
Subject: [PATCH] MAINT: fix `compat.scipy.apply_where` for scipy-internal
 change

The move from `scipy._lib.array_api_extra` to
`scipy._external.array_api_extra` will land in SciPy 1.18.0

This is a follow-up fix to PR 9543, it fixes 25 test failures
with scipy's main branch.

Backported onto v0.14.6 unchanged; upstream carries it on main only, so no
0.14.x release contains it yet. Without it every statsmodels code path that
goes through `compat.scipy.apply_where` raises under SciPy >= 1.18 -- both
the new module path and the `scipy._lib._util._lazywhere` fallback the
except branch reaches for were removed -- which is 41 failures in the wheel
test suite once pypi.riseproject.dev serves scipy 1.18.1.

Upstream-Status: Backport [https://github.com/statsmodels/statsmodels/commit/d72a99c908c939cc744312b1c33facb754199295]
---
 statsmodels/compat/scipy.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/statsmodels/compat/scipy.py b/statsmodels/compat/scipy.py
index 2649c87..dca2401 100644
--- a/statsmodels/compat/scipy.py
+++ b/statsmodels/compat/scipy.py
@@ -126,7 +126,11 @@ def apply_where(  # type: ignore[explicit-any] # numpydoc ignore=PR01,PR02
 
     """
     try:
-        import scipy._lib.array_api_extra as xpx
+        try:
+            # From scipy >= 1.18.0
+            import scipy._external.array_api_extra as xpx
+        except (ImportError, AttributeError):
+            import scipy._lib.array_api_extra as xpx
 
         return xpx.apply_where(cond, args, f1, f2, fill_value=fill_value)
     except (ImportError, AttributeError):
-- 
