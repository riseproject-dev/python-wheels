From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH] package licences of the vendored libraries

The wheel ships libpng, libjpeg-turbo, OpenEXR (IlmBase/IlmImf), pugixml
and struct-jit as shared libraries next to libmitsuba.so, links rgb2spec
statically, and compiles nanobind (with robin_map) and fast_float into its
extensions, but only carries Mitsuba's own top-level LICENSE (confirmed
against the released PyPI wheel's dist-info/licenses/). All of them
require their notice to travel with binary redistributions.

pyproject.toml declares no `license-files`, so scikit-build-core falls
back to its root-only `LICEN[CS]E*` glob. Listing the vendored files
explicitly copies each into dist-info/licenses/<same relative path>;
the top-level LICENSE is packaged as before. tinyformat (BSL-1.0) needs
no notice in binary form; fast_float is triple-licensed and taken under
MIT.

Upstream-Status: To upstream [not yet submitted; same gap on every architecture upstream already ships, not riscv64-specific]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -18,6 +18,19 @@ dependencies = [
   "drjit==1.5.0",
 ]
 requires-python = ">=3.9"
+license-files = [
+    "LICENSE",
+    "ext/fastfloat/LICENSE-MIT",
+    "ext/libjpeg-turbo/LICENSE.md",
+    "ext/libjpeg-turbo/README.ijg",
+    "ext/libpng/LICENSE",
+    "ext/nanobind/LICENSE",
+    "ext/nanobind/ext/robin_map/LICENSE",
+    "ext/openexr/LICENSE.md",
+    "ext/pugixml/LICENSE.md",
+    "ext/rgb2spec/LICENSE",
+    "ext/struct-jit/LICENSE",
+]
 authors = [
     { name = "Wenzel Jakob", email = "wenzel.jakob@epfl.ch" }
 ]
