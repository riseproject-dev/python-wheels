From b4ab37d5bcf1805c25611cf3f04823958c4fd870 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 6 Sep 2026 23:38:29 +0200
Subject: [PATCH] ship third_party/cmark's licence alongside cmarkgfm's own

Upstream-Status: To upstream [not yet submitted; the same gap exists in every cmarkgfm wheel on PyPI, so this needs a maintainer discussion rather than a drive-by PR]

The extension statically links the vendored cmark-gfm C sources
(third_party/cmark, a git submodule), which carry their own BSD-2-Clause
notice from John MacFarlane plus several MIT-derived file headers. Those
terms require the copyright notice to travel with binary redistributions,
but pyproject.toml's license metadata names only cmarkgfm's own
LICENSE.txt, so the built wheel ships a single notice covering the
wrapper alone.

Naming the vendored file in place keeps the patch to one line and lets
it track the submodule: setuptools resolves each license-files entry
relative to the project root and preserves its path in the wheel, so it
lands as dist-info/licenses/third_party/cmark/COPYING.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 pyproject.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/pyproject.toml b/pyproject.toml
index 1f852d9..d45f01a 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -9,6 +9,7 @@ description = "Minimal bindings to GitHub's fork of cmark"
 readme = "README.rst"
 requires-python = ">=3.9"
 license = "MIT"
+license-files = ["LICENSE.txt", "third_party/cmark/COPYING"]
 authors = [
     {name = "The Python Packaging Authority", email = "me@thea.codes"},
     {email = "pypa-dev@googlegroups.com"}
