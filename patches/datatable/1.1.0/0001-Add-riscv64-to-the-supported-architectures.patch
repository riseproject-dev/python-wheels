From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 14 Oct 2026 19:11:15 +0000
Subject: [PATCH 1/8] Add riscv64 to the supported architectures

src/core/utils/macros.h recognises only x86_64, little-endian ppc64 and
aarch64, and stops every translation unit on any other architecture:

  src/core/utils/macros.h: error: #error Unknown Platform

Add a DT_ARCH_RISCV64 branch for 64-bit RISC-V. The DT_ARCH_* macros
only select the spin-wait instruction in parallel/semaphore.h, where
riscv64 takes the portable std::this_thread::yield() path like every
non-x86 platform.

Likewise, ci/ext.py adds "-m64" to the link flags on every non-arm64
platform, on the assumption that the only other 64-bit targets are
x86_64 and ppc64. RISC-V GCC has no -m32/-m64 switches (the ABI is
selected with -march/-mabi), so the link step fails with

  g++: error: unrecognized command-line option '-m64'

Treat riscv64 like arm64 and leave the flag out.

Upstream-Status: To upstream [upstream has merged no external code change since the 1.1.0 release]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 ci/ext.py               | 3 ++-
 src/core/utils/macros.h | 6 +++++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/ci/ext.py b/ci/ext.py
index 75ba516..63258f0 100644
--- a/ci/ext.py
+++ b/ci/ext.py
@@ -211,6 +211,7 @@ def build_extension(cmd, verbosity=3):
     arch = platform.machine()  # 'x86_64' or 'ppc64le' or 'arm64' or 'aarch64'
     ppc64 = ("ppc64" in arch or "powerpc64" in arch)
     arm64 = (arch == "arm64") or (arch == "aarch64")
+    riscv64 = (arch == "riscv64")
 
     windows = (sys.platform == "win32")
     macos = (sys.platform == "darwin")
@@ -308,7 +309,7 @@ def build_extension(cmd, verbosity=3):
         ext.compiler.add_linker_flag("-shared")
         ext.compiler.add_linker_flag("-g")
 
-        if not arm64:
+        if not (arm64 or riscv64):
             ext.compiler.add_linker_flag("-m64")
         if macos:
             ext.compiler.add_linker_flag("-undefined", "dynamic_lookup")
diff --git a/src/core/utils/macros.h b/src/core/utils/macros.h
index 6a65180..76f1b40 100644
--- a/src/core/utils/macros.h
+++ b/src/core/utils/macros.h
@@ -82,6 +82,7 @@
 #define DT_ARCH_X86_64    0
 #define DT_ARCH_PPC64_LE  0
 #define DT_ARCH_AARCH64   0
+#define DT_ARCH_RISCV64   0
 
 #if DT_OS_WINDOWS
   #if defined(_M_AMD64) || defined(__x86_64)
@@ -99,10 +100,13 @@
   #elif defined(__aarch64__)
     #undef  DT_ARCH_AARCH64
     #define DT_ARCH_AARCH64 1
+  #elif defined(__riscv) && __riscv_xlen == 64
+    #undef  DT_ARCH_RISCV64
+    #define DT_ARCH_RISCV64 1
   #endif
 #endif
 
-#if DT_ARCH_X86_64 + DT_ARCH_PPC64_LE + DT_ARCH_AARCH64 != 1
+#if DT_ARCH_X86_64 + DT_ARCH_PPC64_LE + DT_ARCH_AARCH64 + DT_ARCH_RISCV64 != 1
   #error Unknown Platform
 #endif
 
