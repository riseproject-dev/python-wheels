From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Maceira <ivomaceira@gmail.com>
Date: Thu, 11 Sep 2025 01:59:34 +0200
Subject: [PATCH 7/8] Use np.nan instead of np.NaN

np.NaN, alias of np.nan, was removed in numpy 2.0, so three tests in
tests/ijby/test-sort.py fail with AttributeError against numpy 2.

Upstream-Status: Submitted [https://github.com/h2oai/datatable/pull/3511]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 tests/ijby/test-sort.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tests/ijby/test-sort.py b/tests/ijby/test-sort.py
index 6a21c5a..de05e98 100644
--- a/tests/ijby/test-sort.py
+++ b/tests/ijby/test-sort.py
@@ -1021,7 +1021,7 @@ def test_sort_with_reverse_list_false_true(numpy):
     {
     'A': ['o1','o2','o3','o4','o5'],
     'B': ['c1','c1','c2','c2','c3'],
-    'C': [5, 1, 3, numpy.NaN, numpy.NaN]
+    'C': [5, 1, 3, numpy.nan, numpy.nan]
     })
     EXP = DT[:, :, dt.sort(f.B, -f.A)]
     RES1 = DT[:, :, dt.sort("B", "A", reverse=[False, True])]
@@ -1037,7 +1037,7 @@ def test_sort_with_reverse_list_true_true(numpy):
     {
     'A': ['o1', 'o2', 'o3', 'o4', 'o5'],
     'B': ['c1', 'c1', 'c2', 'c2', 'c3'],
-    'C': [5,1,3, numpy.NaN,numpy.NaN]
+    'C': [5,1,3, numpy.nan,numpy.nan]
     })
     EXP = DT[:, :, dt.sort(-f.A, -f.B)]
     RES1 = DT[:, :, dt.sort("B", "A", reverse=[True, True])]
@@ -1055,7 +1055,7 @@ def test_reverse_list_error(numpy):
     {
     'A': ['o1', 'o2', 'o3', 'o4', 'o5']*25,
     'B': ['c1', 'c1', 'c2', 'c2', 'c3']*25,
-    'C': [5, 1, 3, numpy.NaN, numpy.NaN]*25
+    'C': [5, 1, 3, numpy.nan, numpy.nan]*25
     })
     with pytest.raises(ValueError, match=msg):
         DT[:, :, dt.sort(0, 1, reverse=[True])]
-- 
