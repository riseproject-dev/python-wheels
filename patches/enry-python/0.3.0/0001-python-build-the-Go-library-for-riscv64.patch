From 6572493398b6762a0479ba18cb916f1e302197bd Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 13:28:27 +0000
Subject: [PATCH] python: build the Go library for riscv64

Upstream-Status: To upstream [not yet submitted; python-wheels does not open issues/PRs on third-party repos]

build_go_library() maps platform.machine() to a GOARCH and raises
"Unsupported architecture" for anything outside x86_64/amd64 and
arm64/aarch64, so a wheel build on linux/riscv64 stops before go build
runs. Go supports -buildmode=c-shared on linux/riscv64
(internal/platform/supported.go) and ./shared only depends on the
standard library and go-enry itself, so mapping riscv64 to GOARCH
riscv64 is the only change needed.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 python/setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/python/setup.py b/python/setup.py
index 6540b3b..272788c 100644
--- a/python/setup.py
+++ b/python/setup.py
@@ -23,7 +23,7 @@ def build_go_library(destination):
     if system not in {"Darwin", "Linux"}:
         raise RuntimeError("enry native builds support Linux and macOS only")
     architecture = {"x86_64": "amd64", "amd64": "amd64", "arm64": "arm64",
-                    "aarch64": "arm64"}.get(platform.machine().lower())
+                    "aarch64": "arm64", "riscv64": "riscv64"}.get(platform.machine().lower())
     if architecture is None:
         raise RuntimeError(f"Unsupported architecture: {platform.machine()}")
     destination = Path(destination).resolve()
