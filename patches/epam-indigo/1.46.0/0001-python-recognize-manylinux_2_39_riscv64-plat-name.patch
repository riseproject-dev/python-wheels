From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 13 Oct 2026 00:00:00 +0000
Subject: [PATCH] python: recognize manylinux_2_39_riscv64 --plat-name

Upstream-Status: Inappropriate [riscv64 is not one of setup.py's hardcoded --plat-name values]

api/python/setup.py maps bdist_wheel's --plat-name to the
indigo/lib/<os>-<arch>/*.so glob it bundles, from a hardcoded list of
platform strings (one per OS/arch upstream builds for in CI) and raises
ValueError for anything else. Add the riscv64 case, mapping
manylinux_2_39_riscv64 to lib/linux-riscv64/*.so, matching the existing
manylinux2014_aarch64 entry.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 api/python/setup.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/api/python/setup.py b/api/python/setup.py
index b3d934b..37f3390 100644
--- a/api/python/setup.py
+++ b/api/python/setup.py
@@ -62,6 +62,8 @@ if sys.argv[1] == "bdist_wheel":
                 INDIGO_LIBS = "lib/darwin-aarch64/*.dylib"
             elif PLATFORM_NAME == "manylinux2014_aarch64":
                 INDIGO_LIBS = "lib/linux-aarch64/*.so"
+            elif PLATFORM_NAME == "manylinux_2_39_riscv64":
+                INDIGO_LIBS = "lib/linux-riscv64/*.so"
             elif PLATFORM_NAME == "manylinux1_x86_64":
                 INDIGO_LIBS = "lib/linux-x86_64/*.so"
             elif PLATFORM_NAME == "manylinux1_i686":
@@ -78,7 +80,7 @@ if sys.argv[1] == "bdist_wheel":
         raise ValueError(
             "Wrong --plat-name value! Should be one of: macosx_11_0_arm64, "
             "macosx_11_0_x86_64, manylinux1_x86_64, manylinux2014_aarch64, "
-            "manylinux1_i686, win_amd64, win32"
+            "manylinux_2_39_riscv64, manylinux1_i686, win_amd64, win32"
         )

     if not glob.glob(os.path.join(indigo_python_directory, INDIGO_LIBS)):
--
2.43.0
