     ("neos-3083819-nubu.mps.gz",        6307996.0,        2000),
-    ("markshare_4_0.mps.gz",           1.0,              2000),
+    ("markshare_4_0.mps.gz",           1.0,              4000),
     ("irp.mps.gz",                     12159.49283539698, 2000),
