From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 13 Oct 2026 00:00:00 +0000
Subject: [PATCH] bindings/py: bump abi3 floor to py39

Upstream-Status: Inappropriate [manylinux_2_39_riscv64 ships no cp38 interpreter]

The riscv64 manylinux image's oldest available CPython is cp39 (no cp38),
so a wheel built here and tagged cp38-abi3 (this crate's abi3-py38
feature) would never actually be compiled or tested against its own
declared floor. Bump the pyo3 abi3 feature to abi3-py39 so the riscv64
wheel's tag matches the oldest interpreter it can be built and tested on;
every other platform's wheel is unaffected.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 bindings/py/Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bindings/py/Cargo.toml b/bindings/py/Cargo.toml
index f185b90..e6226a1 100644
--- a/bindings/py/Cargo.toml
+++ b/bindings/py/Cargo.toml
@@ -10,5 +10,5 @@ crate-type = ["cdylib"]
 
 [dependencies]
 earshot = { path = "../.." }
-pyo3 = { version = "0.29", features = [ "extension-module", "abi3-py38" ] }
+pyo3 = { version = "0.29", features = [ "extension-module", "abi3-py39" ] }
 numpy = "0.29"
-- 
2.43.0

