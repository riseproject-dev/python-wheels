From 7ab38fcdd60ba8d69db75280c36e868f393c51fc Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 9 Nov 2026 22:38:14 +0000
Subject: [PATCH] Drop the unused vectorbt dependency from install_requires

vectorbt pulls in numba>=0.66, which pulls in llvmlite - neither has a
riscv64 wheel on pypi.riseproject.dev, nor does either build from sdist
in the manylinux_riscv64 image without an LLVM toolchain it doesn't
carry. vectorbt itself is never imported anywhere in riskfolio's own
source or test suite (confirmed via GitHub code search across the
repo: the only hits for "vectorbt" are docs/README/CHANGELOG prose,
requirements.txt and this install_requires entry) - it only backs an
optional, undocumented-in-code backtesting integration, so dropping it
from install_requires does not remove any functionality riskfolio.*
exercises.

Upstream-Status: Inappropriate [riscv64: vectorbt's numba/llvmlite chain has no riscv64 build path]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 setup.py | 1 -
 1 file changed, 1 deletion(-)

diff --git a/setup.py b/setup.py
index 4984659..b2cad4a 100644
--- a/setup.py
+++ b/setup.py
@@ -57,7 +57,6 @@ INSTALL_REQUIRES = [
     'networkx>=3.4.2',
     'astropy>=6.1.3',
     'pybind11>=3.1.0',
-    'vectorbt>=0.28.0',
 ]
 
 PACKAGES = [
-- 
2.43.0

