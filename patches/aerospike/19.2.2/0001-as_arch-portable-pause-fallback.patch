as_arch_pause() is only defined for __x86_64__/__aarch64__ (and _MSC_VER), but is
used unconditionally by the spinlock/rwlock inline functions in as_atomic_gcc.h,
which are always compiled. On any other architecture (e.g. riscv64) this is an
implicit-declaration compile error under -Werror. Add a portable no-op fallback,
matching the existing MSVC-vs-gcc/clang structure of the file.
--- a/aerospike-client-c/modules/common/src/include/aerospike/as_arch.h
+++ b/aerospike-client-c/modules/common/src/include/aerospike/as_arch.h
@@ -33,6 +33,10 @@

 #define as_arch_pause() asm volatile("isb" : : : "memory")

+#else
+
+#define as_arch_pause()
+
 #endif

 #endif // gcc & clang
