diff --git a/setup.cfg b/setup.cfg
index 8f448a1..aaa703a 100644
--- a/setup.cfg
+++ b/setup.cfg
@@ -3,7 +3,10 @@ name = pytomlpp
 version = 1.0.13
 author = Bob Fang
 author_email = bob.fang.london@gmail.com
-license_file = LICENSE
+license_files =
+    LICENSE
+    LICENSE.pybind11
+    LICENSE.tomlplusplus
 description = A python wrapper for toml++
 long_description = file: README.md
 long_description_content_type = text/markdown
-- 
