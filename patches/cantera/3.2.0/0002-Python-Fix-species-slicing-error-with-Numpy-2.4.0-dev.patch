From 0937f1d00bc913b64eba255e6408f51bd4f3e97e Mon Sep 17 00:00:00 2001
From: Ray Speth <speth@mit.edu>
Date: Mon, 1 Dec 2025 14:29:27 -0500
Subject: [PATCH] [Python] Fix species slicing error with Numpy 2.4.0 dev
 version


On Python 3.14, NumPy 2.4+ makes ndarray.resize(refcheck=True) require a
uniquely referenced array, and the call from Cython always holds a second
reference, so every species selection (gas["H2", "O2"], SolutionArray
slicing) raises "ValueError: cannot resize an array that may be referenced
by another object". Cantera 3.2.0 predates NumPy 2.4; the same failure
reproduces with upstream's own x86_64 cp314 wheel and numpy 2.5.3.
Merged upstream in https://github.com/Cantera/cantera/pull/2063.

Upstream-Status: Backport [https://github.com/Cantera/cantera/commit/0937f1d00bc913b64eba255e6408f51bd4f3e97e]
---
 interfaces/cython/cantera/solutionbase.pyx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/interfaces/cython/cantera/solutionbase.pyx b/interfaces/cython/cantera/solutionbase.pyx
index 54b60bc..2d57607 100644
--- a/interfaces/cython/cantera/solutionbase.pyx
+++ b/interfaces/cython/cantera/solutionbase.pyx
@@ -395,7 +395,7 @@ cdef class _SolutionBase:
         def __set__(self, species):
             if isinstance(species, (str, int)):
                 species = (species,)
-            self._selected_species.resize(len(species))
+            self._selected_species = np.ndarray(len(species), dtype=np.uint64)
             for i,spec in enumerate(species):
                 self._selected_species[i] = self.species_index(spec)
 
