From eaa233f4e012135829b4584d97b18a9bd534e4ee Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 5 Oct 2026 19:26:42 +0000
Subject: [PATCH] Pin vendored RapidJSON past v1.1.0's broken
 GenericStringRef::operator=

GenericStringRef declares a copy-assignment operator that assigns to
its own const length member, which GCC 14 rejects outright instead of
just warning (operator= is a template-class member never odr-used
elsewhere in treelite, so older GCC never instantiated, and so never
type-checked, its body). Fixed 3 commits after v1.1.0 by explicitly
deleting the operator; pin to that commit instead of the tag.

Upstream-Status: Backport [https://github.com/Tencent/rapidjson/commit/862c39be371278a45a88d4d1d75164be57bb7e2d]
---
 cmake/ExternalLibs.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmake/ExternalLibs.cmake b/cmake/ExternalLibs.cmake
index 996874f..4405f50 100644
--- a/cmake/ExternalLibs.cmake
+++ b/cmake/ExternalLibs.cmake
@@ -29,7 +29,7 @@ else()
   FetchContent_Declare(
     RapidJSON
     GIT_REPOSITORY      https://github.com/Tencent/rapidjson
-    GIT_TAG             v1.1.0
+    GIT_TAG             862c39be371278a45a88d4d1d75164be57bb7e2d
   )
   FetchContent_Populate(RapidJSON)
   message(STATUS "RapidJSON was downloaded at ${rapidjson_SOURCE_DIR}.")
-- 
2.43.0

