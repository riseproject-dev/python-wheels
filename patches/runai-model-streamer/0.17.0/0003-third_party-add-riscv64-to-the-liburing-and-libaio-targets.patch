From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 30 Oct 2026 12:40:00 +0000
Subject: [PATCH] third_party: add riscv64 to the liburing and libaio targets

0.17.0 links liburing (the io_uring engine) and libaio (its fallback)
statically from /opt/<arch>-uring and /opt/<arch>-aio. Both repositories'
BUILD files select the library by target CPU and list only x86_64 and
aarch64, so analysis of //streamer:libstreamer.so on riscv64 fails with
"configurable attribute "actual" in @@uring//:uring doesn't match this
configuration". uring_library()/aio_library() are generic over the arch
string; add the riscv64 config_setting, library and select branch.

Upstream-Status: To upstream [this port does not open issues/PRs against third-party repos; riscv64 support in these select()s is exactly the kind of change upstream would want once a downstream build proves it works]
---
 cpp/third_party/aio.BUILD   | 9 +++++++++
 cpp/third_party/uring.BUILD | 9 +++++++++
 2 files changed, 18 insertions(+)

diff --git a/cpp/third_party/aio.BUILD b/cpp/third_party/aio.BUILD
index 8f844b8..1823578 100644
--- a/cpp/third_party/aio.BUILD
+++ b/cpp/third_party/aio.BUILD
@@ -29,13 +29,22 @@ config_setting(
     ],
 )
 
+config_setting(
+    name = "target_riscv64",
+    constraint_values = [
+        "@platforms//cpu:riscv64",
+    ],
+)
+
 aio_library(name = "aio_aarch", arch = "aarch64")
 aio_library(name = "aio_x86_64", arch = "x86_64")
+aio_library(name = "aio_riscv64", arch = "riscv64")
 
 alias(
     name = "aio",
     actual = select({
         ":target_x86_64": ":aio_x86_64",
         ":target_aarch64": ":aio_aarch",
+        ":target_riscv64": ":aio_riscv64",
     }),
 )
diff --git a/cpp/third_party/uring.BUILD b/cpp/third_party/uring.BUILD
index f3c0056..2c74e89 100644
--- a/cpp/third_party/uring.BUILD
+++ b/cpp/third_party/uring.BUILD
@@ -29,13 +29,22 @@ config_setting(
     ],
 )
 
+config_setting(
+    name = "target_riscv64",
+    constraint_values = [
+        "@platforms//cpu:riscv64",
+    ],
+)
+
 uring_library(name = "uring_aarch", arch = "aarch64")
 uring_library(name = "uring_x86_64", arch = "x86_64")
+uring_library(name = "uring_riscv64", arch = "riscv64")
 
 alias(
     name = "uring",
     actual = select({
         ":target_x86_64": ":uring_x86_64",
         ":target_aarch64": ":uring_aarch",
+        ":target_riscv64": ":uring_riscv64",
     }),
 )
