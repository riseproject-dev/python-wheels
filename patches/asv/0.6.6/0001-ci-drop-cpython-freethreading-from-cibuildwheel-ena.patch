From 86b250629de1e6ceeeb4713b84d7b0cd9fbf315e Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sat, 12 Sep 2026 12:51:38 +0200
Subject: [PATCH] ci: drop cpython-freethreading from cibuildwheel enable
 groups

cibuildwheel 4.2.0 (pinned repo-wide in python-wheels) removed the
cpython-freethreading enable group - free-threaded builds are selected
by the build identifier itself now, not an opt-in group - and its
config parser rejects the value outright:

  Failed to parse enable group. Unknown enable group:
  cpython-freethreading. Valid group names are: cpython-prerelease,
  graalpy, pypy, pypy-eol, pyodide-eol, pyodide-prerelease

Upstream's own build_wheels.yml pins cibuildwheel v3.3.0, where this
group is still valid, so this never breaks upstream's own CI.

Upstream-Status: Inappropriate [needed only for cibuildwheel 4.x, which python-wheels pins repo-wide; upstream pins 3.3.0]
---
 pyproject.toml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index d89fac9..1936f5f 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -145,7 +145,6 @@ quote-style = "preserve"
 write_to = "asv/_version.py"
 
 [tool.cibuildwheel]
-enable = ["cpython-freethreading"]
 skip = ["cp313t-*"]
 
 [tool.cibuildwheel.linux]
-- 
2.50.1 (Apple Git-155)

