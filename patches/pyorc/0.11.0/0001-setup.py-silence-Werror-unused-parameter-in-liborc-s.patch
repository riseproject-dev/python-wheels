From c332c54a506abef333f41f687088a1e95e4f5f75 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 8 Sep 2026 08:31:16 +0200
Subject: [PATCH] setup.py: silence -Werror=unused-parameter in liborc's
 CpuInfoUtil.cc fallback stubs

Upstream-Status: To upstream [not filed: this session does not open issues/PRs against third-party repos]

liborc's CpuInfoUtil.cc gates its CPU-detection code on x86/ARM/PPC; any other
architecture (riscv64 included) falls into the '#else' stub branch, whose
no-op ArchParseUserSimdLevel/ArchVerifyCpuRequirements bodies leave
simdLevel/hardwareFlags/ci unused. liborc's CMakeLists.txt defaults
STOP_BUILD_ON_WARNING to ON, turning GCC's -Wunused-parameter into a hard
build error on any architecture that hits this branch; upstream's own CI
only ever builds x86/ARM/PPC, so it never trips this. Add explicit (void)
casts to the extracted source right after download, mirroring the existing
_patch_protobuf_version fixup.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 setup.py | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/setup.py b/setup.py
index 9b8f260..9fb61ee 100644
--- a/setup.py
+++ b/setup.py
@@ -112,6 +112,30 @@ class BuildExt(build_ext):
         tar_src.extractall(self.output_dir)
         tar_src.close()
 
+    def _fix_cpuinfo_util_unused_params(self) -> None:
+        file_path = (
+            self.output_dir / f"orc-{self.orc_version}" / "c++" / "src" / "CpuInfoUtil.cc"
+        )
+        text = file_path.read_text(encoding="utf-8")
+        text = text.replace(
+            "bool ArchParseUserSimdLevel(const std::string& simdLevel, int64_t* hardwareFlags) {\n"
+            "      return true;\n"
+            "    }",
+            "bool ArchParseUserSimdLevel(const std::string& simdLevel, int64_t* hardwareFlags) {\n"
+            "      (void)simdLevel;\n"
+            "      (void)hardwareFlags;\n"
+            "      return true;\n"
+            "    }",
+            1,
+        )
+        text = text.replace(
+            "void ArchVerifyCpuRequirements(const CpuInfo* ci) {}",
+            "void ArchVerifyCpuRequirements(const CpuInfo* ci) { (void)ci; }",
+            1,
+        )
+        file_path.write_text(text, encoding="utf-8")
+        logging.info("Silenced unused-parameter warnings in CpuInfoUtil.cc's non-x86/ARM/PPC stubs")
+
     def _patch_protobuf_version(self, version) -> None:
         file_path = (
             self.output_dir
@@ -231,6 +255,7 @@ class BuildExt(build_ext):
             )
             if not os.path.isdir(self.output_dir / f"orc-{self.orc_version}"):
                 self._download_source()
+                self._fix_cpuinfo_util_unused_params()
 
             if self.download_only:
                 logging.info("Only downloaded the ORC library source. Skip build_ext")
