From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 16:37:03 +0000
Subject: [PATCH] cmake: find libclang.so under /usr/lib64 too

The LLVM/libclang path detection in Pybind11Mkdoc.cmake only checks
/usr/lib/libclang.so and the Debian-style /usr/lib/llvm-N/lib/libclang.so.
RHEL/Fedora-family distros (RHEL, Rocky, AlmaLinux) install clang-devel's
libclang.so under /usr/lib64 instead, so neither branch matches and the
docstring-generation step falls back to whatever the `clang` Python
package's own search finds (often nothing), failing the build. Same fix
for the clang resource-dir include path used alongside it.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against SleipnirGroup/Sleipnir]
---
 cmake/Pybind11Mkdoc.cmake | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/cmake/Pybind11Mkdoc.cmake b/cmake/Pybind11Mkdoc.cmake
index 5b3ce4a..fc97b9f 100644
--- a/cmake/Pybind11Mkdoc.cmake
+++ b/cmake/Pybind11Mkdoc.cmake
@@ -25,12 +25,21 @@ function(pybind11_mkdoc target headers)
                 LLVM_DIR_PATH=/usr/lib/llvm-${clang_version}
                 LIBCLANG_PATH=/usr/lib/llvm-${clang_version}/lib/libclang.so
             )
+        elseif(EXISTS /usr/lib64/libclang.so)
+            set(env_vars
+                LLVM_DIR_PATH=/usr/lib64
+                LIBCLANG_PATH=/usr/lib64/libclang.so
+            )
         endif()
     endif()
 
     # Clang compiler flags
     if(UNIX AND NOT APPLE)
-        set(clang_flags -I/usr/lib/clang/${clang_version}/include)
+        if(EXISTS /usr/lib64/clang/${clang_version}/include)
+            set(clang_flags -I/usr/lib64/clang/${clang_version}/include)
+        else()
+            set(clang_flags -I/usr/lib/clang/${clang_version}/include)
+        endif()
     endif()
 
     # Eigen compiler flags
