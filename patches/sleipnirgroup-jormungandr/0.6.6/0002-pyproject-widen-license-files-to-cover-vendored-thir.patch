From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 16:37:11 +0000
Subject: [PATCH] pyproject: widen license-files to cover vendored third-party
 licences

project.license-files is the explicit list ["LICENSE.txt"], so it does
not fall back to a LICEN[CS]E* auto-discovery glob: the wheel statically
links Eigen (MPL2/BSD), small_vector (MIT) and nanobind (BSD-3-Clause),
whose licences a LICENSE.<dep> file dropped at the project root should
cover but currently has no way to reach the wheel's dist-info/licenses/.
Widening the list to also match LICENSE.* picks those up with no other
packaging change. Upstream's own published wheels carry the same gap.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against SleipnirGroup/Sleipnir]
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 186bfa5..4d86ab2 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -6,7 +6,7 @@ requires-python = ">=3.12"
 dependencies = ["matplotlib", "numpy", "scipy"]
 dynamic = ["version"]
 license = "BSD-3-Clause"
-license-files = ["LICENSE.txt"]
+license-files = ["LICENSE.txt", "LICENSE.*"]
 
   [project.urls]
   Documentation = "https://sleipnirgroup.github.io/Sleipnir/"
