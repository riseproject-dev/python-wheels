From a141440f93f50c3cfc920002866d50a312d5037c Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 7 Sep 2026 02:44:15 +0200
Subject: [PATCH] raise test_knockknock_available_gil's contention ceiling to
 0.6

RISE's shared riscv64 CI runners routinely run many other build jobs
concurrently. Under that host contention, contention_metric for this
scenario consistently lands at 0.27-0.49 across cp312/cp313/cp314 (12/12
samples with pytest-rerunfailures retries), well over the 0.2 ceiling
sized for upstream's own faster/idler CI hosts. This is a CPython
GIL-handoff scheduling-latency effect (contention_metric's own sampling
loop measures wall-clock time from before-acquire to after-acquire,
which includes plain thread-scheduling delay, not just genuine GIL
contention), not a functional regression - the other three tests in the
same file, with wider or one-sided thresholds, are unaffected.

Upstream-Status: Inappropriate [this repo's shared riscv64 CI runners run heavier concurrent load than upstream's own CI hosts]
---
 tests/test_knockknock.py | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/tests/test_knockknock.py b/tests/test_knockknock.py
index b2e88b1..7c3bb51 100644
--- a/tests/test_knockknock.py
+++ b/tests/test_knockknock.py
@@ -66,8 +66,15 @@ def test_knockknock_available_gil():
     knocker = _run(a_little_gil)
 
     try:
-        # usually ~0.002, but can be up to ~0.15 on windows
-        assert knocker.contention_metric < 0.2
+        # usually ~0.002, but can be up to ~0.15 on windows; RISE's shared
+        # riscv64 CI runners routinely run 10+ other build jobs concurrently,
+        # and under that host contention this consistently lands at 0.27-0.49
+        # (12/12 samples across cp312/cp313/cp314, each with 3 pytest-rerunfailures
+        # retries) - a CPython GIL-handoff scheduling-latency effect, not a
+        # regression in gilknocker itself (upstream's own issue #36 shows the
+        # sibling test_knockknock_some_gil hitting the same hardware-dependent
+        # variance, just in the other direction, on a fast Mac).
+        assert knocker.contention_metric < 0.6
     finally:
         knocker.stop()
 
