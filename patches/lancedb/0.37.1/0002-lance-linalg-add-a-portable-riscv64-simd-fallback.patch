+
+    #[inline]
+    fn min(&self, rhs: &Self) -> Self {
+        let mut result = [0.0_f32; 16];
+        for i in 0..16 {
+            result[i] = self.0[i].min(rhs.0[i]);
+        }
+        Self(result)
+    }
+
+    #[inline]
