From c4a76c425b6d2c7353017e91b772d4cba7003e6c Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 03:53:34 +0000
Subject: [PATCH] pybammsolvers: ship SUNDIALS and SuiteSparse licence files in
 the wheel

idaklu links at runtime (via the RPATH entries CMakeLists.txt sets) against
SUNDIALS (BSD-3-Clause) and SuiteSparse's BTF/KLU (LGPL-2.1-or-later) and
AMD/COLAMD/SuiteSparse_config (BSD-3-Clause), both built from the git
submodules below at build time and vendored into the wheel by the repair
step, but license-files only lists the project's own LICENSE. Add the
submodules' licence files so dist-info/licenses carries them too.

Upstream-Status: To upstream [no write access to pybamm-team/PyBaMM from this session]
---
 packages/pybammsolvers/pyproject.toml | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/packages/pybammsolvers/pyproject.toml b/packages/pybammsolvers/pyproject.toml
index 4faae28..2ad8b8d 100644
--- a/packages/pybammsolvers/pyproject.toml
+++ b/packages/pybammsolvers/pyproject.toml
@@ -15,7 +15,15 @@ build-backend = "scikit_build_core.build"
 name = "pybammsolvers"
 description = "Python interface for the IDAKLU solver"
 requires-python = ">=3.10,<3.15"
-license-files = ["LICENSE"]
+license-files = [
+    "LICENSE",
+    # SUNDIALS and SuiteSparse (BTF, KLU: LGPL-2.1-or-later; AMD, COLAMD,
+    # SuiteSparse_config: BSD-3-Clause) are built from the git submodules below and
+    # linked into the compiled idaklu extension, but neither licence ships in the
+    # wheel today.
+    "sundials/LICENSE",
+    "SuiteSparse/LICENSE.txt",
+]
 readme = "README.md"
 # version.py stays the source of truth; a pre-commit hook mirrors it here.
 version = "0.11.0"
-- 
