From aed7c90d3380db6f84a59fee157c719b3927f201 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 21 Sep 2026 18:09:26 +0000
Subject: [PATCH] ci: drop cpython-freethreading from cibuildwheel enable
 groups

cibuildwheel 4.2.0 (pinned repo-wide in python-wheels) removed the
cpython-freethreading enable group - free-threaded builds are selected
by the build identifier itself now, not an opt-in group - and its config
parser rejects the value outright, before any container starts and for
every interpreter in the matrix:

  Failed to parse enable group. Unknown enable group:
  cpython-freethreading. Valid group names are: cpython-prerelease,
  graalpy, pypy, pypy-eol, pyodide-eol, pyodide-prerelease

Upstream's own pypi.yml pins cibuildwheel==v3.4.1, where the group is
still valid, so this never breaks upstream's own CI.

Upstream-Status: Inappropriate [needed only for cibuildwheel 4.x, which python-wheels pins repo-wide; upstream pins 3.4.1]
---
 python/pyproject.toml | 2 --
 1 file changed, 2 deletions(-)

diff --git a/python/pyproject.toml b/python/pyproject.toml
index 8d9d393..b0ee70d 100644
--- a/python/pyproject.toml
+++ b/python/pyproject.toml
@@ -35,8 +35,6 @@ cu13 = [
 archs = "auto64"
 build-verbosity = 1
 skip = ""
-# Enable free-threaded support
-enable = ["cpython-freethreading"]
 
 manylinux-x86_64-image = "quay.io/pypa/manylinux_2_28_x86_64"
 manylinux-aarch64-image = "quay.io/pypa/manylinux_2_28_aarch64"
