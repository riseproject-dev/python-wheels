@@ -362,6 +476,18 @@ impl SIMD<f32, 8> for f32x8 {
                 }
             }
         }
+        #[cfg(not(any(
+            target_arch = "x86_64",
+            target_arch = "aarch64",
+            target_arch = "loongarch64"
+        )))]
