 pub struct f32x8(v8f32);
 
+/// 8 of 32-bit `f32` values. Portable scalar fallback for architectures with
+/// no dedicated SIMD tier above (riscv64 included) -- CLAUDE.md gotcha 300.
+#[allow(non_camel_case_types)]
+#[cfg(not(any(
+    target_arch = "x86_64",
+    target_arch = "aarch64",
+    target_arch = "loongarch64"
+)))]
+#[derive(Clone, Copy)]
+pub struct f32x8([f32; 8]);
+
