From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 06 Oct 2026 00:00:00 +0000
Subject: [PATCH] cargo: redirect lance-core/lance-linalg to riscv64-patched
 checkouts

lance-core's SIMD_SUPPORT static (src/utils/cpu.rs) and lance-linalg's
f32x8/f32x16/i32x8/f64x4/f64x8 SIMD types (src/simd/{f32,i32,f64}.rs)
are compiled for x86_64/aarch64/loongarch64 only, with no fallback arm
for any other architecture (CLAUDE.md gotcha 300).

Cargo.lock holds two semver-incompatible lines of both crates once
lance-graph is gone: 7.0.0 (pulled in by lancedb 0.30.0) and 9.0.0
(`lance = "9.0.0"` in crates/lance-context-core). `[patch.crates-io]`
redirects one version per crate name, so the 9.0.0 pair uses the plain
name and the 7.0.0 pair an aliased entry (`package = "lance-core"`).
Both are redirected to the riscv64-patched copies the workflow
materializes at build time from the pinned crates.io releases (see
0002/0004, applied to both lines); only the `source`/
`checksum` lines of those four Cargo.lock entries change.

Upstream-Status: Inappropriate [redirects a pinned dependency to a local checkout materialized at build time; the fix itself belongs in lance-format/lance]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
diff --git a/Cargo.lock b/Cargo.lock
index ac263f7..d87b7b3 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -6491,8 +6491,6 @@ dependencies = [
 [[package]]
 name = "lance-core"
 version = "7.0.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "13f84020da5a484e2f07dd1796e09785ed7cd889857ebc4cb77e32ef214ee594"
 dependencies = [
  "arrow-array 58.3.0",
  "arrow-buffer 58.3.0",
@@ -6528,8 +6526,6 @@ dependencies = [
 [[package]]
 name = "lance-core"
 version = "9.0.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "238c8a58308e7718d6bd96b53494eb7953fa299778bc4911cc571c3576e9446d"
 dependencies = [
  "arrow-array 58.3.0",
  "arrow-buffer 58.3.0",
@@ -7387,8 +7383,6 @@ dependencies = [
 [[package]]
 name = "lance-linalg"
 version = "7.0.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "6b4c51cad0ac780b02dc4da48528479e7693c03e8d05390510bbc69ca2a9a1f1"
 dependencies = [
  "arrow-array 58.3.0",
  "arrow-buffer 58.3.0",
@@ -7405,8 +7399,6 @@ dependencies = [
 [[package]]
 name = "lance-linalg"
 version = "9.0.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "0e5a9b99bd1f49bc2fe5afb81323141abc506c818f589de95dbab4f6143d9a88"
 dependencies = [
  "arrow-array 58.3.0",
  "arrow-buffer 58.3.0",
diff --git a/Cargo.toml b/Cargo.toml
index 2efab19..07f2f68 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -17,3 +17,16 @@ license = "Apache-2.0"
 
 [workspace.metadata]
 # reserved for future use
+
+# lance-core's SIMD_SUPPORT static and lance-linalg's f32x8/f32x16/i32x8/
+# f64x4/f64x8 SIMD types compile only for x86_64/aarch64/loongarch64
+# upstream (CLAUDE.md gotcha 300); the riscv64-patched copies below are
+# materialized from the pinned crates.io releases by the workflow at
+# build time. Cargo.lock pins two semver-incompatible lines of each crate
+# (7.0.0 via lancedb, 9.0.0 via lance-context-core), and [patch] can only
+# redirect one per name, so the second is patched through an aliased entry.
+[patch.crates-io]
+lance-core = { path = "lance-core-9.0.0-riscv64" }
+lance-linalg = { path = "lance-linalg-9.0.0-riscv64" }
+lance-core-7 = { path = "lance-core-7.0.0-riscv64", package = "lance-core" }
+lance-linalg-7 = { path = "lance-linalg-7.0.0-riscv64", package = "lance-linalg" }
-- 
2.43.0
