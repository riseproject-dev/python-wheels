From 396b66d276364e68a71e955a8ef5adf9ae8c8c2c Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 21 Sep 2026 18:45:37 +0000
Subject: [PATCH] Comment out the removed cibuildwheel free-threaded-support
 option

cibuildwheel dropped `free-threaded-support` in 3.0: the option is now
rejected outright ("Option 'free-threaded-support' not supported in a
config file"), so any build of this tag with a current cibuildwheel fails
before it starts.

Upstream's own release workflow still pins cibuildwheel v2.21.3, where
the option is valid, so the tag is not broken for them yet. explosion
made this exact change in thinc (6f3a08b1, "Hack at free-threaded
option").

Upstream-Status: To upstream [not yet submitted; explosion made the same change in thinc 6f3a08b1]
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index af90adf..677fb77 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -10,7 +10,7 @@ build-backend = "setuptools.build_meta"
 build = "*"
 skip = "pp* cp36* cp37* cp38*"
 test-skip = ""
-free-threaded-support = false
+#free-threaded-support = false
 
 archs = ["native"]
 
