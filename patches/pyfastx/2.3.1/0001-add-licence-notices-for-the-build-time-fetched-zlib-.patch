From 1a0118c26d64a27ed8cc00e1050bb55e9e8bc2b7 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 8 Sep 2026 04:15:40 +0200
Subject: [PATCH] add licence notices for the build-time-fetched
 zlib/sqlite3/indexed_gzip sources

Upstream-Status: To upstream [not filed: this session does not open issues/PRs against third-party repos]

setup.py downloads and compiles zlib, the SQLite amalgamation, and
indexed_gzip's zran sources at build time; none of their licence texts
end up in the wheel, only pyfastx's own LICENSE (MIT). zlib and
indexed_gzip each ship a LICENSE file in the archive setup.py already
extracts; copy it to the project root as LICENSE.<dep> so setuptools'
default LICEN[CS]E* glob picks it up. The SQLite amalgamation release
zip carries no separate licence file, only the public-domain notice
repeated in every source file's header comment; write that text
verbatim to LICENSE.sqlite3.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 setup.py | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/setup.py b/setup.py
index 6e66066..72bc197 100644
--- a/setup.py
+++ b/setup.py
@@ -1,6 +1,7 @@
 import os
 import sys
 import glob
+import shutil
 import tarfile
 import zipfile
 import urllib.request
@@ -9,6 +10,17 @@ from setuptools.command import build_ext
 
 root_dir = os.path.dirname(os.path.abspath(__file__))
 
+# sqlite3.c carries this notice (verbatim) ahead of every internal source
+# file it amalgamates; the release zip ships no standalone LICENSE.
+SQLITE3_LICENSE = """\
+The author disclaims copyright to this source code.  In place of
+a legal notice, here is a blessing:
+
+   May you do good and not evil.
+   May you find forgiveness for yourself and forgive others.
+   May you share freely, never taking more than you give.
+"""
+
 sources = glob.glob(os.path.join(root_dir, 'src', '*.c'))
 link_args = []
 comp_args = []
@@ -29,6 +41,8 @@ def prepare_zlib():
         with zipfile.ZipFile(zlib_file) as _zip:
             _zip.extractall()
 
+    shutil.copy(os.path.join(zlib_dir, 'LICENSE'), os.path.join(root_dir, 'LICENSE.zlib'))
+
     include_dirs.append(zlib_dir)
     sources.extend(glob.glob(os.path.join(zlib_dir, '*.c')))
 
@@ -47,6 +61,9 @@ def prepare_sqlite3():
         with zipfile.ZipFile(sqlite_file) as _zip:
             _zip.extractall()
 
+    with open(os.path.join(root_dir, 'LICENSE.sqlite3'), 'w') as fh:
+        fh.write(SQLITE3_LICENSE)
+
     include_dirs.append(sqlite_dir)
     sources.append(os.path.join(sqlite_dir, 'sqlite3.c'))
 
@@ -65,6 +82,9 @@ def prepare_indexed_gzip():
         with zipfile.ZipFile(igzip_file) as _zip:
             _zip.extractall()
 
+    shutil.copy(os.path.join(root_dir, 'indexed_gzip-1.10.3', 'LICENSE'),
+                os.path.join(root_dir, 'LICENSE.indexed_gzip'))
+
     include_dirs.append(igzip_dir)
     sources.extend(glob.glob(os.path.join(igzip_dir, 'zran*.c')))
 
