From 270a4b17ce7d34f9174ecd16e8c9e59eb8a1924a Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 28 Sep 2026 00:00:00 +0000
Subject: [PATCH] wheel: declare Cargo license-file so maturin ships LICENSE in
 the wheel

wheel/pyproject.toml has no [project] table (metadata is fully dynamic
from Cargo.toml), so maturin's PEP 621 license-files auto-discovery
(the LICEN[CS]E* glob beside pyproject.toml) never runs for this
package -- that auto-discovery only fires when a [project] table is
present. With no [project] table, maturin's Metadata24::from_cargo_toml
only populates license_files from Cargo.toml's package.license-file
key; package.license (the SPDX string already set here) is a separate
field that does not feed license_files. Confirmed on the real published
PyPI wheel (clvm_rs-0.19.0-cp310-abi3-manylinux_2_28_x86_64.whl): it
also ships zero dist-info/licenses/ files, so upstream's own packaging
has the same gap.

Setting license-file (resolved relative to this Cargo.toml, i.e.
wheel/) makes maturin embed the LICENSE our build already copies to
wheel/LICENSE as dist-info/licenses/LICENSE. Verified locally: without
this change the built wheel has no dist-info/licenses/ entry at all;
with it, dist-info/licenses/LICENSE is present.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against Chia-Network/clvm_rs]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 wheel/Cargo.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/wheel/Cargo.toml b/wheel/Cargo.toml
index 717d404..f31320f 100644
--- a/wheel/Cargo.toml
+++ b/wheel/Cargo.toml
@@ -4,6 +4,7 @@ version = "0.19.0"
 authors = ["Richard Kiss <him@richardkiss.com>"]
 edition = "2024"
 license = "Apache-2.0"
+license-file = "LICENSE"
 description = "Implementation of `clvm` for Chia Network's cryptocurrency"
 homepage = "https://github.com/Chia-Network/clvm_rs/"
 repository = "https://github.com/Chia-Network/clvm_rs/"
-- 
2.43.0

