From 7ee627a1f393d5c9ae83bdd3def1ee1c54089961 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 11 Sep 2026 23:02:16 +0200
Subject: [PATCH] _png: drop the png_set_cICP call, unavailable before libpng
 1.6.45

png_set_cICP() was added to libpng in 1.6.45 (Jan 2025); Rocky 10
riscv64's system libpng-devel is 1.6.40, which does not declare or
export the symbol at all, so the Cython-generated call fails to
compile (implicit-function-declaration under GCC 14) and would fail
to link even with that warning silenced.

Drop the call so png_encode compiles against libpng 1.6.40; passing
primaries/transfer/matrix to png_encode becomes a silent no-op
instead of writing a cICP chunk, since that colour-primaries metadata
is not the primary use case this port targets.

Upstream-Status: Inappropriate [riscv64/pypi.riseproject.dev-specific: works around an older system libpng on the manylinux_riscv64 image, not an imagecodecs bug]
---
 imagecodecs/_png.pyx | 10 ----------
 1 file changed, 10 deletions(-)

diff --git a/imagecodecs/_png.pyx b/imagecodecs/_png.pyx
index 10eb338..0082e21 100644
--- a/imagecodecs/_png.pyx
+++ b/imagecodecs/_png.pyx
@@ -307,16 +307,6 @@ def png_encode(
                 PNG_FILTER_TYPE_DEFAULT
             )
 
-            if primaries_ >= 0 or transfer_ >= 0 or matrix_ >= 0:
-                png_set_cICP(
-                    png_ptr,
-                    info_ptr,
-                    <png_byte> (primaries_ if primaries_ >= 0 else 2),
-                    <png_byte> (transfer_ if transfer_ >= 0 else 2),
-                    <png_byte> (matrix_ if matrix_ >= 0 else 2),
-                    1
-                )
-
             png_write_info(png_ptr, info_ptr)
             png_set_compression_level(png_ptr, level_)
             png_set_compression_strategy(png_ptr, strategy_)
-- 
