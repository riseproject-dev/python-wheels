From a0511e4f5f39637ffa56940f08ac3b14899c5411 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] riscv64: build with gcc instead of clang

Upstream-Status: Inappropriate [quay.io/pypa manylinux/musllinux riscv64 images ship no static clang toolchain]

manylinux-install-clang's static_clang_versions.txt has no RISCV64 entry,
so the riscv64 leg of this case statement always fails with "No
static-clang toolchain for RISCV64" before OpenBLAS is even built -
confirmed identically on both quay.io/pypa/manylinux_2_39_riscv64 and
quay.io/pypa/musllinux_1_2_riscv64.

ppc64le/s390x/loongarch64 keep clang (per a31c33a, "use clang only on
qemu platforms" - upstream's own CI builds all of these, riscv64
included, by emulating them with QEMU on an arm64 runner). riscv64 here
runs on real native riscv64 hardware, so the gcc toolchain already
present in both images - the same one every other riscv64 package in
this repo already builds OpenBLAS-dependent Fortran/C code with - is
used instead, matching how x86_64/aarch64 (which upstream also builds
natively) already build this same package.
---
 ci-before-build.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ci-before-build.sh b/ci-before-build.sh
index f9d7e98..7567d24 100755
--- a/ci-before-build.sh
+++ b/ci-before-build.sh
@@ -30,7 +30,7 @@ export OPENBLAS_VERSION=$version
 echo "creating wheel from $OPENBLAS_COMMIT (NIGHTLY is $NIGHTLY)"
 
 case "$PLAT" in
-    loongarch64|ppc64le|s390x|riscv64)
+    loongarch64|ppc64le|s390x)
         manylinux-install-clang -v 21.1.6.0
         export PATH=/opt/clang/bin:$PATH
         export CC="/opt/clang/bin/clang"
