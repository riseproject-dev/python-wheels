From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 9 Nov 2026 00:00:00 +0000
Subject: [PATCH] interactive_message: defer the typing.Self import to
 TYPE_CHECKING

`pyproject.toml` declares `requires-python = ">=3.10"`, but four modules
under `neonize/ext/interactive_message/` (`ai_rich.py`, `button.py`,
`buttonv2.py`, `carousel.py`) import `Self` straight from `typing`, which
only gained it in 3.11 (PEP 673). `client.py` imports all four through
`ext/interactive_message/__init__.py`, so importing `neonize` at all
fails on Python 3.10:

    ImportError: cannot import name 'Self' from 'typing'

Each of these modules uses `Self` only in `-> Self` return annotations
and already starts with `from __future__ import annotations`, so none
of those annotations are evaluated at runtime; `button.py`, `buttonv2.py`
and `carousel.py` already guard other type-only imports behind
`if TYPE_CHECKING:`. Moving `Self` into that same guard (adding one to
`ai_rich.py`, which otherwise imports it unconditionally despite also
importing `TYPE_CHECKING`) drops the eager 3.11+-only import without
changing anything a type checker sees.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against krypton-byte/neonize]
---
 neonize/ext/interactive_message/ai_rich.py  | 4 +++-
 neonize/ext/interactive_message/button.py   | 4 +++-
 neonize/ext/interactive_message/buttonv2.py | 4 +++-
 neonize/ext/interactive_message/carousel.py | 4 +++-
 4 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/neonize/ext/interactive_message/ai_rich.py b/neonize/ext/interactive_message/ai_rich.py
index af29ce3..383e9e4 100644
--- a/neonize/ext/interactive_message/ai_rich.py
+++ b/neonize/ext/interactive_message/ai_rich.py
@@ -14,9 +14,11 @@ from dataclasses import dataclass, field
 from typing import (
     TYPE_CHECKING,
     Any,
-    Self,
 )
 
+if TYPE_CHECKING:
+    from typing import Self
+
 from ...proto.waAICommon.WAWebProtobufsAICommon_pb2 import (
     AIRichResponseUnifiedResponse,
     BotMetadata,
diff --git a/neonize/ext/interactive_message/button.py b/neonize/ext/interactive_message/button.py
index 957d5e5..2d29ea3 100644
--- a/neonize/ext/interactive_message/button.py
+++ b/neonize/ext/interactive_message/button.py
@@ -33,7 +33,7 @@ from __future__ import annotations
 
 import json
 from dataclasses import dataclass, field
-from typing import TYPE_CHECKING, Any, Self, Union
+from typing import TYPE_CHECKING, Any, Union
 
 from ...proto.waE2E.WAWebProtobufsE2E_pb2 import (
     ContextInfo,
@@ -47,6 +47,8 @@ from ...utils.iofile import get_bytes_from_name_or_url
 from .base import CustomInteractiveMessage, InteractiveMessageBuilder
 
 if TYPE_CHECKING:
+    from typing import Self
+
     from ...aioze.client import NewAClient
     from ...client import NewClient
 
diff --git a/neonize/ext/interactive_message/buttonv2.py b/neonize/ext/interactive_message/buttonv2.py
index feb82fe..daffe86 100644
--- a/neonize/ext/interactive_message/buttonv2.py
+++ b/neonize/ext/interactive_message/buttonv2.py
@@ -26,7 +26,7 @@ from __future__ import annotations
 import uuid as _uuid
 from dataclasses import dataclass
 from io import BytesIO
-from typing import TYPE_CHECKING, Self
+from typing import TYPE_CHECKING
 
 from ...proto.waE2E.WAWebProtobufsE2E_pb2 import (
     ButtonsMessage,
@@ -38,6 +38,8 @@ from ...utils.iofile import get_bytes_from_name_or_url
 from .base import CustomInteractiveMessage, InteractiveMessageBuilder
 
 if TYPE_CHECKING:
+    from typing import Self
+
     from ...aioze.client import NewAClient
     from ...client import NewClient
 
diff --git a/neonize/ext/interactive_message/carousel.py b/neonize/ext/interactive_message/carousel.py
index ccf9ef5..730fd78 100644
--- a/neonize/ext/interactive_message/carousel.py
+++ b/neonize/ext/interactive_message/carousel.py
@@ -38,7 +38,7 @@ Example::
 from __future__ import annotations
 
 from collections.abc import Sequence
-from typing import TYPE_CHECKING, Self
+from typing import TYPE_CHECKING
 
 from ...proto.waE2E.WAWebProtobufsE2E_pb2 import (
     ContextInfo,
@@ -48,6 +48,8 @@ from ...proto.waE2E.WAWebProtobufsE2E_pb2 import (
 from .base import CustomInteractiveMessage, InteractiveMessageBuilder
 
 if TYPE_CHECKING:
+    from typing import Self
+
     from ...aioze.client import NewAClient
     from ...client import NewClient
 
