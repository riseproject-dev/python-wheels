From bfb332e563738e0959f97c7facaa473150f5587e Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 26 Aug 2026 21:23:49 +0200
Subject: [PATCH] python-package: ship the vendored libraries' licences in the
 wheel

Upstream-Status: To upstream [not yet filed with upstream; the exact set of files to list is a maintainer call, since build-python.sh already curates which external_libs are redistributed]

build-python.sh copies fast_double_parser, fmt and nanoarrow into the
source distribution and CMake compiles all three into lib_lightgbm
(nanoarrow's array.c, array_stream.c, schema.c and utils.c are real
translation units; fmt and fast_double_parser are header-only but end up
in the binary just the same). Their licences -- Apache-2.0 with a NOTICE
for nanoarrow, Apache-2.0/BSL for fast_double_parser, MIT for fmt -- all
require the notice to travel with binary redistributions, but
'license-files = ["LICENSE"]' means the built wheel carries only
LightGBM's own MIT licence.

The files are already in the sdist, so listing them is enough: the wheel
then holds them under dist-info/licenses/external_libs/ next to LICENSE.
---
 python-package/pyproject.toml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/python-package/pyproject.toml b/python-package/pyproject.toml
index 2f2824e..003039d 100644
--- a/python-package/pyproject.toml
+++ b/python-package/pyproject.toml
@@ -24,7 +24,12 @@ dependencies = [
 description = "LightGBM Python-package"
 license = "MIT"
 license-files = [
-    "LICENSE"
+    "LICENSE",
+    "external_libs/fast_double_parser/LICENSE",
+    "external_libs/fast_double_parser/LICENSE.BSL",
+    "external_libs/fmt/LICENSE",
+    "external_libs/nanoarrow/LICENSE.txt",
+    "external_libs/nanoarrow/NOTICE.txt"
 ]
 maintainers = [
   {name = "Yu Shi", email = "yushi@microsoft.com"}
-- 
