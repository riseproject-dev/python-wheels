From 1192b9cd63445e9c8fb6695b521de60c9c7d6073 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 27 Aug 2026 15:47:22 +0200
Subject: [PATCH] python-package: ship the vendored libraries' licences in the
 wheel

Upstream-Status: To upstream [not yet filed with upstream; the exact set of files to list is a maintainer call, since build-python.sh already curates which external_libs are redistributed]

build-python.sh copies Eigen, fast_double_parser, fmt and nanoarrow into
the source distribution and CMake compiles all four into lib_lightgbm
(nanoarrow's array.c, array_stream.c, schema.c and utils.c are real
translation units; Eigen, fmt and fast_double_parser are header-only but
end up in the binary just the same -- linear_tree_learner.cpp includes
Eigen/Dense unconditionally). Their licences -- MPL-2.0 for Eigen,
Apache-2.0 with a NOTICE for nanoarrow, Apache-2.0/BSL for
fast_double_parser, MIT for fmt -- all require the notice to travel with
binary redistributions, but 'license-files = ["LICENSE"]' means the built
wheel carries only LightGBM's own MIT licence.

fast_double_parser, fmt and nanoarrow already have their licences copied
into the source distribution, so listing them is enough. Eigen does not,
so copy COPYING.MPL2 and COPYING.README alongside the headers. Only those
two: EIGEN_MPL2_ONLY keeps the non-MPL2 parts of Eigen out of the build,
and shipping COPYING.GPL or COPYING.LGPL would claim a licence that does
not apply to anything in the wheel.
---
 build-python.sh               | 5 +++++
 python-package/pyproject.toml | 9 ++++++++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/build-python.sh b/build-python.sh
index b859e45..03eae09 100755
--- a/build-python.sh
+++ b/build-python.sh
@@ -262,6 +262,11 @@ create_isolated_source_dir() {
         external_libs/eigen/CMakeLists.txt \
         ./lightgbm-python/external_libs/eigen/CMakeLists.txt
 
+    cp \
+        external_libs/eigen/COPYING.MPL2 \
+        external_libs/eigen/COPYING.README \
+        ./lightgbm-python/external_libs/eigen/
+
     modules="Cholesky Core Dense Eigenvalues Geometry Householder Jacobi LU QR SVD"
     for eigen_module in ${modules}; do
         cp \
diff --git a/python-package/pyproject.toml b/python-package/pyproject.toml
index 2f2824e..891a233 100644
--- a/python-package/pyproject.toml
+++ b/python-package/pyproject.toml
@@ -24,7 +24,14 @@ dependencies = [
 description = "LightGBM Python-package"
 license = "MIT"
 license-files = [
-    "LICENSE"
+    "LICENSE",
+    "external_libs/eigen/COPYING.MPL2",
+    "external_libs/eigen/COPYING.README",
+    "external_libs/fast_double_parser/LICENSE",
+    "external_libs/fast_double_parser/LICENSE.BSL",
+    "external_libs/fmt/LICENSE",
+    "external_libs/nanoarrow/LICENSE.txt",
+    "external_libs/nanoarrow/NOTICE.txt"
 ]
 maintainers = [
   {name = "Yu Shi", email = "yushi@microsoft.com"}
