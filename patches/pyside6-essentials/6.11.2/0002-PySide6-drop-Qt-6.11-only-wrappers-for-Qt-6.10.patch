From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] PySide6: drop Qt 6.11-only wrappers when building against
 Qt < 6.11

Upstream-Status: Inappropriate [our image ships Qt 6.10.1, not the 6.11.x pyside-setup 6.11.2 expects]

The typesystems mark QBasicReadWriteLock, QQuaternion::Axes,
QCustomSeries and QWebView/QWebViewLoadingInfo/QWebViewSettings as
since="6.11", so shiboken skips them against Rocky 10's Qt 6.10.1. The
module CMakeLists still list their *_wrapper.cpp unconditionally, and
CMake's AUTOMOC then aborts on the first missing one:

  AutoGen error
  The source file "BIN:/PySide6/QtCore/PySide6/QtCore/
  qbasicreadwritelock_wrapper.cpp" does not exist.

Remove those sources from the module lists when Qt is older than 6.11.
---
diff --git a/sources/pyside6/PySide6/QtCore/CMakeLists.txt b/sources/pyside6/PySide6/QtCore/CMakeLists.txt
index 997b0fe..8aa4b66 100644
--- a/sources/pyside6/PySide6/QtCore/CMakeLists.txt
+++ b/sources/pyside6/PySide6/QtCore/CMakeLists.txt
@@ -207,6 +207,12 @@ ${SPECIFIC_OS_FILES}
 ${QtCore_GEN_DIR}/qtcore_module_wrapper.cpp
 )
 
+# Qt < 6.11 lacks these classes, so shiboken generates no wrapper for them.
+if(Qt${QT_MAJOR_VERSION}Core_VERSION VERSION_LESS 6.11)
+    list(REMOVE_ITEM QtCore_SRC
+         ${QtCore_GEN_DIR}/qbasicreadwritelock_wrapper.cpp)
+endif()
+
 get_property(QtCore_disabled_features TARGET Qt${QT_MAJOR_VERSION}::Core
              PROPERTY QT_DISABLED_PUBLIC_FEATURES)
 
diff --git a/sources/pyside6/PySide6/QtGraphs/CMakeLists.txt b/sources/pyside6/PySide6/QtGraphs/CMakeLists.txt
index 1846f59..1f04b65 100644
--- a/sources/pyside6/PySide6/QtGraphs/CMakeLists.txt
+++ b/sources/pyside6/PySide6/QtGraphs/CMakeLists.txt
@@ -62,6 +62,12 @@ ${QtGraphs_GEN_DIR}/qxyseries_wrapper.cpp
 ${QtGraphs_GEN_DIR}/qtgraphs_module_wrapper.cpp
 )
 
+# Qt < 6.11 lacks these classes, so shiboken generates no wrapper for them.
+if(Qt${QT_MAJOR_VERSION}Core_VERSION VERSION_LESS 6.11)
+    list(REMOVE_ITEM QtGraphs_SRC
+         ${QtGraphs_GEN_DIR}/qcustomseries_wrapper.cpp)
+endif()
+
 set(QtGraphs_include_dirs ${QtGraphs_SOURCE_DIR}
                           ${QtGraphs_BINARY_DIR}
                           ${Qt${QT_MAJOR_VERSION}Core_INCLUDE_DIRS}
diff --git a/sources/pyside6/PySide6/QtGui/CMakeLists.txt b/sources/pyside6/PySide6/QtGui/CMakeLists.txt
index 778b1d6..6b1c4a7 100644
--- a/sources/pyside6/PySide6/QtGui/CMakeLists.txt
+++ b/sources/pyside6/PySide6/QtGui/CMakeLists.txt
@@ -291,6 +291,12 @@ ${QtGui_GEN_DIR}/qwindowstatechangeevent_wrapper.cpp
 ${QtGui_GEN_DIR}/qtgui_module_wrapper.cpp
 )
 
+# Qt < 6.11 lacks these classes, so shiboken generates no wrapper for them.
+if(Qt${QT_MAJOR_VERSION}Core_VERSION VERSION_LESS 6.11)
+    list(REMOVE_ITEM QtGui_SRC
+         ${QtGui_GEN_DIR}/qquaternion_axes_wrapper.cpp)
+endif()
+
 get_property(QtGui_enabled_features TARGET Qt${QT_MAJOR_VERSION}::Gui
              PROPERTY QT_ENABLED_PUBLIC_FEATURES)
 
diff --git a/sources/pyside6/PySide6/QtWebView/CMakeLists.txt b/sources/pyside6/PySide6/QtWebView/CMakeLists.txt
index 4251bac..129af2d 100644
--- a/sources/pyside6/PySide6/QtWebView/CMakeLists.txt
+++ b/sources/pyside6/PySide6/QtWebView/CMakeLists.txt
@@ -12,6 +12,14 @@ ${QtWebView_GEN_DIR}/qwebviewsettings_wrapper.cpp
 ${QtWebView_GEN_DIR}/qtwebview_module_wrapper.cpp
 )
 
+# Qt < 6.11 lacks these classes, so shiboken generates no wrapper for them.
+if(Qt${QT_MAJOR_VERSION}Core_VERSION VERSION_LESS 6.11)
+    list(REMOVE_ITEM QtWebView_Src
+         ${QtWebView_GEN_DIR}/qwebview_wrapper.cpp
+         ${QtWebView_GEN_DIR}/qwebviewloadinginfo_wrapper.cpp
+         ${QtWebView_GEN_DIR}/qwebviewsettings_wrapper.cpp)
+endif()
+
 set(QtWebView_include_dirs ${QtWebView_SOURCE_DIR}
                            ${QtWebView_BINARY_DIR}
                            ${Qt${QT_MAJOR_VERSION}Core_INCLUDE_DIRS}
