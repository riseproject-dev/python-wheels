From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 8 Nov 2026 12:00:00 +0000
Subject: [PATCH] cmake: recognize riscv64 as a target platform

cmake/target_platform.cmake normalizes CMAKE_SYSTEM_PROCESSOR into
genai_target_platform and hits FATAL_ERROR "Unsupported architecture"
for anything that is not arm64, x64 or powerpc, so configuring on a
riscv64 Linux host stops before any source is compiled. The variable
only selects per-platform naming for the Java/WinML/MSVC paths, none of
which apply on Linux riscv64, so mapping riscv64 to its own value (as
powerpc already is) is enough to get the core and Python SDK to build.

Upstream-Status: To upstream [not yet submitted; a one-line arch-detection addition for microsoft/onnxruntime-genai]
---
diff --git a/cmake/target_platform.cmake b/cmake/target_platform.cmake
index 222e420..cc00963 100644
--- a/cmake/target_platform.cmake
+++ b/cmake/target_platform.cmake
@@ -4,7 +4,7 @@
 # global_variables.cmake) so that standalone SDK projects (e.g. src/python, src/java) built
 # incrementally against a prebuilt core can reuse it without pulling in the full core build.
 #
-# Sets: genai_target_platform (one of: x64, arm64, powerpc)
+# Sets: genai_target_platform (one of: x64, arm64, powerpc, riscv64)

 if (MSVC)
   if (CMAKE_VS_PLATFORM_NAME)
@@ -59,6 +59,8 @@ else()
     set(genai_target_platform "x64")
   elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "powerpc")
     set(genai_target_platform "powerpc")
+  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^riscv64$")
+    set(genai_target_platform "riscv64")
   else()
     message(FATAL_ERROR "Unsupported architecture. CMAKE_SYSTEM_PROCESSOR: ${CMAKE_SYSTEM_PROCESSOR}")
   endif()
--
