From 7d559034cb549dc36e32c4cf93d428a8eda81e88 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 27 Aug 2026 05:01:03 +0200
Subject: [PATCH] Package the statically linked c-ares licences

The extension links c-ares statically: setup.py configures the bundled
deps/c-ares submodule with -DCARES_STATIC=ON -DCARES_SHARED=OFF and passes
the resulting libcares.a as extra_objects, so every published wheel carries
c-ares' compiled code. The wheel nevertheless ships only pycares' own
LICENSE, while the c-ares sources compiled into it are MIT (140 files) plus
src/lib/ares_sortaddrinfo.c under BSD-3-Clause and, on macOS,
src/lib/thirdparty/apple/dnsinfo.h under APSL-2.0. All three require their
copyright notice to travel with binary redistributions.

Declare the relevant files via PEP 639 license-files so setuptools packages
them into dist-info/licenses/ next to LICENSE. The remaining texts in
deps/c-ares/LICENSES/ (GPL-3.0, LGPL-2.1, FSFAP, Autoconf-exception) cover
autotools m4 macros that are never compiled into a wheel, so they are
deliberately left out. deps/c-ares/AUTHORS is included because c-ares'
LICENSE.md refers to it for the contributor copyright holders.

Upstream-Status: To upstream [needs a pull request against saghul/pycares; not submitted from this automated port run]
---
 pyproject.toml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/pyproject.toml b/pyproject.toml
index 3a9650d..4e8b9e1 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -14,6 +14,13 @@ description = "Python interface for c-ares"
 readme = {file = "PYPIREADME.rst", content-type = "text/x-rst"}
 requires-python = ">=3.9"
 license = "MIT"
+license-files = [
+    "LICENSE",
+    "deps/c-ares/AUTHORS",
+    "deps/c-ares/LICENSE.md",
+    "deps/c-ares/LICENSES/APSL-2.0.txt",
+    "deps/c-ares/LICENSES/BSD-3-Clause.txt",
+]
 authors = [
     {name = "Saúl Ibarra Corretgé", email = "s@saghul.net"}
 ]
