From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 28 Sep 2026 00:00:00 +0200
Subject: [PATCH] pyproject: ship the ICU and PyICU licences in the wheel

The wheel bundles PyICU's extension (MIT) and, via auditwheel,
libicudata/libicuuc/libicui18n (Unicode-3.0 plus the third-party notices
in ICU's LICENSE). Both notices already sit in licenses/, but hatchling
only picks up the root LICENSE.txt by default, so the released wheels
carry the Apache-2.0 text alone. Listing licenses/*.txt in PEP 639
license-files puts them in dist-info/licenses/ with no other change.

Upstream's own 2.15.2 wheels on PyPI carry the same gap on every
platform.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against Init7/pyicu]
---
 pyproject.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/pyproject.toml b/pyproject.toml
index 2ee507f..7c12f33 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -9,6 +9,7 @@ description = 'Wheels for PyICU'
 readme = "README.md"
 requires-python = ">=3.10"
 license = "Apache-2.0"
+license-files = ["LICENSE.txt", "licenses/*.txt"]
 keywords = ["icu", "i18n", "wheel"]
 classifiers = [
   "Development Status :: 4 - Beta",
--
2.43.0
