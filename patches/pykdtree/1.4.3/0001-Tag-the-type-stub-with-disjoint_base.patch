From 47290630533b81b05c1d3f07915100b00ad4f342 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 7 Sep 2026 13:28:19 +0200
Subject: [PATCH] Tag the type stub with @disjoint_base

mypy's stubtest now requires runtime classes that are a disjoint base
(no other class can inherit from them and something else at the same
time) to be marked @disjoint_base in the stub, or it fails the
consistency check. KDTree is such a class, so `pytest --pyargs
pykdtree` fails under recent mypy versions with 'pykdtree.kdtree.KDTree
is a disjoint base at runtime, but isn't marked with @disjoint_base in
the stub'.

Upstream-Status: Backport [https://github.com/storpipfugl/pykdtree/pull/155]
---
 pykdtree/kdtree.pyi | 2 ++
 setup.py            | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/pykdtree/kdtree.pyi b/pykdtree/kdtree.pyi
index 9dc6fe8..6ef56d1 100644
--- a/pykdtree/kdtree.pyi
+++ b/pykdtree/kdtree.pyi
@@ -15,9 +15,11 @@
 # You should have received a copy of the GNU Lesser General Public License along
 # with this program.  If not, see <http://www.gnu.org/licenses/>.
 
+from typing_extensions import disjoint_base
 from typing import Any
 import numpy as np
 
+@disjoint_base
 class KDTree:
     """kd-tree for fast nearest-neighbour lookup.
     The interface is made to resemble the scipy.spatial kd-tree except
diff --git a/setup.py b/setup.py
index 9efdf8d..b985cb5 100644
--- a/setup.py
+++ b/setup.py
@@ -208,7 +208,7 @@ setup(
     python_requires='>=3.9',
     install_requires=['numpy'],
     extras_require={
-        'test': ['pytest', 'mypy'],
+        'test': ['pytest', 'mypy', "typing-extensions>=4.15"],
     },
     zip_safe=False,
     ext_modules=extensions,
