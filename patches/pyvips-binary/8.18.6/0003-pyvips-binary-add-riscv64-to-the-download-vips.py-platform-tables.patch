From 71d7846d286050f8bd8bffac21269de823fbfbcc Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sat, 26 Sep 2026 11:45:31 +0000
Subject: [PATCH 3/4] Add riscv64 to the download-vips.py platform tables

Upstream-Status: To upstream [not yet submitted; python-wheels does not open issues/PRs on third-party repos]

get_plat() asserts the platform is in SUPPORTED_PLATFORMS, so a
riscv64 build fails before it downloads anything. Add linux-riscv64
and map the riscv64 machine name to the libvips-packaging platform
suffix, so the script resolves libvips-<version>-linux-riscv64.tar.gz
the same way it resolves the other Linux tarballs.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 scripts/download-vips.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/scripts/download-vips.py b/scripts/download-vips.py
index 23826eb..0b52604 100644
--- a/scripts/download-vips.py
+++ b/scripts/download-vips.py
@@ -18,6 +18,7 @@ BASE_LOC = (
 SUPPORTED_PLATFORMS = [
     'linux-aarch64',
     'linux-armv7l',
+    'linux-riscv64',
     'linux-x86_64',
     'musllinux-aarch64',
     'musllinux-x86_64',
@@ -33,6 +34,7 @@ ARCH_REMAP = {
     'amd64': 'x64',
     'arm64': 'arm64',
     'armv7l': 'arm',
+    'riscv64': 'riscv64',
     'x86_64': 'x64',
 }
 
