From e20dcedd086e4f3efb3f4dc8541dc13bbf7f226c Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sat, 26 Sep 2026 11:45:31 +0000
Subject: [PATCH 4/4] Let download-vips.py use a locally built libvips tarball

Upstream-Status: Inappropriate [python-wheels builds the riscv64 libvips-packaging tarball in the same workflow because no release asset exists for it]

kleisauke/libvips-packaging publishes no linux-riscv64 tarball, so the
riscv64 wheel build compiles one with libvips-packaging's own build.sh
first. Take its path from LIBVIPS_TARBALL and unpack that instead of
downloading the release asset; nothing changes when it is unset.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 scripts/download-vips.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/scripts/download-vips.py b/scripts/download-vips.py
index 0b52604..c7e94e8 100644
--- a/scripts/download-vips.py
+++ b/scripts/download-vips.py
@@ -92,6 +92,12 @@ def get_win32(arch):
 
 
 def download_vips(target, plat):
+    tarball = os.environ.get('LIBVIPS_TARBALL')
+    if tarball:
+        print(f'Using local "{tarball}"', file=sys.stderr)
+        shutil.copyfile(tarball, target)
+        return 'tar.gz'
+
     osname, arch = plat.split("-")
     headers = {'User-Agent':
                ('Mozilla/5.0 (Windows NT 6.1) AppleWebKit/537.36 ; '
