diff --git a/platforms/linux-riscv64/riscv64-linux-gnu-pkgconf b/platforms/linux-riscv64/riscv64-linux-gnu-pkgconf
new file mode 100755
index 0000000..84b5ae9
--- /dev/null
+++ b/platforms/linux-riscv64/riscv64-linux-gnu-pkgconf
@@ -0,0 +1,12 @@
+#!/bin/bash
+
+# Workaround for https://github.com/mesonbuild/meson/issues/5402
+for arg in "$@"; do
+  if [[ "$arg" == "--version" ]]; then
+    exec pkgconf --version
+    exit 0
+  fi
+done
+
+exec pkgconf "$@"
+exit $?
