-# Linux (x64, ARMv7 and ARM64v8)
-for flavour in linux-x64 linux-arm linux-arm64 linux-musl-x64 linux-musl-arm64; do
+# Linux (x64, ARMv7, ARM64v8 and RISC-V 64-bit)
+for flavour in linux-x64 linux-arm linux-arm64 linux-riscv64 linux-musl-x64 linux-musl-arm64; do
   if [ $PLATFORM = "all" ] || [ $PLATFORM = $flavour ]; then
