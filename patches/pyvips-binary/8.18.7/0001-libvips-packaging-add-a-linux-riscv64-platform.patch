diff --git a/platforms/linux-riscv64/Dockerfile b/platforms/linux-riscv64/Dockerfile
new file mode 100644
index 0000000..04f1d6b
--- /dev/null
+++ b/platforms/linux-riscv64/Dockerfile
@@ -0,0 +1,60 @@
+FROM --platform=linux/riscv64 rockylinux/rockylinux:10-ubi-init
+
+## Copyright 2017 Lovell Fuller and others.
+## SPDX-License-Identifier: Apache-2.0
+
+# Create Rocky Linux 10 (glibc 2.39) container suitable for building Linux RISC-V 64-bit binaries
+
+# Path settings
+ENV \
+  RUSTUP_HOME="/usr/local/rustup" \
+  CARGO_HOME="/usr/local/cargo" \
+  PATH="/usr/local/cargo/bin:$PATH"
+
+# Build dependencies
+RUN \
+  dnf update -y && \
+  dnf install -y dnf-plugins-core && \
+  dnf config-manager --set-enabled crb && \
+  dnf install -y --setopt=tsflags=nodocs \
+    autoconf \
+    automake \
+    bzip2 \
+    cmake \
+    diffutils \
+    findutils \
+    gcc \
+    gcc-c++ \
+    gettext \
+    git \
+    gperf \
+    jq \
+    libcurl-devel \
+    make \
+    openssl-devel \
+    patch \
+    pkgconf \
+    python3-pip \
+    tar \
+    xz \
+    && \
+  curl https://sh.rustup.rs -sSf | sh -s -- -y \
+    --no-modify-path \
+    --profile minimal \
+    --default-host riscv64gc-unknown-linux-gnu \
+    --default-toolchain nightly \
+    && \
+  cargo install cargo-c --locked && \
+  pip3 install meson ninja
+
+# Compiler settings
+ENV \
+  PKG_CONFIG="riscv64-linux-gnu-pkgconf --static" \
+  PLATFORM="linux-riscv64" \
+  FLAGS="-march=rv64gc" \
+  RUSTFLAGS="-Zlocation-detail=none -Zfmt-debug=none" \
+  MESON="--cross-file=/root/meson.ini"
+
+COPY Toolchain.cmake /root/
+COPY meson.ini /root/
+COPY riscv64-linux-gnu-pkgconf /usr/bin
