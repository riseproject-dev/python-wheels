From 1edead9b6f909937b09daa82681f83e4d85c586a Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 27 Aug 2026 17:21:10 +0200
Subject: [PATCH] use schedule(static, 1) for the guided OpenMP loops in
 dd_dtw_openmp.c

Upstream-Status: Inappropriate [riscv64 libgomp defect, riseproject-dev/python-wheels#617]

libgomp's guided work-share schedule faults on the riscv64 machines these
wheels are built and tested on, the same class of defect worked around in
patches/lightgbm/4.7.0/0002-*.patch. dd_dtw_openmp.c's 6 parallel-for loops
(the OpenMP paths of dtw distance/subsequence/warping-paths computation)
all use schedule(guided) and segfault under it on riscv64. Moving them to
schedule(static, 1) keeps per-iteration scheduling (each iteration is its
own chunk, so load imbalance from the row-triangular loop bounds is still
spread across threads) while avoiding the guided iterator that faults.
Revert once the runners' toolchain is fixed.
---
 src/DTAIDistanceC/DTAIDistanceC/dd_dtw_openmp.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/DTAIDistanceC/DTAIDistanceC/dd_dtw_openmp.c b/src/DTAIDistanceC/DTAIDistanceC/dd_dtw_openmp.c
index 9858082..0918d53 100644
--- a/src/DTAIDistanceC/DTAIDistanceC/dd_dtw_openmp.c
+++ b/src/DTAIDistanceC/DTAIDistanceC/dd_dtw_openmp.c
@@ -114,7 +114,7 @@ idx_t dtw_distances_ptrs_parallel(seq_t **ptrs, idx_t nb_ptrs, idx_t* lengths,
     // Using schedule("static, 1") is also fast for the same reason (neighbor rows are almost
     // the same length, thus a circular assignment works well) but assumes all DTW computations take
     // the same amount of time.
-    #pragma omp parallel for private(r_i, c_i, r, c) schedule(guided)
+    #pragma omp parallel for private(r_i, c_i, r, c) schedule(static, 1)
     for (r_i=0; r_i < (block->re - block->rb); r_i++) {
         r = block->rb + r_i;
         c_i = 0;
@@ -167,7 +167,7 @@ idx_t dtw_distances_ndim_ptrs_parallel(seq_t **ptrs, idx_t nb_ptrs, idx_t* lengt
     
 #if defined(_OPENMP)
     r_i=0;
-    #pragma omp parallel for private(r_i, c_i, r, c) schedule(guided)
+    #pragma omp parallel for private(r_i, c_i, r, c) schedule(static, 1)
     for (r_i=0; r_i < (block->re - block->rb); r_i++) {
         r = block->rb + r_i;
         c_i = 0;
@@ -221,7 +221,7 @@ idx_t dtw_distances_matrix_parallel(seq_t *matrix, idx_t nb_rows, idx_t nb_cols,
     
 #if defined(_OPENMP)
     r_i=0;
-    #pragma omp parallel for private(r_i, c_i, r, c) schedule(guided)
+    #pragma omp parallel for private(r_i, c_i, r, c) schedule(static, 1)
     for (r_i=0; r_i < (block->re - block->rb); r_i++) {
         r = block->rb + r_i;
         c_i = 0;
@@ -274,7 +274,7 @@ idx_t dtw_distances_ndim_matrix_parallel(seq_t *matrix, idx_t nb_rows, idx_t nb_
     
 #if defined(_OPENMP)
     r_i=0;
-    #pragma omp parallel for private(r_i, c_i, r, c) schedule(guided)
+    #pragma omp parallel for private(r_i, c_i, r, c) schedule(static, 1)
     for (r_i=0; r_i < (block->re - block->rb); r_i++) {
         r = block->rb + r_i;
         c_i = 0;
@@ -328,7 +328,7 @@ idx_t dtw_distances_matrices_parallel(seq_t *matrix_r, idx_t nb_rows_r, idx_t nb
     
 #if defined(_OPENMP)
     r_i=0;
-    #pragma omp parallel for private(r_i, c_i, r, c) schedule(guided)
+    #pragma omp parallel for private(r_i, c_i, r, c) schedule(static, 1)
     for (r_i=0; r_i < (block->re - block->rb); r_i++) {
         r = block->rb + r_i;
         c_i = 0;
@@ -381,7 +381,7 @@ idx_t dtw_distances_ndim_matrices_parallel(seq_t *matrix_r, idx_t nb_rows_r, idx
     
 #if defined(_OPENMP)
     r_i=0;
-    #pragma omp parallel for private(r_i, c_i, r, c) schedule(guided)
+    #pragma omp parallel for private(r_i, c_i, r, c) schedule(static, 1)
     for (r_i=0; r_i < (block->re - block->rb); r_i++) {
         r = block->rb + r_i;
         c_i = 0;
