Upstream-Status: Inappropriate [manylinux images ship no libpython by design; upstream builds its wheels on full distros where Development.Embed resolves]

CMake/external_pybind11.cmake asks FindPython for the whole Development
component (Module + Embed) only to read Python_SITEARCH for the install
dir. Development.Embed needs libpython, which the manylinux interpreters
deliberately do not ship, so configure fails with "Could NOT find Python
(missing: ... Development.Embed)". The extensions themselves are built
through pybind11's own Python lookup and never link libpython, so asking
for Development.Module alone is enough.

diff --git a/CMake/external_pybind11.cmake b/CMake/external_pybind11.cmake
index f2c4c03..e1fe8e4 100644
--- a/CMake/external_pybind11.cmake
+++ b/CMake/external_pybind11.cmake
@@ -71,7 +71,7 @@ function(get_pybind11)
       find_package(PythonLibs REQUIRED)
       set( PYTHON_INSTALL_DIR "${CMAKE_INSTALL_LIBDIR}/python${PYTHON_VERSION_MAJOR}.${PYTHON_VERSION_MINOR}/pyrealsense2" CACHE PATH "Installation directory for Python bindings")
     else()
-      find_package(Python REQUIRED COMPONENTS Interpreter Development)
+      find_package(Python REQUIRED COMPONENTS Interpreter Development.Module)
       set( PYTHON_INSTALL_DIR "${Python_SITEARCH}/pyrealsense2" CACHE PATH "Installation directory for Python bindings")
     endif()
 
