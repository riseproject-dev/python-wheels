From fd22b748f4c24b650e68dc7e90a89245c5c010e6 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 11 Sep 2026 12:12:26 +0200
Subject: [PATCH] tests: skip embree tests when igl.embree is unavailable

Embree's CMake ISA detection (EMBREE_MAX_ISA=DEFAULT) only recognizes
x86 (SSE2..AVX512) and ARM (NEON/NEON2X); check_isa_default.cmake falls
back to "SSE2" on any other CMAKE_SYSTEM_PROCESSOR, which then fails
to compile actual SSE2 intrinsics. riscv64 has no Embree ISA at all, so
the riscv64 build configures with -DLIBIGL_EMBREE=OFF, and igl.embree
does not exist. tests/test_all.py imported it unconditionally at module
scope, which would abort collection of the whole file.

Upstream-Status: Inappropriate [riscv64-only build config; embree is unconditionally enabled and works fine for every architecture upstream actually builds for (x86_64/aarch64/macOS/Windows)]
---
 tests/test_all.py | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/tests/test_all.py b/tests/test_all.py
index ed893aa..fe874f4 100644
--- a/tests/test_all.py
+++ b/tests/test_all.py
@@ -10,7 +10,14 @@ import igl.triangle
 import igl.copyleft
 import igl.copyleft.tetgen
 import igl.copyleft.cgal
-import igl.embree
+try:
+    import igl.embree
+    HAS_EMBREE = True
+except ImportError:
+    # Embree has no riscv64 ISA (its CMake ISA detection only knows x86
+    # SSE2..AVX512 and ARM NEON/NEON2X); the riscv64 build configures with
+    # LIBIGL_EMBREE=OFF, so igl.embree does not exist.
+    HAS_EMBREE = False
 import igl.spectra
 import igl.predicates
 import igl.cycodebase
@@ -569,6 +576,7 @@ def test_cgal():
 
     R = igl.copyleft.cgal.oriented_bounding_box(VC)
     
+@pytest.mark.skipif(not HAS_EMBREE, reason="igl.embree unavailable (LIBIGL_EMBREE=OFF on riscv64)")
 def test_embree():
     # octahedron
     V = np.array([[1,0,0],[0,1,0],[0,0,1],[-1,0,0],[0,-1,0],[0,0,-1]],dtype=np.float64)
@@ -1392,6 +1400,7 @@ def test_new_tetgen_algorithms():
     assert FF_sk.shape[1] == 3
 
 
+@pytest.mark.skipif(not HAS_EMBREE, reason="igl.embree unavailable (LIBIGL_EMBREE=OFF on riscv64)")
 def test_new_embree_algorithms():
     V_oct = np.array([[1,0,0],[0,1,0],[0,0,1],[-1,0,0],[0,-1,0],[0,0,-1]], dtype=np.float64)
     F_oct = np.array([[0,1,2],[0,2,4],[0,4,5],[0,5,1],[1,3,2],[1,5,3],[2,3,4],[3,5,4]], dtype=np.int64)
