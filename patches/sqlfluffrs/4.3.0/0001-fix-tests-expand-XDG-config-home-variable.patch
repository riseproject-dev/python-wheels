From 2dd9c7c7efc53d4a87932be2cee96293ea58e744 Mon Sep 17 00:00:00 2001
From: Tobias Ruby <tobias.ruby@live.com>
Date: Wed, 9 Sep 2026 23:44:55 +0000
Subject: [PATCH] fix(tests): expand XDG config home variable (#8461)

Upstream-Status: Backport [https://github.com/sqlfluff/sqlfluff/commit/2dd9c7c7efc53d4a87932be2cee96293ea58e744]

platformdirs 4.12.0 started ignoring a non-absolute XDG_CONFIG_HOME, as
the XDG Base Directory spec requires. The 4.3.0 test fixture sets it to
the unexpanded "~/.config/my/special/path", so with any platformdirs
>= 4.12.0 the three XDG cases of test__config__get_user_config_dir_path
fail on every architecture. Upstream fixed the fixture in 4.4.0; this is
that commit, applied to the test tree only (the wheel is unaffected).

Co-authored-by: Tobias Ruby <rubytobi@users.noreply.github.com>
---
 test/core/config/loader_test.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/test/core/config/loader_test.py b/test/core/config/loader_test.py
index 83950155..5011ad7d 100644
--- a/test/core/config/loader_test.py
+++ b/test/core/config/loader_test.py
@@ -37,8 +37,10 @@ config_a = {
 
 @pytest.fixture
 def mock_xdg_home(monkeypatch):
-    """Sets the XDG_CONFIG_HOME variable."""
-    monkeypatch.setenv("XDG_CONFIG_HOME", "~/.config/my/special/path")
+    """Sets the XDG_CONFIG_HOME variable which must be an absolute path."""
+    monkeypatch.setenv(
+        "XDG_CONFIG_HOME", os.path.expanduser("~/.config/my/special/path")
+    )
 
 
 def test__config__load_file_dir():
-- 
