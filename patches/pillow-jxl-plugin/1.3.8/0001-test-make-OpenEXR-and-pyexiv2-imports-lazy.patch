From 59744a7bd9210d6c7099d5bbbbecdeb0e21914a6 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 5 Oct 2026 00:00:00 +0000
Subject: [PATCH] test: make OpenEXR and pyexiv2 imports lazy

OpenEXR (test_decode_F16) and pyexiv2 (the metadata-encode tests) are
unconditional module-level imports, so the whole test file fails to
collect wherever either package is absent. On riscv64, pyexiv2 has no
wheel on pypi.riseproject.dev at all, and OpenEXR has none for the
cp310/cp311 interpreters this port tests, so collection failed before
a single test ran. Move both imports into the functions that use them
and use pytest.importorskip, so unrelated tests still collect and run
and only the dependency-gated ones are skipped.

Upstream-Status: Inappropriate [riscv64 test environment has no pyexiv2 wheel at all, and no OpenEXR wheel for some of the interpreters this port tests]
---
 test/test_plugin.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/test/test_plugin.py b/test/test_plugin.py
index 38594ad..b65ad98 100644
--- a/test/test_plugin.py
+++ b/test/test_plugin.py
@@ -2,8 +2,6 @@ import os
 import tempfile
 
 import numpy as np
-import OpenEXR
-import pyexiv2
 import pytest
 from PIL import Image
 
@@ -50,6 +48,7 @@ def test_decode_F():
 
 
 def test_decode_F16():
+    OpenEXR = pytest.importorskip("OpenEXR")
     img_jxl = Image.open("test/images/random_image_f16.jxl")
     assert img_jxl.mode == "RGB"
 
@@ -116,6 +115,7 @@ def test_metadata_decode_from_direct_decoding():
 
 
 def test_metadata_encode_from_jpg():
+    pyexiv2 = pytest.importorskip("pyexiv2")
     # Load a JPEG image
     ref_img_path = "test/images/metadata/1x1_exif_xmp.jpg"
     temp = tempfile.mktemp(suffix=".jxl")
@@ -130,6 +130,7 @@ def test_metadata_encode_from_jpg():
 
 
 def test_metadata_encode_from_raw_exif():
+    pyexiv2 = pytest.importorskip("pyexiv2")
     with open("test/images/metadata/sample.exif", "rb") as f:
         ref_exif = f.read()
     img_ori = Image.open("test/images/sample.png")
@@ -142,6 +143,7 @@ def test_metadata_encode_from_raw_exif():
 
 
 def test_metadata_encode_from_pil_exif():
+    pyexiv2 = pytest.importorskip("pyexiv2")
     exif_img_path = "test/images/metadata/1x1_exif_xmp.jpg"
     dummy_img = Image.open("test/images/sample.png")
     exif_img = Image.open(exif_img_path)
