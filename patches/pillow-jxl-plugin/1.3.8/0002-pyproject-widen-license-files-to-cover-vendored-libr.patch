From f15842a37a57fbb3d7abe8cdd0c21ebe9625bf44 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 5 Oct 2026 00:00:00 +0000
Subject: [PATCH] pyproject: widen license-files to cover vendored libraries

license-files = ["LICENSE"] is an explicit PEP 639 list with no glob
default behind it, so dropping a LICENSE.<lib> file at the project root
for a vendored C/C++ library compiled into the extension is silently
ignored. The vendored feature statically links libjxl (BSD-3-Clause,
with its own PATENTS grant), highway (Apache-2.0 / BSD-3-Clause dual
licence), brotli (MIT) and skcms (BSD-3-Clause), yet only the plugin's
own GPL-3.0-or-later LICENSE lands in dist-info/licenses. Widen the
glob so the build can stage those files under matching names.

Upstream-Status: Inappropriate [this build vendors libjxl/highway/brotli/skcms from source via the vendored cargo feature; upstream's own release wheels either dynamically link a system libjxl or statically link it without staging the dependencies' licence files either, so this is specific to how this port assembles the wheel]
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index c9393dd..21e6580 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -11,7 +11,7 @@ authors = [
 description = "Pillow plugin for JPEG-XL, using Rust for bindings."
 readme = "README.md"
 license = "GPL-3.0-or-later"
-license-files = ["LICENSE"]
+license-files = ["LICENSE", "LICENSE.*", "PATENTS.*"]
 classifiers = [
     "Programming Language :: Rust",
     "Programming Language :: Python :: Implementation :: CPython",
-- 
2.43.0

