+def read_project_license() -> str | None:
+    """Return the SPDX `[project] license` expression from pyproject.toml, if any."""
+    with open(ROOT / "pyproject.toml", "rb") as f:
+        license_expression = tomllib.load(f)["project"].get("license")
+    return license_expression if isinstance(license_expression, str) else None
+
+
 def record_hash(data: bytes) -> str:
