From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 01:22:02 +0000
Subject: [PATCH] clients/pytest-mergify: bump abi3 floor to py39

Upstream-Status: Inappropriate [manylinux_2_39_riscv64 ships no cp38 interpreter]

The riscv64 manylinux image's oldest available CPython is cp39 (no
cp38), so a wheel built here and tagged cp38-abi3 (this crate's
abi3-py38 feature) would never actually be compiled or tested against
its own declared floor -- gotcha 96. Bump the pyo3 abi3 feature to
abi3-py39 to make the riscv64 wheel's tag match the oldest interpreter
this repo can build and test it on; every other platform's wheel is
unaffected.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 clients/pytest-mergify/Cargo.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/clients/pytest-mergify/Cargo.toml b/clients/pytest-mergify/Cargo.toml
index 4a2853a..8599831 100644
--- a/clients/pytest-mergify/Cargo.toml
+++ b/clients/pytest-mergify/Cargo.toml
@@ -17,8 +17,8 @@ crate-type = ["cdylib"]
 [dependencies]
 mergify-ci-core = { path = "../../crates/mergify-ci-core" }
 mergify-ci-api = { path = "../../crates/mergify-ci-api" }
-# abi3-py38: one wheel works across all CPython 3.8+ on a given platform.
-pyo3 = { version = "0.29", features = ["abi3-py38", "extension-module"] }
+# abi3-py39: one wheel works across all CPython 3.9+ on a given platform.
+pyo3 = { version = "0.29", features = ["abi3-py39", "extension-module"] }
 # A single-threaded runtime to drive the async client's futures to completion
 # from sync Python (the drivers unify with reqwest's).
 tokio = { version = "1", features = ["rt", "net", "time"] }
