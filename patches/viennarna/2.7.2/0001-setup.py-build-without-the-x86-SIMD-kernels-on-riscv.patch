From 0ff2101a7ebd99786dbcd657d056181426b4ce69 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 13 Oct 2026 21:50:29 +0000
Subject: [PATCH] setup.py: build without the x86 SIMD kernels on riscv64

Upstream-Status: To upstream [not yet submitted; the SIMD gate should probably whitelist x86 rather than blacklist arm64/aarch64/riscv64]

On Linux, vrna_build_ext only skips the SSE4.1/AVX-512 sources and their
-msse4.1/-mavx512f flags on arm64/aarch64; every other architecture gets
them, so the riscv64 build fails as soon as GCC sees an x86 -m flag. Treat
riscv64 like aarch64: drop the SIMD sources and macros, leaving the generic
C implementations that cpu.c already falls back to off x86.
---
 setup.py.in | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/setup.py.in b/setup.py.in
index 5fe71a1..5e8c000 100644
--- a/setup.py.in
+++ b/setup.py.in
@@ -201,7 +201,8 @@ class vrna_build_ext(build_ext):
                 ext.sources.append("src/@DLIB_DIR@/dlib/all/source.cpp")
             else:
                 if (platform.machine() == "arm64" or "arm64" in os.getenv("ARCHFLAGS", "")) or \
-                   (platform.machine() == "aarch64" or "aarch64" in os.getenv("ARCHFLAGS", "")):
+                   (platform.machine() == "aarch64" or "aarch64" in os.getenv("ARCHFLAGS", "")) or \
+                   platform.machine() == "riscv64":
                     self.with_simd = False
                     # collect all SIMD specific files
                     simd_files = [f for tmp in vrna_simd_files.values() for f in tmp]
