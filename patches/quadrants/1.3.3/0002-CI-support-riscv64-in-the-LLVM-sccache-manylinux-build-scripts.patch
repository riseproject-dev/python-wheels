From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RISE Project CI <ci@riseproject.dev>
Date: Thu, 15 Oct 2026 00:05:00 +0000
Subject: [PATCH] CI: support riscv64 in the LLVM/sccache/manylinux build
 scripts

quadrants-sdk-builds (the GitHub release bucket .github/workflows/
scripts/qd_build/llvm.py downloads a prebuilt LLVM 22.1.0 from) ships
only linux-x86_64/linux-aarch64/macos-arm64/windows-amd64 archives, and
mozilla/sccache's v0.10.0 release has no riscv64 binary either. On
riscv64, setup_llvm() now expects the caller to build LLVM+clang 22.1.0
itself and export LLVM_DIR before build.py runs, and setup_sccache()
skips the compiler-launcher wrapping instead of trying to download a
binary that doesn't exist (CMakeLists.txt's own find_program(ccache)
still caches the per-interpreter rebuilds when the image has ccache
installed).

scripts_new/manylinux_wheel/2_build.sh's PLATFORM allowlist rejects
every arch but x86_64/aarch64; add riscv64. There is no riscv64
CUDA/AMDGPU/Vulkan backend (the LLVM CPU JIT is the only backend
riscv64 has), so turn those three off instead of upstream's CI default
of on, and skip QD_BUILD_TESTS (a CPU-only riscv64 leg doesn't need
the GPU-aware cpp test binary) and the gcc-toolset-14 include-path
workaround (that SCL package is x86_64/aarch64-only on the manylinux
images; riscv64 needs no such workaround since it only ever uses the
clang we ourselves just built).

Upstream-Status: Inappropriate [no riscv64 LLVM/sccache release exists to point at; this wires our own from-source riscv64 LLVM build in instead]

Signed-off-by: RISE Project CI <ci@riseproject.dev>
---
 .github/workflows/scripts/qd_build/llvm.py    |  7 +++++++
 .github/workflows/scripts/qd_build/sccache.py |  8 ++++++++
 .../scripts_new/manylinux_wheel/2_build.sh    | 20 ++++++++++++-------
 3 files changed, 28 insertions(+), 7 deletions(-)

diff --git a/.github/workflows/scripts/qd_build/llvm.py b/.github/workflows/scripts/qd_build/llvm.py
index dbb9891..487c487 100644
--- a/.github/workflows/scripts/qd_build/llvm.py
+++ b/.github/workflows/scripts/qd_build/llvm.py
@@ -28,6 +28,13 @@ def setup_llvm() -> str:
     )
 
     match (u.system, u.machine):
+        case ("Linux", "riscv64"):
+            # quadrants-sdk-builds ships no riscv64 LLVM; the caller builds LLVM itself and
+            # points LLVM_DIR at the install prefix before this runs.
+            out = os.environ.get("LLVM_DIR")
+            if not out:
+                raise RuntimeError("LLVM_DIR must be set to a prebuilt LLVM install on riscv64")
+            return out
         case ("Linux", "x86_64"):
             out = get_cache_home() / f"llvm-{llvm_version}-x86-{build_version}"
             url = release_url_template.format(platform="linux-x86_64")
diff --git a/.github/workflows/scripts/qd_build/sccache.py b/.github/workflows/scripts/qd_build/sccache.py
index b5561c7..cce2b1e 100644
--- a/.github/workflows/scripts/qd_build/sccache.py
+++ b/.github/workflows/scripts/qd_build/sccache.py
@@ -30,6 +30,14 @@ def setup_sccache() -> Command:
     else:
         raise RuntimeError(f"Unsupported platform: {u.system} {u.machine}")
 
+    if (u.system, u.machine) == ("Linux", "riscv64"):
+        # mozilla/sccache publishes no riscv64 binary (v0.10.0 release assets checked). Skip the
+        # compiler-launcher wrapping (entry.py's action_wheel still calls the returned command
+        # with --start-server / -s, so it must accept and ignore arbitrary args) and let ccache
+        # (installed from the manylinux image, found by CMakeLists.txt's own find_program) cache
+        # the per-interpreter rebuilds instead.
+        return sh.bake("true")
+
     if not exe.exists():
         if (u.system, u.machine) == ("Linux", "x86_64"):
             url = "https://github.com/mozilla/sccache/releases/download/v0.10.0/sccache-v0.10.0-x86_64-unknown-linux-musl.tar.gz"
diff --git a/.github/workflows/scripts_new/manylinux_wheel/2_build.sh b/.github/workflows/scripts_new/manylinux_wheel/2_build.sh
index 3c030bb..3561a10 100644
--- a/.github/workflows/scripts_new/manylinux_wheel/2_build.sh
+++ b/.github/workflows/scripts_new/manylinux_wheel/2_build.sh
@@ -3,7 +3,7 @@
 set -ex
 
 PLATFORM=$(uname -m)
-if [[ ! "$PLATFORM" =~ ^(x86_64|aarch64)$ ]]; then
+if [[ ! "$PLATFORM" =~ ^(x86_64|aarch64|riscv64)$ ]]; then
     echo "Unsupported architecture: $PLATFORM"
     exit 1
 fi
@@ -18,13 +18,19 @@ echo "Detected platform: $PLATFORM"
 # Add Taichi LLVM toolchain to PATH
 export PATH="$PWD/taichi-llvm-15.0.7-linux-${PLATFORM}/bin:$PATH"
 
-# Taichi build options
-export CMAKE_ARGS="-DQD_WITH_VULKAN:BOOL=ON -DQD_WITH_CUDA:BOOL=ON -DQD_WITH_AMDGPU:BOOL=ON -DQD_BUILD_TESTS:BOOL=ON"
+if [[ "$PLATFORM" == "riscv64" ]]; then
+    # No riscv64 CUDA/AMDGPU/Vulkan backend exists; the LLVM CPU JIT is the only one riscv64
+    # needs (gotcha "Add a riscv64 CPU arch" patch).
+    export CMAKE_ARGS="-DQD_WITH_VULKAN:BOOL=OFF -DQD_WITH_CUDA:BOOL=OFF -DQD_WITH_AMDGPU:BOOL=OFF -DQD_BUILD_TESTS:BOOL=OFF"
+else
+    # Taichi build options
+    export CMAKE_ARGS="-DQD_WITH_VULKAN:BOOL=ON -DQD_WITH_CUDA:BOOL=ON -DQD_WITH_AMDGPU:BOOL=ON -DQD_BUILD_TESTS:BOOL=ON"
 
-# GCC toolset include paths
-inc_base="/opt/rh/gcc-toolset-14/root/usr/include/c++/14"
-extra="$inc_base:$inc_base/${PLATFORM}-redhat-linux:$inc_base/backward"
+    # GCC toolset include paths
+    inc_base="/opt/rh/gcc-toolset-14/root/usr/include/c++/14"
+    extra="$inc_base:$inc_base/${PLATFORM}-redhat-linux:$inc_base/backward"
 
-export CPLUS_INCLUDE_PATH="${CPLUS_INCLUDE_PATH:+$CPLUS_INCLUDE_PATH:}$extra"
+    export CPLUS_INCLUDE_PATH="${CPLUS_INCLUDE_PATH:+$CPLUS_INCLUDE_PATH:}$extra"
+fi
 
 ./build.py wheel
