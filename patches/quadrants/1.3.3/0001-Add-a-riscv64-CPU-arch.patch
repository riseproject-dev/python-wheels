@@ -38,7 +38,7 @@ uint32_t LlvmRuntimeExecutor::publish_per_task_bound_count_cpu(std::size_t task_
   // Default to UINT32_MAX (no clamp); only override on a successful host evaluation. The codegen-emitted bounds clamp
   // at the float LCA-block claim site stays inert when the slot holds UINT32_MAX, so this fall-through is a no-op that
   // preserves the existing behaviour.
-  if (config_.arch != Arch::x64 && config_.arch != Arch::arm64) {
+  if (config_.arch != Arch::x64 && config_.arch != Arch::arm64 && config_.arch != Arch::riscv64) {
     return std::numeric_limits<uint32_t>::max();
   }
   if (!ad_stack.bound_expr.has_value()) {
diff --git a/quadrants/runtime/llvm/llvm_context.cpp b/quadrants/runtime/llvm/llvm_context.cpp
index d116503..ef7070c 100644
--- a/quadrants/runtime/llvm/llvm_context.cpp
+++ b/quadrants/runtime/llvm/llvm_context.cpp
@@ -725,7 +725,7 @@ std::unique_ptr<llvm::Module> QuadrantsLLVMContext::module_from_file(const std::
   }
 
   // CPU-specific intrinsics
-  if (arch_ == Arch::x64 || arch_ == Arch::arm64) {
+  if (arch_ == Arch::x64 || arch_ == Arch::arm64 || arch_ == Arch::riscv64) {
     auto func = module->getFunction("cpu_clock_i64");
     if (func) {
       func->deleteBody();
