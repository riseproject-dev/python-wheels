From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 00:00:00 +0000
Subject: [PATCH] build: drop the unused lint-only build requirements

Upstream-Status: Inappropriate [riscv64-only: libclang ships no riscv64 wheel and its sdist only downloads a prebuilt LLVM binary, so pip's isolated build environment cannot install it there]

tree_sitter_cpp, libclang and tree_sitter are only imported by
scripts/dev_script_library/dev_lint_check_exports.py,
scripts/dev_script_library/dev_python.py and docs/_ext/rst_processor.py
(the dev-lint and Sphinx doc tooling); python/setup.py's own build_ext
never imports any of them, and they only reappear in setup.py as the
unrelated 'cleanup' extras_require group. Listing them in
[build-system] requires still forces pip to install all three into the
isolated build venv before the wheel build even starts.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 python/pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/python/pyproject.toml b/python/pyproject.toml
index dee4c59..08e6dcc 100644
--- a/python/pyproject.toml
+++ b/python/pyproject.toml
@@ -1,6 +1,6 @@
 [build-system]
 build-backend = "setuptools.build_meta"
-requires = ["setuptools==69.2.0", "wheel==0.45.1", "flufl.lock", "pip", "nanobind==2.9.2", "numpy", "typing_extensions", "rosbags==0.9.23", "tree_sitter_cpp", "libclang", "tree_sitter"]
+requires = ["setuptools==69.2.0", "wheel==0.45.1", "flufl.lock", "pip", "nanobind==2.9.2", "numpy", "typing_extensions", "rosbags==0.9.23"]

 [tool.pytest.ini_options]
 testpaths = ["tests"]
