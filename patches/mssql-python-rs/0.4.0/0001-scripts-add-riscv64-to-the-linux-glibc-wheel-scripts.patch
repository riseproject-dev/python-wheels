Upstream-Status: To upstream [not yet submitted; upstream's own test_inject_odbc.py asserts linux_riscv64 maps to no driver, so riscv64 needs a maintainer discussion rather than a drive-by PR]

Add riscv64 to the Linux glibc wheel packaging scripts

The wheel build itself is architecture-neutral, but the three post-build
scripts that inject the mssql-odbc driver, retag the wheel manylinux and
verify the installed wheel each hardcode x86_64/aarch64 and reject any
other architecture. Map linux_riscv64 to libs/linux/glibc/riscv64/lib,
following the existing <arch> directory layout.

diff --git a/scripts/inject-odbc-into-wheels.py b/scripts/inject-odbc-into-wheels.py
index 78ca8e52..11d58140 100644
--- a/scripts/inject-odbc-into-wheels.py
+++ b/scripts/inject-odbc-into-wheels.py
@@ -45,6 +45,7 @@ _WIN_X64 = "windows/x64/mssqlodbc.dll"
 _WIN_ARM64 = "windows/arm64/mssqlodbc.dll"
 _GLIBC_X64 = "linux/glibc/x86_64/lib/mssqlodbc.so"
 _GLIBC_ARM64 = "linux/glibc/arm64/lib/mssqlodbc.so"
+_GLIBC_RISCV64 = "linux/glibc/riscv64/lib/mssqlodbc.so"
 _MUSL_X64 = "linux/musl/x86_64/lib/mssqlodbc.so"
 _MUSL_ARM64 = "linux/musl/arm64/lib/mssqlodbc.so"
 _MACOS_X64 = "macos/x86_64/lib/mssqlodbc.dylib"
@@ -75,6 +76,8 @@ def drivers_for_platform_tag(platform_tag: str) -> list[str]:
             return [_GLIBC_X64]
         if "aarch64" in tag:
             return [_GLIBC_ARM64]
+        if "riscv64" in tag:
+            return [_GLIBC_RISCV64]
 
     # macOS wheels are universal2 -> ship both arch slices.
     if "macosx" in tag and "universal2" in tag:
diff --git a/scripts/repair-glibc-wheels-in-container.sh b/scripts/repair-glibc-wheels-in-container.sh
index d7060ad8..090cf4fe 100644
--- a/scripts/repair-glibc-wheels-in-container.sh
+++ b/scripts/repair-glibc-wheels-in-container.sh
@@ -42,6 +42,7 @@ for wheel in "$WHEELS_DIR"/*.whl; do
     case "$tag" in
         linux_x86_64) plat="${PLAT}_x86_64" ;;
         linux_aarch64) plat="${PLAT}_aarch64" ;;
+        linux_riscv64) plat="${PLAT}_riscv64" ;;
         *) continue ;;
     esac
 
diff --git a/scripts/test-python-wheel-install.py b/scripts/test-python-wheel-install.py
index 3b6da012..18ec32f4 100644
--- a/scripts/test-python-wheel-install.py
+++ b/scripts/test-python-wheel-install.py
@@ -106,6 +106,8 @@ def expected_driver_path(wheel_name: str) -> str:
         architecture = "x86_64"
     elif platform_tag.endswith("_aarch64"):
         architecture = "arm64"
+    elif platform_tag.endswith("_riscv64"):
+        architecture = "riscv64"
     else:
         raise RuntimeError(f"Unsupported wheel architecture: {platform_tag}")
     return f"mssql_py_core/libs/linux/{libc}/{architecture}/lib/mssqlodbc.so"
