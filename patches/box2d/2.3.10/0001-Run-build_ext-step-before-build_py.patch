From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jarl Haggerty <jarl@covetouscat.com>
Date: Tue, 12 Jan 2021 00:03:42 -0500
Subject: [PATCH] Run build_ext step before build_py

Upstream-Status: Backport [https://github.com/pybox2d/pybox2d/commit/12507e851948bff1205ce7f6ff179467a051eb9d]

Without it bdist_wheel copies the package before SWIG has generated
library/Box2D/Box2D.py, so the wheel ships _Box2D.so without its Python
wrapper and `import Box2D` fails.

---
 setup.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/setup.py b/setup.py
index bb7ec95..440dea0 100644
--- a/setup.py
+++ b/setup.py
@@ -21,6 +21,12 @@ __license__='zlib'
 
 import setuptools
 from setuptools import (setup, Extension)
+from setuptools.command.build_py import build_py
+
+class build_py_after_build_ext(build_py):
+    def run(self):
+        self.run_command('build_ext')
+        return super().run()
 
 # release version number
 box2d_version  = '2.3'
@@ -138,6 +144,7 @@ setup_dict = dict(
                         },
     ext_modules      = [ pybox2d_extension ],
     include_package_data=True,
+    cmdclass={"build_py": build_py_after_build_ext},
     )
 
 # run the actual setup from distutils
