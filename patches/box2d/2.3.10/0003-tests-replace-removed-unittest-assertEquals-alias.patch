From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 14 Oct 2026 00:00:00 +0000
Subject: [PATCH] tests: replace removed unittest assertEquals alias

Upstream-Status: To upstream [upstream has had no commit or release since 2021]

TestCase.assertEquals was deprecated in Python 3.2 and removed in 3.12,
so every test_joints.py case fails with AttributeError on cp312 and
newer. Reproduces on any architecture. The same one-word change is in
the tests shipped inside PyPI's own cp310-cp313 2.3.10 wheels.

---
 library/Box2D/tests/test_joints.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/library/Box2D/tests/test_joints.py b/library/Box2D/tests/test_joints.py
index c6d9561..21deea4 100644
--- a/library/Box2D/tests/test_joints.py
+++ b/library/Box2D/tests/test_joints.py
@@ -97,7 +97,7 @@ class testJoints (unittest.TestCase):
         else:
             b = getattr(joint, prop)
 
-        self.assertEquals(a, b, "Property not equal from definition to joint: %s (dfn %s != joint %s)" % (prop, a, b) )
+        self.assertEqual(a, b, "Property not equal from definition to joint: %s (dfn %s != joint %s)" % (prop, a, b) )
 
     # ---- revolute joint ----
     def revolute_definition(self, body1, body2, anchor):
