From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 00:00:00 +0000
Subject: [PATCH] setup.py: plumb SAPIEN_PHYSX5_DIR

Upstream-Status: Inappropriate [riseproject.dev-specific: lets the from-source riscv64 PhysX build feed cmake/physx5.cmake's SAPIEN_PHYSX5_DIR cache variable]

cmake/physx5.cmake already reads SAPIEN_PHYSX5_DIR as a cache variable
(it's how a prebuilt PhysX install overrides the FetchContent
download), but setup.py never threads anything into it -- there is no
CLI flag and no environment variable read anywhere in the file. Add
--physx5-dir (falling back to the SAPIEN_PHYSX5_DIR environment
variable, so CI can just export it) and pass it through as
-DSAPIEN_PHYSX5_DIR=... on both cmake invocations: build_sapien()
(where physx5 is actually linked) and CMakeBuild.build_pybind() (kept
in sync for consistency, even though the pybind step only needs
sapien_DIR from the already-built install).

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 setup.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/setup.py b/setup.py
index 0000000..0000000 100644
--- a/setup.py
+++ b/setup.py
@@ -32,6 +32,12 @@
     help="directory to put build files",
 )
 parser.add_argument(
+    "--physx5-dir",
+    type=str,
+    default=os.environ.get("SAPIEN_PHYSX5_DIR", ""),
+    help="directory containing a prebuilt PhysX 5 install (also read from SAPIEN_PHYSX5_DIR)",
+)
+parser.add_argument(
     "--get-version",
     action="store_true",
     help="print version string and exit immediately",
@@ -131,6 +137,8 @@
         cmake_args += ["-DSAPIEN_CUDA=ON"]
     else:
         cmake_args += ["-DSAPIEN_CUDA=OFF"]
+    if args.physx5_dir:
+        cmake_args += [f"-DSAPIEN_PHYSX5_DIR={args.physx5_dir}"]
 
     cmake_args += [
         f"-DCMAKE_BUILD_TYPE={cfg}",
@@ -257,6 +265,8 @@
         cmake_args += [
             "-Dsapien_DIR=" + os.path.join(sapien_install_dir, "lib/cmake/sapien")
         ]
+        if args.physx5_dir:
+            cmake_args += [f"-DSAPIEN_PHYSX5_DIR={args.physx5_dir}"]
         
         if platform.system() == "Darwin":
             cmake_args += ["-DCMAKE_TOOLCHAIN_FILE=../toolchains/macos.toolchain.cmake"]
--
