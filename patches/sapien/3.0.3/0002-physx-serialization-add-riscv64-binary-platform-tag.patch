From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 00:00:00 +0000
Subject: [PATCH] physx/serialization: add riscv64 binary platform tag

Upstream-Status: To upstream [no riscv64 CI to validate against yet]

getBinaryPlatformTag() in SnSerialUtils.cpp is a real compile blocker
on riscv64 independent of the PxPreprocessor.h arch define: with
PX_RISCV64 now defined (previous patch), none of the existing
PX_WINDOWS/PX_LINUX/PX_OSX/PX_SWITCH x PX_X86/PX_X64/PX_A64 branches
match it, so it falls straight through to `#error Unknown binary
platform`. Add a tenth table entry (FOURCC 'L','R','6','4', name
"linuxriscv64") and the matching `#elif PX_LINUX && PX_RISCV64` branch,
bumping SN_NUM_BINARY_PLATFORMS from 9 to 10 to match.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 .../src/serialization/SnSerialUtils.cpp      | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/physx/source/physxextensions/src/serialization/SnSerialUtils.cpp b/physx/source/physxextensions/src/serialization/SnSerialUtils.cpp
index 0000000..0000000 100644
--- a/physx/source/physxextensions/src/serialization/SnSerialUtils.cpp
+++ b/physx/source/physxextensions/src/serialization/SnSerialUtils.cpp
@@ -39,6 +39,6 @@
 {

-#define SN_NUM_BINARY_PLATFORMS 9
+#define SN_NUM_BINARY_PLATFORMS 10
 const PxU32 sBinaryPlatformTags[SN_NUM_BINARY_PLATFORMS] =
 {
 	PX_MAKE_FOURCC('W','_','3','2'),
@@ -49,7 +49,8 @@
 	PX_MAKE_FOURCC('M','_','6','4'),
 	PX_MAKE_FOURCC('N','X','3','2'),
 	PX_MAKE_FOURCC('N','X','6','4'),
-	PX_MAKE_FOURCC('L','A','6','4')
+	PX_MAKE_FOURCC('L','A','6','4'),
+	PX_MAKE_FOURCC('L','R','6','4')
 };

 const char* sBinaryPlatformNames[SN_NUM_BINARY_PLATFORMS] =
@@ -62,7 +63,8 @@
 	"mac64",
 	"switch32",
 	"switch64",
-	"linuxaarch64"
+	"linuxaarch64",
+	"linuxriscv64"
 };

 }
@@ -88,7 +90,9 @@
 #elif PX_SWITCH && PX_A64
 	return sBinaryPlatformTags[7];
 #elif PX_LINUX && PX_A64
 	return sBinaryPlatformTags[8];
+#elif PX_LINUX && PX_RISCV64
+	return sBinaryPlatformTags[9];
 #else
 	#error Unknown binary platform
 #endif
--
