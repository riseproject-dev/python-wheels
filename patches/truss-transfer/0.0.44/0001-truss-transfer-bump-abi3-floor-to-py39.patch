From 47704a6f43bc0fb0f187c390764a939b356212e8 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 27 Sep 2026 22:37:59 +0000
Subject: [PATCH] truss-transfer: bump abi3 floor to py39

Upstream-Status: Inappropriate [manylinux_2_39_riscv64 ships no cp38 interpreter]

The riscv64 manylinux image's oldest available CPython is cp39 (no cp38),
so a wheel built here and tagged cp38-abi3 (this crate's abi3-py38
feature) would never actually be compiled or tested against its own
declared floor. Bump the pyo3 abi3 feature to abi3-py39 so the riscv64
wheel's tag matches the oldest interpreter it is built and tested on;
every other platform's wheel is unaffected.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 truss-transfer/Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/truss-transfer/Cargo.toml b/truss-transfer/Cargo.toml
index d75c3b4c..873755fe 100644
--- a/truss-transfer/Cargo.toml
+++ b/truss-transfer/Cargo.toml
@@ -13,7 +13,7 @@ async-trait = "0.1"
 chrono = { version = "0.4", features = ["serde"] }
 futures-util = "0.3"
 bytes = "1.5"
-pyo3 = { version = "0.24.1", features = ["extension-module", "abi3-py38"] }
+pyo3 = { version = "0.24.1", features = ["extension-module", "abi3-py39"] }
 pyo3-async-runtimes = { version = "0.24", features = ["tokio-runtime"] }
 numpy = "0.24"
 base64 = "0.22"
-- 
2.43.0

