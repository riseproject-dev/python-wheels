diff --git a/python/pyproject.toml b/python/pyproject.toml
index 6f45cad..dfb38cd 100644
--- a/python/pyproject.toml
+++ b/python/pyproject.toml
@@ -12,7 +12,22 @@ name = "tblite"
 version = "0.7.0"
 description = "Light-weight tight-binding framework"
 readme = "README.rst"
-license.text = "LGPL-3.0-or-later"
+license = "LGPL-3.0-or-later"
+license-files = [
+  "LICENSE.lapack",
+  "subprojects/tblite/COPYING",
+  "subprojects/tblite/COPYING.LESSER",
+  "subprojects/dftd4/COPYING",
+  "subprojects/dftd4/COPYING.LESSER",
+  "subprojects/s-dftd3/COPYING",
+  "subprojects/s-dftd3/COPYING.LESSER",
+  "subprojects/ddx/LICENSE.txt",
+  "subprojects/mctc-lib/LICENSE",
+  "subprojects/mstore/LICENSE",
+  "subprojects/multicharge/LICENSE",
+  "subprojects/jonquil/LICENSE-*",
+  "subprojects/toml-f/LICENSE-*",
+]
 urls.repository = "https://github.com/tblite/tblite"
 urls.documentation = "https://tblite.readthedocs.io"
 classifiers = [
