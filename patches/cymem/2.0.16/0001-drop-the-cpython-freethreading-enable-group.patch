From 2c2fc6c29f10672e6bbcbe624a042c6f82a72551 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 27 Aug 2026 12:36:37 +0200
Subject: [PATCH] drop the cpython-freethreading enable group

cibuildwheel removed the cpython-freethreading enable group: free-threaded
interpreters are selected by build identifier (cp314t-*) since 3.x, and 4.x
rejects the name outright with "Unknown enable group", so the build fails
before it starts.  This is the only entry in the list, so the option goes
with it.

Upstream-Status: To upstream [needs a cibuildwheel version bump upstream first; they still pin an older major]
---
 pyproject.toml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 179716e..4ef5c68 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -9,7 +9,6 @@ build-backend = "setuptools.build_meta"
 build = "*"
 skip = "cp38*"
 test-skip = ""
-enable = ["cpython-freethreading"]
 
 archs = ["native"]
 
