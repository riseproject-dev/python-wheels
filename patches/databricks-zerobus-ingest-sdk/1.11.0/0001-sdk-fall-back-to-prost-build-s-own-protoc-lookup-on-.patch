From 7a5f70e349dd5579c18b0c11caf9f3521d66a653 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 4 Nov 2026 18:37:11 +0000
Subject: [PATCH] sdk: fall back to prost-build's own protoc lookup on riscv64

Upstream-Status: Inappropriate [protoc-bin-vendored ships no riscv64 binary; prost-build already honours $PROTOC and falls back to protoc on PATH, so only overriding PROTOC when the vendored lookup succeeds is the whole fix]

protoc_bin_vendored::protoc_bin_path() returns Err on any platform outside
its small enum of prebuilt targets (x86, x86_64, aarch64, ppc64le, s390x,
macOS, Windows), and build.rs unwrap()ed it, panicking before prost-build
ever got a chance to look for a protoc on PATH or via $PROTOC. Only
setting PROTOC when the vendored lookup succeeds restores that fallback,
documented in prost-build's "Sourcing protoc" section.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 rust/sdk/build.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/rust/sdk/build.rs b/rust/sdk/build.rs
index e659578..cc907a7 100644
--- a/rust/sdk/build.rs
+++ b/rust/sdk/build.rs
@@ -5,7 +5,11 @@ use std::env;
 mod zeroparser_proto_build;
 
 fn main() {
-    env::set_var("PROTOC", protoc_bin_vendored::protoc_bin_path().unwrap());
+    // protoc-bin-vendored ships no riscv64 binary; falling through leaves
+    // prost_build's own PROTOC-env/PATH lookup in charge.
+    if let Ok(protoc) = protoc_bin_vendored::protoc_bin_path() {
+        env::set_var("PROTOC", protoc);
+    }
     tonic_prost_build::configure()
         .build_server(false)
         .compile_protos(&["zerobus_service.proto"], &["."])
