From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 22 Oct 2026 12:00:00 +0200
Subject: [PATCH] ship the LICENSE and AUTHORS files in the wheel's dist-info

Since 1.21.0 the build backend is meson-python, which only copies the files
named in `license-files` and has no implicit LICEN[CS]E*/AUTHORS* fallback
(setuptools, used up to 1.20.0, did). With the legacy `license = { text = }`
table and no `license-files`, the wheel carries no LICENSE at all.

pyproject-metadata only accepts `license-files` next to an SPDX expression,
so `LGPL-3.0` (a deprecated identifier) becomes its replacement
`LGPL-3.0-only`, the same licence.

Upstream-Status: To upstream [not yet submitted; no fork of seung-lab/fastremap to push from]
---
diff --git a/pyproject.toml b/pyproject.toml
index 38983ff..e748e79 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -13,7 +13,8 @@ dynamic = ["version"]
 description = 'Remap, mask, renumber, unique, and in-place transposition of 3D labeled images. Point cloud too.'
 readme = { file = 'README.md', content-type = 'text/markdown' }
 requires-python = '>=3.9,<4.0'
-license = { text = 'LGPL-3.0' }
+license = 'LGPL-3.0-only'
+license-files = ['LICENSE', 'AUTHORS']
 authors = [
   { name = 'William Silversmith', email = 'ws9@princeton.edu' },
 ]
