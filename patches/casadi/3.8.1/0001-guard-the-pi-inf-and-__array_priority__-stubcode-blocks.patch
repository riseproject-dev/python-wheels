From b886614be1f7fe40418e6a094beb944a3ed9ebe5 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 16 Sep 2026 14:24:01 +0200
Subject: [PATCH] Guard the pi/inf and __array_priority__ %stubcode blocks with
 #ifdef SWIG_STUBS_ENABLED

Every other bare `%stubcode %{...%}` use site in this file is wrapped in
`#ifdef SWIG_STUBS_ENABLED` so vanilla SWIG (which has no %stubcode
directive - only CasADi's own patched SWIG fork does) skips it. These
two - the numpy pi/inf re-export stub and the __array_priority__ stub
added since 3.8.0 - were left unguarded, so vanilla SWIG hard-errors
with "Unknown directive '%stubcode'" while parsing swig/casadi.i and
the Python bindings fail to generate at all.

Upstream-Status: To upstream [not yet submitted; cannot open issues/PRs against casadi/casadi from this environment]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 swig/casadi.i | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/swig/casadi.i b/swig/casadi.i
index 84ebbaa..1a459e7 100644
--- a/swig/casadi.i
+++ b/swig/casadi.i
@@ -3812,9 +3812,11 @@ PyOS_setsig(SIGINT, SigIntHandler);
 %stub_unary_math(arcsinh)
 %stub_unary_math(arccosh)
 /* Re-exported from numpy at runtime (`from numpy import pi, inf`). */
+#ifdef SWIG_STUBS_ENABLED
 %stubcode %{pi: float
 inf: float
 %}
+#endif
 %stub_overload_func(arctan2, DM, x: _DM, y: _DM)
 %stub_overload_func(arctan2, SX, x: _SX, y: _SX)
 %stub_overload_func(arctan2, MX, x: _MX, y: _MX)
@@ -4154,8 +4156,10 @@ class NZproxy:
  * scalar-object boxing for symbolic.  Keeps scipy.linalg.solve(A,b)
  * etc. typing without forcing users to wrap calls in np.array().  */
 %stub_method(__array__, %arg(NDArray[arraydtype]), *args: Any, **kwargs: Any)
+#ifdef SWIG_STUBS_ENABLED
 %stubcode %{    __array_priority__: float
 %}
+#endif
 %stub_method(__array_ufunc__, Any, ufunc: Any, method: builtins.str, *inputs: Any, **kwargs: Any)
 %stub_method(__array_function__, Any, func: Any, types: Any, args: Any, kwargs: Any)
 %enddef
