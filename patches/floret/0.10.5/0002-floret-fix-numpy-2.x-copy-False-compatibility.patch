From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] floret: fix numpy 2.x `copy=False` compatibility

Upstream-Status: To upstream [not yet submitted; python-wheels does not open issues/PRs on third-party repos]

numpy 2.0 made `np.array(obj, copy=False)` raise `ValueError: Unable to
avoid copy while creating an array as requested` whenever a copy is
needed, which `_floret.predict`, `_Meter.scores` and
`_Meter.precision_recall_curve` hit on every call since they convert
Python lists. This is not riscv64-specific: it fails on any platform
with numpy >= 2.0, which is the only numpy our registry serves for
riscv64 and the only one available for cp313+. Switching to
`np.asarray`, numpy's documented migration fix, keeps numpy 1.x
behaviour and fixes numpy 2.x.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 python/floret_module/floret/floret.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/python/floret_module/floret/floret.py b/python/floret_module/floret/floret.py
index 6212ab6..9abcc22 100644
--- a/python/floret_module/floret/floret.py
+++ b/python/floret_module/floret/floret.py
@@ -40,7 +40,7 @@ class _Meter(object):
         else:
             y_scores, y_true = ([], ())
 
-        return np.array(y_scores, copy=False), np.array(y_true, copy=False)
+        return np.asarray(y_scores), np.asarray(y_true)
 
     def precision_recall_curve(self, label=None):
         """Return precision/recall curve"""
@@ -55,7 +55,7 @@ class _Meter(object):
         else:
             precision, recall = ([], ())
 
-        return np.array(precision, copy=False), np.array(recall, copy=False)
+        return np.asarray(precision), np.asarray(recall)
 
     def precision_at_recall(self, recall, label=None):
         """Return precision for a given recall"""
@@ -227,7 +227,7 @@ class _floret(object):
             else:
                 probs, labels = ([], ())
 
-            return labels, np.array(probs, copy=False)
+            return labels, np.asarray(probs)
 
     def get_input_matrix(self):
         """
