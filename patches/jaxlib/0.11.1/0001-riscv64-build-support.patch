index 0000000..6d04f0a
--- /dev/null
+++ b/third_party/py/rules_python_riscv64.patch
@@ -0,0 +1,21 @@
+# Patch for rules_python to define the linux_riscv64 pip target platforms.
+#
+# 1. python/private/pypi/extension.bzl:
+#    - default_platforms() only enumerates x86_64 and aarch64 for Linux, so a
+#      native riscv64 build gets no platform entry and every `@pypi//<pkg>` alias
+#      is missing a branch for the host. Adding riscv64 to the same loop reuses
+#      the existing wheel tag conventions (linux_riscv64, manylinux_*_riscv64).
+
+diff --git a/python/private/pypi/extension.bzl b/python/private/pypi/extension.bzl
+index 094cac7..bfe3bda 100644
+--- a/python/private/pypi/extension.bzl
++++ b/python/private/pypi/extension.bzl
+@@ -75,7 +75,7 @@ def default_platforms():
+     platforms = {}
+ 
+     # Linux platforms
+-    for cpu in ["x86_64", "aarch64"]:
++    for cpu in ["x86_64", "aarch64", "riscv64"]:
+         for freethreaded in ["", "_freethreaded"]:
+             platform_name = "linux_{}{}".format(cpu, freethreaded)
+             platforms[platform_name] = {
