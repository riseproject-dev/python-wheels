From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 00:00:00 +0000
Subject: [PATCH] python: ship the vendored licences in the wheel

The generated build/python/setup.py.in declares no license_files, and
python/MANIFEST.in never reaches outside python/, so every published
gtsam wheel (verified against the real 4.3.0 PyPI wheel) carries no
licence text at all: not GTSAM's own BSD-3 LICENSE/LICENSE.BSD, nor
that of the libraries compiled into the extension alongside it --
CCOLAMD/SuiteSparse_config (BSD-3), METIS (Apache-2.0), cephes (MIT),
Eigen (MPL2) and pybind11 (BSD-3), all vendored under gtsam/3rdparty
and wrap/pybind11 per the root LICENSE file's own enumeration.

Copy each one into the generated build/python directory next to
setup.py -- where bdist_wheel resolves license_files from -- right
after setup.py itself is configured, and list them there.

Upstream-Status: To upstream [not yet submitted; the same gap exists in every gtsam wheel on PyPI, so it needs raising with the borglab/gtsam maintainers]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 python/CMakeLists.txt | 14 ++++++++++++++
 python/setup.py.in     |  4 ++++
 2 files changed, 18 insertions(+)

diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
index 5f26028..4ca0354 100644
--- a/python/CMakeLists.txt
+++ b/python/CMakeLists.txt
@@ -14,6 +14,20 @@ configure_file(${PROJECT_PYTHON_SOURCE_DIR}/setup.py.in
 file(COPY ${PROJECT_PYTHON_SOURCE_DIR}/MANIFEST.in
      DESTINATION ${GTSAM_PYTHON_BUILD_DIRECTORY})

+# Licence files bundled into the wheel; see the license_files tuple in setup.py.in.
+file(COPY ${PROJECT_SOURCE_DIR}/LICENSE ${PROJECT_SOURCE_DIR}/LICENSE.BSD
+     DESTINATION ${GTSAM_PYTHON_BUILD_DIRECTORY})
+configure_file(${PROJECT_SOURCE_DIR}/gtsam/3rdparty/CCOLAMD/Doc/License.txt
+               ${GTSAM_PYTHON_BUILD_DIRECTORY}/LICENSE.CCOLAMD COPYONLY)
+configure_file(${PROJECT_SOURCE_DIR}/gtsam/3rdparty/metis/LICENSE.txt
+               ${GTSAM_PYTHON_BUILD_DIRECTORY}/LICENSE.metis COPYONLY)
+configure_file(${PROJECT_SOURCE_DIR}/gtsam/3rdparty/cephes/LICENSE.txt
+               ${GTSAM_PYTHON_BUILD_DIRECTORY}/LICENSE.cephes COPYONLY)
+configure_file(${PROJECT_SOURCE_DIR}/gtsam/3rdparty/Eigen/COPYING.MPL2
+               ${GTSAM_PYTHON_BUILD_DIRECTORY}/LICENSE.eigen-mpl2 COPYONLY)
+configure_file(${PROJECT_SOURCE_DIR}/wrap/pybind11/LICENSE
+               ${GTSAM_PYTHON_BUILD_DIRECTORY}/LICENSE.pybind11 COPYONLY)
+
 set(WRAP_BUILD_TYPE_POSTFIXES ${GTSAM_BUILD_TYPE_POSTFIXES})

 include(PybindWrap)
diff --git a/python/setup.py.in b/python/setup.py.in
index af3cd00..bd3dbff 100644
--- a/python/setup.py.in
+++ b/python/setup.py.in
@@ -35,6 +35,10 @@ setup(
     author='Frank Dellaert et. al.',
     author_email='frank.dellaert@gtsam.org',
     license='Simplified BSD license',
+    license_files=(
+        'LICENSE', 'LICENSE.BSD', 'LICENSE.CCOLAMD', 'LICENSE.metis',
+        'LICENSE.cephes', 'LICENSE.eigen-mpl2', 'LICENSE.pybind11',
+    ),
     keywords='slam sam robotics localization mapping optimization',
     long_description_content_type='text/markdown',
     long_description=readme_contents,
--
