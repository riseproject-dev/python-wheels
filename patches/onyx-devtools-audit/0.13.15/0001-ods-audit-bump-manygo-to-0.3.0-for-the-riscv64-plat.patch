From ee399b7e135cc4acc7d9bd7bbc61e824105a8ad4 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 22:36:04 +0000
Subject: [PATCH] ods-audit: bump manygo to 0.3.0 for the riscv64 platform tag

Upstream-Status: To upstream [not submitted yet: onyx's release-devtools.yml builds no riscv64 wheel, so the bump cannot be exercised by upstream's own release workflow; needs a maintainer discussion first]

hatch_build.py (shared with the ods project next door) asks manygo for
the wheel's platform tag from GOOS and GOARCH. manygo 0.2.0 only knows
amd64/arm64/386/arm/s390x/ppc64le/ppc64, so with GOARCH=riscv64
is_goarch() is false, no tag is set, and hatchling falls back to the
build host's own interpreter-specific tag (cp312-cp312-manylinux_*_x86_64
when cross-compiling from x86_64) for a wheel that holds a riscv64
binary. onyx-devtools (tools/ods) needed the identical bump; this
project pins manygo independently in its own pyproject.toml, so the fix
does not carry over automatically.

manygo 0.3.0 adds riscv64 (manylinux_2_27_riscv64) and loong64 with the
same is_goarch/get_platform_tag API. Every other platform this project
builds keeps its tag.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 tools/ods-audit/pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/ods-audit/pyproject.toml b/tools/ods-audit/pyproject.toml
index 8efffde..5cf053f 100644
--- a/tools/ods-audit/pyproject.toml
+++ b/tools/ods-audit/pyproject.toml
@@ -2,7 +2,7 @@
 # go-bin ships the Go toolchain that hatch_build.py compiles with. Bump it together
 # with the `go` directive in tools/ods/go.mod and tools/requirements/build-constraints.in;
 # cli/pyproject.toml pins the same version and shares those constraints.
-requires = ["hatchling==1.29.0", "go-bin==1.27.1", "manygo==0.2.0"]
+requires = ["hatchling==1.29.0", "go-bin==1.27.1", "manygo==0.3.0"]
 build-backend = "hatchling.build"
 
 [project]
-- 
2.43.0

