From bf9f5ac7762bb6103ea61b7848b91385fd58334c Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 6 Sep 2026 19:45:22 +0200
Subject: [PATCH] Widen license-files to cover the statically linked LAME
 licence

license-files = ["LICENSE"] is an explicit PEP 639 list, so it replaces
setuptools' default LICEN[CS]E* glob rather than adding to it. The Linux,
macOS and Windows wheels statically link libmp3lame, built from the LAME
release pinned in CMakeLists.txt (ExternalProject_Add), which is licensed
under the GNU Library General Public License version 2 whose section 6
requires the licence notice to travel with binary redistributions - but
the built wheel ships only lameenc's own LICENSE.

Widening the list to also match LICENSE.* lets a LICENSE.lame dropped at
the project root reach dist-info/licenses/ with no other packaging change.

Upstream-Status: To upstream [not yet submitted; the same gap exists in every lameenc wheel on PyPI, so this needs a maintainer discussion rather than a drive-by PR]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 3d295df..1ad06f1 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -11,7 +11,7 @@ authors = [
   {name = "Chris Staite", email = "chris@yourdreamnet.co.uk"},
 ]
 license = "LGPL-3.0-or-later"
-license-files = ["LICENSE"]
+license-files = ["LICENSE", "LICENSE.*"]
 classifiers = [
     "Topic :: Multimedia :: Sound/Audio :: Conversion",
     "Programming Language :: Python :: 3 :: Only",
-- 
