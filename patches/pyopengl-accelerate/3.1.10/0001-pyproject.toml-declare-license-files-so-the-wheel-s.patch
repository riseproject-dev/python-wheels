From 04425244b2c935e0e36f73e5b3aa57d41725d926 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 11 Sep 2026 10:07:02 +0200
Subject: [PATCH] pyproject.toml: declare license-files so the wheel ships
 license.txt

setuptools' PEP 639 default license-files glob only fires when
project.license is absent; the legacy [project.license] file = table
form suppresses it, and mixing that table form with an explicit
license-files key raises a setuptools.errors.InvalidConfigError
(license must be a plain string once license-files is set). Switch
to the SPDX string form and list license.txt explicitly, dropping the
now-redundant 'License :: OSI Approved :: BSD License' classifier
(setuptools rejects it alongside a license expression, PEP 639).
Verified against the real PyPI 3.1.10 wheel: it ships no dist-info
licenses/ file either, only the licence text folded into METADATA.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against mcfletch/pyopengl]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 accelerate/pyproject.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/accelerate/pyproject.toml b/accelerate/pyproject.toml
index ddc74ff..5c7d2b6 100644
--- a/accelerate/pyproject.toml
+++ b/accelerate/pyproject.toml
@@ -6,7 +6,8 @@ authors = [
     {name="Mike C. Fletcher",email="mcfletch@vrplumber.com"},
 ]
 readme = {file="README.md", content-type = "text/markdown"}
-license={file="license.txt"}
+license="BSD-3-Clause"
+license-files=["license.txt"]
 keywords = [
     "Graphics",
     "3D",
@@ -21,7 +22,6 @@ keywords = [
     "PyOpenGL",
 ]
 classifiers = [
-    "License :: OSI Approved :: BSD License",
     "Programming Language :: Python",
     "Programming Language :: Python :: 2",
     "Programming Language :: Python :: 3",
-- 
