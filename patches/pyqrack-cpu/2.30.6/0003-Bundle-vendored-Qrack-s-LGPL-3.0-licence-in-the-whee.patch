From 626d556167bd0ba599bfdd516ff3a4806ec972c1 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 19:47:30 +0000
Subject: [PATCH 3/3] Bundle vendored Qrack's LGPL-3.0 licence in the wheel

Upstream-Status: Inappropriate [licensing compliance for the wheels RISE distributes; upstream's own pyqrack-cpu wheel does not bundle this]

pyqrack-cpu's compiled payload *is* unitaryfund/qrack
(pyqrack/qrack_system/qrack_lib/libqrack_pinvoke.so), which is
licensed LGPL-3.0, not MIT -- distinct from the MIT-licensed Python
wrapper whose LICENSE already lands in the wheel's
dist-info/licenses/. Redistributing a compiled LGPL-3.0 library
without its licence text is a real compliance gap; the real PyPI
pyqrack-cpu 2.30.6 wheel confirms it exists upstream too
(dist-info/licenses/ holds only pyqrack's own MIT LICENSE).

Copies qrack/LICENSE.md, once build-deps has cloned it, next to the
shared library it covers; MANIFEST.in's existing
"include pyqrack/qrack_system/qrack_lib/*" plus
include_package_data=True already bundle anything placed there, so no
other packaging change is needed.
---
 setup.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/setup.py b/setup.py
index f692cc9..0adaa80 100644
--- a/setup.py
+++ b/setup.py
@@ -1,6 +1,7 @@
 # Adapted from https://github.com/Qiskit/qiskit-aer/blob/master/setup.py
 
 import os
+import shutil
 import sys
 import subprocess
 from setuptools import setup
@@ -21,6 +22,12 @@ class Build(build_py):
         if os.name != "nt":
             if subprocess.call(protoc_command) != 0:
                 sys.exit(-1)
+        qrack_license = os.path.join("qrack", "LICENSE.md")
+        if os.path.exists(qrack_license):
+            shutil.copy(
+                qrack_license,
+                os.path.join("pyqrack", "qrack_system", "qrack_lib", "QRACK-LICENSE.md"),
+            )
         super().run()
 
 
