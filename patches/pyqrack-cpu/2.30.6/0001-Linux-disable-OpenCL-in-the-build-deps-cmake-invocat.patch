From e7c787fb303fca4d061d0ad96c3b2be76a953b67 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 2 Nov 2026 19:47:06 +0000
Subject: [PATCH 1/3] Linux: disable OpenCL in the build-deps cmake invocation

Upstream-Status: Backport [https://github.com/vm6502q/pyqrack/blob/cpu-only/Makefile]

Matches upstream's own cpu-only branch exactly: that branch's Makefile
differs from main only by adding -DENABLE_OPENCL=OFF to both Linux
cmake invocations (x86_64/i386 and the generic non-x86 one), and
setup.py's `name=` field. That branch is what upstream itself builds
and publishes pyqrack-cpu from (same version, same vendored Qrack
commit).

On a CPU-only riscv64 runner there is no system OpenCL to find, so
cmake's find_package(OpenCL) in qrack's own cmake/OpenCL.cmake would
already fall back to ENABLE_OPENCL=OFF silently -- this makes that
explicit and matches upstream's own documented way to get there,
rather than relying on find_package failing.
---
 Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 51b2b58..9d1fe67 100644
--- a/Makefile
+++ b/Makefile
@@ -35,9 +35,9 @@ endif
 	mkdir -p qrack/build
 ifeq ($(UNAME_S),Linux)
 ifneq ($(filter $(UNAME_P),x86_64 i386),)
-	cd qrack/build; $(CMAKE_L) -DENABLE_RDRAND=OFF -DENABLE_DEVRAND=ON -DQBCAPPOW=10 ..; make qrack_pinvoke qrack_cl_precompile
+	cd qrack/build; $(CMAKE_L) -DENABLE_OPENCL=OFF -DENABLE_RDRAND=OFF -DENABLE_DEVRAND=ON -DQBCAPPOW=10 ..; make qrack_pinvoke qrack_cl_precompile
 else
-	cd qrack/build; $(CMAKE_L) -DENABLE_RDRAND=OFF -DENABLE_DEVRAND=ON -DENABLE_COMPLEX_X2=OFF -DENABLE_SSE3=OFF -DQBCAPPOW=10 ..; make qrack_pinvoke qrack_cl_precompile
+	cd qrack/build; $(CMAKE_L) -DENABLE_OPENCL=OFF -DENABLE_RDRAND=OFF -DENABLE_DEVRAND=ON -DENABLE_COMPLEX_X2=OFF -DENABLE_SSE3=OFF -DQBCAPPOW=10 ..; make qrack_pinvoke qrack_cl_precompile
 endif
 endif
 ifeq ($(UNAME_S),Darwin)
