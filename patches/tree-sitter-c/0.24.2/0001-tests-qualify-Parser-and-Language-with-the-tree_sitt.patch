From e1194bc6b2659ff4d7ec165794482094cdb0fda1 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 28 Aug 2026 00:05:14 +0200
Subject: [PATCH] tests: qualify Parser and Language with the tree_sitter
 module

test_can_load_grammar imports the tree_sitter module but then calls the
bare names Parser and Language, which are never bound. Every run raises
NameError, the except clause catches it, and the test fails with "Error
loading C grammar" whatever the grammar does.

The other tree-sitter grammar repositories spell the same test as
tree_sitter.Language(tree_sitter_<lang>.language()); qualifying both
names here keeps this file's intent of also constructing a Parser.

The python binding tests are not run by CI (test-python is commented out
in .github/workflows/ci.yml) and the pypi packaging workflow runs no
tests at all, so this has gone unnoticed since the file was added.

Upstream-Status: To upstream [not yet submitted to tree-sitter/tree-sitter-c]
Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 bindings/python/tests/test_binding.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bindings/python/tests/test_binding.py b/bindings/python/tests/test_binding.py
index 8603898..edc1cd9 100644
--- a/bindings/python/tests/test_binding.py
+++ b/bindings/python/tests/test_binding.py
@@ -6,6 +6,6 @@ import tree_sitter, tree_sitter_c
 class TestLanguage(TestCase):
     def test_can_load_grammar(self):
         try:
-            Parser(Language(tree_sitter_c.language()))
+            tree_sitter.Parser(tree_sitter.Language(tree_sitter_c.language()))
         except Exception:
             self.fail("Error loading C grammar")
