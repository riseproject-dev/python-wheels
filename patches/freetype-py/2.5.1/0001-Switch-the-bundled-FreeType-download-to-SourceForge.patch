From 95b4fd9751d5b98ce510392b6952115699c5fa96 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Sun, 6 Sep 2026 09:47:42 +0200
Subject: [PATCH] Switch the bundled FreeType download to SourceForge

mirrors.sarata.com (the default FREETYPE_HOST) returns a Cloudflare-fronted
HTTP 403 Forbidden to non-browser clients -- confirmed from two independent
networks, not a transient outage. SourceForge's direct download endpoint for
the same release serves byte-identical content (sha256 matches
FREETYPE_SHA256 unchanged).

The right fix is upstream (point FREETYPE_HOST at a mirror that doesn't
block automated clients), but this port's policy prohibits filing issues
or PRs on repos other than riseproject-dev/python-wheels.

Upstream-Status: To upstream [blocked by this port's no-external-PRs policy]
---
 setup-build-freetype.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/setup-build-freetype.py b/setup-build-freetype.py
index 9d2ee8c..ed55d1b 100644
--- a/setup-build-freetype.py
+++ b/setup-build-freetype.py
@@ -25,9 +25,9 @@ import platform
 # Needed for the GitHub Actions macOS CI runner, which appears to come without CAs.
 import certifi
 
-FREETYPE_HOST = "https://mirrors.sarata.com/non-gnu/freetype/"
+FREETYPE_HOST = "https://sourceforge.net/projects/freetype/files/freetype2/2.13.2/"
 FREETYPE_TARBALL = "freetype-2.13.2.tar.xz"
-FREETYPE_URL = FREETYPE_HOST + FREETYPE_TARBALL
+FREETYPE_URL = FREETYPE_HOST + FREETYPE_TARBALL + "/download"
 FREETYPE_SHA256 = "12991c4e55c506dd7f9b765933e62fd2be2e06d421505d7950a132e4f1bb484d"
 HARFBUZZ_HOST = "https://github.com/harfbuzz/harfbuzz/releases/download/8.3.0/"
 HARFBUZZ_TARBALL = "harfbuzz-8.3.0.tar.xz"
-- 
