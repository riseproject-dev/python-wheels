From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 28 Oct 2026 19:35:17 +0000
Subject: [PATCH] core: make NaN to int64 casts explicit for
 to_datetime/to_timedelta

Casting NaN to int64 is undefined behaviour in C and the result is
architecture dependent: INT64_MIN (iNaT) on x86, 0 on ARM and INT64_MAX
on riscv64. to_datetime(unit=...) and to_timedelta/to_datetime assembly
with float columns relied on the x86 result and, on riscv64, tried to
convert INT64_MAX seconds/hours before the NaN positions were masked,
raising OutOfBounds errors. Set the masked positions to iNaT explicitly.

Upstream-Status: To upstream [To send when we will add riscv64 support upstream]
Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 pandas/core/arrays/timedeltas.py | 3 +++
 pandas/core/tools/datetimes.py   | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/pandas/core/arrays/timedeltas.py b/pandas/core/arrays/timedeltas.py
index b24e372..56cb4d3 100644
--- a/pandas/core/arrays/timedeltas.py
+++ b/pandas/core/arrays/timedeltas.py
@@ -1312,6 +1312,9 @@ def sequence_to_td64ns(
             # (which results in 'us' unit instead of 'ns')
             with np.errstate(invalid="ignore"):
                 int_data = data.astype(np.int64)
+            # NaN -> int64 is undefined behaviour in C: x86 yields INT64_MIN (iNaT),
+            # ARM yields 0 and riscv64 yields INT64_MAX. Make it explicit.
+            int_data[mask] = iNaT
             # On ARM, float-to-int64 overflow saturates to INT64_MAX
             # instead of wrapping, which makes the data == int_data
             # check pass incorrectly for OOB values like float(2**63).
diff --git a/pandas/core/tools/datetimes.py b/pandas/core/tools/datetimes.py
index 1dc48d2..4412ff1 100644
--- a/pandas/core/tools/datetimes.py
+++ b/pandas/core/tools/datetimes.py
@@ -601,6 +601,9 @@ def _to_datetime_with_unit(
         mask = np.isnan(arg)
         with np.errstate(invalid="ignore"):
             int_values = arg.astype(np.int64)
+        # NaN -> int64 is undefined behaviour in C: x86 yields INT64_MIN (iNaT),
+        # ARM yields 0 and riscv64 yields INT64_MAX. Make it explicit.
+        int_values[mask] = iNaT
         # On ARM, float-to-int64 overflow saturates to INT64_MAX
         # instead of wrapping, which makes the arg == int_values
         # check pass incorrectly for OOB values like float(2**63).
-- 
