From 5b03b1fb4ae4bb70283570180ccf18fa15149d7d Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 14 Oct 2026 11:42:49 +0000
Subject: [PATCH] pyproject: ship the bundled pkgconf licence

The wheel ships the `pkgconf` executable built from the
subprojects/pkgconf submodule, which is under the ISC licence. ISC
requires its copyright and permission notice to appear in all copies,
but `license-files = ['LICENSE']` only lists the wrapper's own MIT
licence, and meson-python implements no default licence glob, so
upstream's published wheels carry no pkgconf notice at all.

List subprojects/pkgconf/COPYING as well; meson-python writes it to
dist-info/licenses/subprojects/pkgconf/COPYING.

Upstream-Status: To upstream [not submitted from this automated port run; needs a pull request against pypackaging-native/pkgconf-pypi]
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index c1784ee..7f0c679 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -15,7 +15,7 @@ version = '3.0.7-0'
 description = '`pkgconf` is a program which helps with discovering library dependencies and configuring compiler and linker flags.'
 readme = 'README.md'
 license = 'MIT'
-license-files = ['LICENSE']
+license-files = ['LICENSE', 'subprojects/pkgconf/COPYING']
 authors = [
   {name = 'Ralf Gommers', email = 'ralf.gommers@gmail.com'},
   {name = 'Filipe Laíns', email = 'lains@riseup.net'}
-- 
2.43.0

