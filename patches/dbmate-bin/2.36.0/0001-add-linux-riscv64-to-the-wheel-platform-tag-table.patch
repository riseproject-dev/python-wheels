From b52e4bc6dd2ddf96df3d14eda8703b63561776aa Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 13 Oct 2026 22:30:06 +0000
Subject: [PATCH] add linux/riscv64 to the wheel platform-tag table

Upstream-Status: Inappropriate [amacneil/dbmate publishes no linux-riscv64 release binary for pybin to repackage; python-wheels builds it from source and feeds it to WheelPacker directly]

pybin's Architecture enum and WheelPacker tag table only know
x86_64/arm64, so a riscv64 Binary raises "Unsupported wheel target".
Add Architecture.RISCV64, a LINUX_RISCV64 platform tag, its
WheelPacker mapping, and "riscv64" detection in the GitHub release
puller's target parser. The tag is manylinux_2_39_riscv64 (no
musllinux half): the riscv64 binary is dynamically linked against the
build host's glibc 2.39 rather than statically linked like upstream's
x86_64/aarch64 release assets. Existing targets resolve unchanged.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 src/pybin/format/wheel.py    | 2 ++
 src/pybin/platform_tags.py   | 1 +
 src/pybin/registry/github.py | 2 ++
 src/pybin/types.py           | 1 +
 4 files changed, 6 insertions(+)

diff --git a/src/pybin/format/wheel.py b/src/pybin/format/wheel.py
index 0385838..adec5de 100644
--- a/src/pybin/format/wheel.py
+++ b/src/pybin/format/wheel.py
@@ -9,6 +9,7 @@ from wheel.wheelfile import WheelFile
 
 from pybin.platform_tags import (
     LINUX_ARM,
+    LINUX_RISCV64,
     LINUX_X86,
     MACOS_ARM,
     MACOS_X86,
@@ -38,6 +39,7 @@ class WheelPacker:
         _BINARY_TARGET_TO_WHEEL_TAG: dict[tuple[Platform, Architecture], str] = {
             (Platform.LINUX, Architecture.X86_64): LINUX_X86,
             (Platform.LINUX, Architecture.ARM64): LINUX_ARM,
+            (Platform.LINUX, Architecture.RISCV64): LINUX_RISCV64,
             (Platform.MACOS, Architecture.X86_64): MACOS_X86,
             (Platform.MACOS, Architecture.ARM64): MACOS_ARM,
             (Platform.WINDOWS, Architecture.X86_64): WIN_X86,
diff --git a/src/pybin/platform_tags.py b/src/pybin/platform_tags.py
index 2e5d88f..4a55bd4 100644
--- a/src/pybin/platform_tags.py
+++ b/src/pybin/platform_tags.py
@@ -16,6 +16,7 @@ For mac: We use relatively old macos versions and have architecture-specific ver
 
 LINUX_X86 = "manylinux2014_x86_64.musllinux_1_1_x86_64"
 LINUX_ARM = "manylinux2014_aarch64.musllinux_1_1_aarch64"
+LINUX_RISCV64 = "manylinux_2_39_riscv64"
 
 MACOS_X86 = "macosx_10_9_x86_64"
 MACOS_ARM = "macosx_11_0_arm64"  # Big Sur first version to support apple silicon
diff --git a/src/pybin/registry/github.py b/src/pybin/registry/github.py
index 4773858..9fd14c0 100644
--- a/src/pybin/registry/github.py
+++ b/src/pybin/registry/github.py
@@ -33,6 +33,8 @@ def _target_architecture(target: str) -> Architecture:
         return Architecture.ARM64
     elif "x86_64" in normalized or "amd64" in normalized:
         return Architecture.X86_64
+    elif "riscv64" in normalized:
+        return Architecture.RISCV64
     else:
         raise ValueError(f"Could not determine architecture from target: {target}")
 
diff --git a/src/pybin/types.py b/src/pybin/types.py
index 50ea853..25eb390 100644
--- a/src/pybin/types.py
+++ b/src/pybin/types.py
@@ -6,6 +6,7 @@ from typing import Protocol
 class Architecture(str, Enum):
     X86_64 = "x86_64"
     ARM64 = "arm64"
+    RISCV64 = "riscv64"
 
 
 class Platform(str, Enum):
