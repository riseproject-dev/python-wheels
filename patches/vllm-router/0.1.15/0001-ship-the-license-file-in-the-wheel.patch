Upstream-Status: Inappropriate [twine#1216's workaround does not apply to our publish pipeline, which never runs twine, and it costs us the wheel's licence file]

`[tool.setuptools] license-files = []` disables setuptools' default LICENSE* glob, so every
upstream wheel (and ours, unpatched) ships no licence text at all. Our publish pipeline does
not use twine, so the workaround upstream added for pypa/twine#1216 does not apply here and
only costs us the licence file. Dropping the override restores the default
`license-files = ["LICEN[CS]E*"]` glob, which picks up the repository's root `LICENSE`.

--- pyproject.toml
+++ pyproject.toml
@@ -40,10 +40,6 @@ vllm-router = "vllm_router.launch_router:main"
 [tool.setuptools.packages]
 find = { where = ["py_src"] }
 
-# workaround for https://github.com/pypa/twine/issues/1216
-[tool.setuptools]
-license-files = []
-
 [tool.distutils.bdist_wheel]
 py_limited_api = "cp38"
 
