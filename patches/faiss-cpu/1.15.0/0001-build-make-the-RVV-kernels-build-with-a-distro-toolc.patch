From 5d56ba18506d4e1ed92330fcd368902c67bbb884 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 27 Aug 2026 07:16:00 +0200
Subject: [PATCH 1/2] build: make the RVV kernels build with a distro toolchain

Upstream-Status: To upstream [not yet submitted; needs a maintainer decision on the intended riscv64 toolchain baseline, so it is not a drive-by PR]

Two things stop the FAISS_SIMD_RVV_SRC files from producing a shared
library with GCC 14.3.1 / binutils 2.41, the toolchain in the riscv64
manylinux image (manylinux_2_39_riscv64, Rocky Linux 10).

They are compiled with -march=rv64gcv_zvfhmin.  zvfhmin only reached
binutils in 2.42, and an older assembler rejects the whole -march string
rather than just that extension, so every RVV translation unit fails with
"unknown prefixed ISA extension `zvfhmin'".  None of the seven files uses
float16 vectors, so zvfhmin buys nothing today and all seven compile
unchanged with plain rv64gcv.  Probe for the flag and fall back.

FAISS_USE_LTO is also ON for Linux, and with -flto those objects hold
GIMPLE rather than code, so lto1 regenerates them at link time from the
*link* command line, which carries no vector extension:

    lto1: fatal error: target specific builtin not available
    lto-wrapper: fatal error: /usr/bin/g++ returned 1 exit status

GCC has no per-function target attribute for RISC-V vector, so the flags
cannot be carried into the LTO recompilation.  Compile just those seven
files with -fno-lto; every other translation unit still takes part.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 faiss/CMakeLists.txt | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/faiss/CMakeLists.txt b/faiss/CMakeLists.txt
index 1a4a30a..6deb907 100644
--- a/faiss/CMakeLists.txt
+++ b/faiss/CMakeLists.txt
@@ -87,6 +87,23 @@ elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(riscv64|riscv)")
 else()
   set(FAISS_SIMD_SRC "")
 endif()
+
+# zvfhmin is only recognised by binutils >= 2.42. Older assemblers reject the
+# whole -march string, and no RVV source here uses float16 vectors, so probe
+# for it and fall back to plain rv64gcv.
+# The RVV kernels must be excluded from LTO: lto1 recompiles them from GIMPLE
+# using the link command's target options, which do not include the vector
+# extension, and fails with "target specific builtin not available".
+set(FAISS_RVV_ARCH_FLAGS "-march=rv64gcv_zvfhmin;-mabi=lp64d;-fno-lto")
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "(riscv64|riscv)")
+  include(CheckCXXSourceCompiles)
+  set(CMAKE_REQUIRED_FLAGS "-march=rv64gcv_zvfhmin -mabi=lp64d")
+  check_cxx_source_compiles("int main() { return 0; }" FAISS_HAVE_RVV_ZVFHMIN)
+  unset(CMAKE_REQUIRED_FLAGS)
+  if(NOT FAISS_HAVE_RVV_ZVFHMIN)
+    set(FAISS_RVV_ARCH_FLAGS "-march=rv64gcv;-mabi=lp64d;-fno-lto")
+  endif()
+endif()
 # =============================================================================
 
 set(FAISS_SRC
@@ -595,7 +612,7 @@ if(FAISS_OPT_LEVEL STREQUAL "dd")
     if(FAISS_SIMD_RVV_SRC)
       set_source_files_properties(${FAISS_SIMD_RVV_SRC}
         TARGET_DIRECTORY faiss
-        PROPERTIES COMPILE_OPTIONS "-march=rv64gcv_zvfhmin;-mabi=lp64d"
+        PROPERTIES COMPILE_OPTIONS "${FAISS_RVV_ARCH_FLAGS}"
       )
     endif()
   endif()
@@ -624,7 +641,7 @@ if(CMAKE_SYSTEM_PROCESSOR MATCHES "(riscv64|riscv)" AND NOT FAISS_OPT_LEVEL STRE
   if(NOT WIN32 AND FAISS_SIMD_RVV_SRC)
     set_source_files_properties(${FAISS_SIMD_RVV_SRC}
       TARGET_DIRECTORY faiss
-      PROPERTIES COMPILE_OPTIONS "-march=rv64gcv_zvfhmin;-mabi=lp64d"
+      PROPERTIES COMPILE_OPTIONS "${FAISS_RVV_ARCH_FLAGS}"
     )
   endif()
 endif()
