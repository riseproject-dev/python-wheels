From a9b8430af432adb1c66347969b0c284c8f3b8d86 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 27 Aug 2026 06:31:38 +0200
Subject: [PATCH 1/2] build: fall back to -march=rv64gcv when the assembler
 lacks zvfhmin

Upstream-Status: To upstream [not yet submitted; needs a maintainer decision on whether the RVV kernels are meant to require a zvfhmin-capable toolchain, so it is not a drive-by PR]

The RVV sources are compiled with -march=rv64gcv_zvfhmin.  zvfhmin is only
recognised by binutils >= 2.42, and an older assembler rejects the whole
-march string rather than just that extension, so every RVV translation
unit fails with "unknown prefixed ISA extension `zvfhmin'".  The riscv64
manylinux image (manylinux_2_39_riscv64, Rocky Linux 10) ships binutils
2.41, which makes the wheel build impossible there.

None of the seven files in FAISS_SIMD_RVV_SRC uses float16 vectors, so
zvfhmin buys nothing today: all seven compile unchanged with plain
rv64gcv.  Probe for the flag and fall back when it is unavailable.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 faiss/CMakeLists.txt | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/faiss/CMakeLists.txt b/faiss/CMakeLists.txt
index 1a4a30a..4436805 100644
--- a/faiss/CMakeLists.txt
+++ b/faiss/CMakeLists.txt
@@ -87,6 +87,20 @@ elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(riscv64|riscv)")
 else()
   set(FAISS_SIMD_SRC "")
 endif()
+
+# zvfhmin is only recognised by binutils >= 2.42. Older assemblers reject the
+# whole -march string, and no RVV source here uses float16 vectors, so probe
+# for it and fall back to plain rv64gcv.
+set(FAISS_RVV_ARCH_FLAGS "-march=rv64gcv_zvfhmin;-mabi=lp64d")
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "(riscv64|riscv)")
+  include(CheckCXXSourceCompiles)
+  set(CMAKE_REQUIRED_FLAGS "-march=rv64gcv_zvfhmin -mabi=lp64d")
+  check_cxx_source_compiles("int main() { return 0; }" FAISS_HAVE_RVV_ZVFHMIN)
+  unset(CMAKE_REQUIRED_FLAGS)
+  if(NOT FAISS_HAVE_RVV_ZVFHMIN)
+    set(FAISS_RVV_ARCH_FLAGS "-march=rv64gcv;-mabi=lp64d")
+  endif()
+endif()
 # =============================================================================
 
 set(FAISS_SRC
@@ -595,7 +609,7 @@ if(FAISS_OPT_LEVEL STREQUAL "dd")
     if(FAISS_SIMD_RVV_SRC)
       set_source_files_properties(${FAISS_SIMD_RVV_SRC}
         TARGET_DIRECTORY faiss
-        PROPERTIES COMPILE_OPTIONS "-march=rv64gcv_zvfhmin;-mabi=lp64d"
+        PROPERTIES COMPILE_OPTIONS "${FAISS_RVV_ARCH_FLAGS}"
       )
     endif()
   endif()
@@ -624,7 +638,7 @@ if(CMAKE_SYSTEM_PROCESSOR MATCHES "(riscv64|riscv)" AND NOT FAISS_OPT_LEVEL STRE
   if(NOT WIN32 AND FAISS_SIMD_RVV_SRC)
     set_source_files_properties(${FAISS_SIMD_RVV_SRC}
       TARGET_DIRECTORY faiss
-      PROPERTIES COMPILE_OPTIONS "-march=rv64gcv_zvfhmin;-mabi=lp64d"
+      PROPERTIES COMPILE_OPTIONS "${FAISS_RVV_ARCH_FLAGS}"
     )
   endif()
 endif()
