               'gluecard30', 'gluecard41', 'glucose30', 'glucose41',
-              'glucose421', 'kissat404', 'lingeling', 'maplechrono',
+              'glucose421', 'kissat404', 'maplechrono',
               'maplecm', 'maplesat', 'mergesat3', 'minicard', 'minisat22',
               'minisatgh', 'minisatep']
 
