From 82939f0ed04aa9aa77ff386203439f9127d83d13 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 14 Oct 2026 14:27:48 +0000
Subject: [PATCH] release_workflow: ship LICENSE in every wheel's dist-info

Upstream-Status: To upstream [not yet submitted; python-wheels does not open issues/PRs on third-party repos]

build_wheel() hand-assembles each wheel from staged binaries and writes
only METADATA, WHEEL and RECORD into dist-info, so the published wheels
carry no copy of the AGPL-3.0 licence text even though they redistribute
compiled binaries. Copy the repository LICENSE to
dist-info/licenses/LICENSE (the PEP 639 location) and record it in
RECORD.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 ci/release_workflow.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/ci/release_workflow.py b/ci/release_workflow.py
index 6a23ce8..104756a 100644
--- a/ci/release_workflow.py
+++ b/ci/release_workflow.py
@@ -368,6 +368,12 @@ def build_wheel(
                 whl.writestr(rel, data)
                 record_rows.append((rel, record_hash(data), len(data)))
 
+        license_bytes = (ROOT / "LICENSE").read_bytes()
+        whl.writestr(f"{dist_info}/licenses/LICENSE", license_bytes)
+        record_rows.append(
+            (f"{dist_info}/licenses/LICENSE", record_hash(license_bytes), len(license_bytes))
+        )
+
         metadata_bytes = metadata.encode()
         whl.writestr(f"{dist_info}/METADATA", metadata_bytes)
         record_rows.append(
-- 
2.43.0

