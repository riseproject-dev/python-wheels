From 813a874854534eb6bbb9be60184312215ccf66bd Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 14 Oct 2026 14:27:20 +0000
Subject: [PATCH] protocol: fall back to prost-build's own protoc lookup on
 riscv64

Upstream-Status: Inappropriate [protoc-bin-vendored ships no riscv64 binary; prost_build already defaults to its own PROTOC-env/PATH lookup, so not overriding it on unsupported platforms is the whole fix]

protoc_bin_vendored::protoc_bin_path() returns Err on any host outside
its small set of prebuilt targets (x86, x86_64, aarch64, ppc64le, s390x,
macOS, Windows), and build.rs turned that into a panic before
prost_build ever got a chance to look for a protoc on PATH or via
$PROTOC. Only exporting PROTOC when the vendored lookup succeeds
restores that fallback, which prost-build documents in its "Sourcing
protoc" section.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 crates/zccache-protocol/build.rs | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/crates/zccache-protocol/build.rs b/crates/zccache-protocol/build.rs
index 7179f40..aba99f4 100644
--- a/crates/zccache-protocol/build.rs
+++ b/crates/zccache-protocol/build.rs
@@ -7,9 +7,11 @@ fn main() {
     println!("cargo:rerun-if-changed=build.rs");
     println!("cargo:rerun-if-changed=proto/zccache_v1.proto");
 
-    let protoc = protoc_bin_vendored::protoc_bin_path()
-        .expect("vendored protoc is available for zccache wire protobufs");
-    std::env::set_var("PROTOC", protoc);
+    // protoc-bin-vendored ships no riscv64 binary; falling through leaves
+    // prost_build's own PROTOC-env/PATH lookup in charge there.
+    if let Ok(protoc) = protoc_bin_vendored::protoc_bin_path() {
+        std::env::set_var("PROTOC", protoc);
+    }
 
     prost_build::Config::new()
         .compile_protos(&["proto/zccache_v1.proto"], &["proto"])
