From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 16 Oct 2026 00:36:27 +0000
Subject: [PATCH] cmake: recreate the nested TBB cmake dir OpenVINOConfig.cmake
 expects

OpenVINOConfig.cmake's _ov_find_tbb() unconditionally looks for the bundled
TBB CMake package at <openvino>/cmake/lib/cmake/TBB via
set_and_check(_tbb_dir ...), which aborts configure with a FATAL_ERROR if
the path is missing. The openvino pip wheel's own packaging, however, drops
TBBConfig.cmake/TBBConfigVersion.cmake/TBBTargets*.cmake flat into
<openvino>/cmake/ with no such nesting -- true of every platform's wheel,
not just riscv64 (checked both the manylinux_riscv64 and the manylinux
x86_64 PyPI wheels for 2026.3.1).

Upstream's own CI never hits this because it always finds
OpenVINODeveloperPackage first (generated directly from a full source
build of openvino as part of the same workflow, with a correctly-pathed
TBB config matching the real filesystem layout) and only falls back to the
plain OpenVINO package's exported CMake config, which carries this gap,
when the developer package isn't available. OpenVINODeveloperPackage isn't
published for riscv64, so this is exactly the path our riscv64 build must
take, which is where the gap surfaces as:

  CMake Error at .../openvino/cmake/OpenVINOConfig.cmake:119 (message):
    File or directory
    .../openvino/cmake/lib/cmake/TBB
    referenced by variable _tbb_dir does not exist !

Recreate the nested directory OpenVINOConfig.cmake expects, from the files
openvino's wheel actually ships, right after locating the pip-installed
openvino package and before requesting COMPONENTS ... Threading.

Upstream-Status: Inappropriate [only reachable via the plain OpenVINO pip wheel's cmake config, which upstream's own CI never builds against]
---
 CMakeLists.txt | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c722713..5fb2b45 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -76,6 +76,28 @@ if(BUILD_CPP_EXTENSION)
 
     # Find OpenVINODeveloperPackage first to compile with SDL flags
     set(OV_COMPATIBILITY_VERSION ${openvino_tokenizers_VERSION_MAJOR}.${openvino_tokenizers_VERSION_MINOR}.${openvino_tokenizers_VERSION_PATCH})
+
+    # OpenVINOConfig.cmake's _ov_find_tbb() unconditionally looks for the bundled TBB
+    # CMake package at <openvino>/cmake/lib/cmake/TBB (set_and_check(_tbb_dir ...)), but
+    # the openvino pip wheel's own packaging drops TBBConfig.cmake flat into
+    # <openvino>/cmake/ with no such nesting - true of every platform's wheel, not just
+    # riscv64 (checked both the manylinux_riscv64 and manylinux x86_64 PyPI wheels).
+    # Upstream's own CI never hits this because it builds against
+    # OpenVINODeveloperPackage, generated from a full source build; that package isn't
+    # published for riscv64, so this build falls back to the plain wheel's exported
+    # config below, where the gap surfaces. Recreate the nested directory
+    # OpenVINOConfig.cmake expects before requesting COMPONENTS ... Threading.
+    if(OpenVINO_DIR_PY AND EXISTS "${OpenVINO_DIR_PY}/TBBConfig.cmake")
+        set(_ov_tbb_nested_dir "${OpenVINO_DIR_PY}/lib/cmake/TBB")
+        if(NOT EXISTS "${_ov_tbb_nested_dir}")
+            file(MAKE_DIRECTORY "${_ov_tbb_nested_dir}")
+            file(GLOB _ov_tbb_cmake_files "${OpenVINO_DIR_PY}/TBB*.cmake")
+            file(COPY ${_ov_tbb_cmake_files} DESTINATION "${_ov_tbb_nested_dir}")
+            unset(_ov_tbb_cmake_files)
+        endif()
+        unset(_ov_tbb_nested_dir)
+    endif()
+
     find_package(OpenVINODeveloperPackage ${OV_COMPATIBILITY_VERSION} QUIET
                  COMPONENTS Runtime Threading
                  PATHS "${OpenVINO_DIR}")
