From 1e8c336f6eae0357911b4e4100cc3dd5be1af51d Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 18 Sep 2026 17:05:57 +0000
Subject: [PATCH] Add LICENSE.minuit2 to pyproject.toml license-files

iminuit 2.33.0 switched pyproject.toml from the legacy
license = { text = "MIT+LGPL" } (no explicit license-files key) to a PEP
639 SPDX license expression with an explicit license-files = ["LICENSE"]
list. scikit-build-core only falls back to its default LICEN[CS]E* glob
when [project] omits license-files entirely (CLAUDE.md gotcha 105); once
the key is present, it is the complete list, so this port's own
LICENSE.minuit2 (added by the previous patch for the vendored MINUIT2/LGPL
sources) is silently dropped from the wheel even though the file exists
in the sdist. The CIBW_TEST_COMMAND license assertion then fails
identically on every interpreter (cp312/cp313/cp314/cp314t), since none
of them ever run before the wheel is built. Extending the explicit list
is the only fix available for a PEP 621 backend (gotcha 105).

Upstream-Status: To upstream [not yet submitted; this port may only touch riseproject-dev/python-wheels]
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 6058ac5..9adf9f7 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -10,7 +10,7 @@ maintainers = [{ name = "Hans Dembinski", email = "hans.dembinski@gmail.com" }]
 readme = "README.rst"
 requires-python = ">=3.9"
 license = "MIT AND LGPL-2.1-or-later"
-license-files = ["LICENSE"]
+license-files = ["LICENSE", "LICENSE.minuit2"]
 classifiers = [
     "Development Status :: 5 - Production/Stable",
     "Intended Audience :: Science/Research",
-- 
2.43.0

