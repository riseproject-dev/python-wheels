From 09922766db933f4efa367c2fff5e63d52dad16a5 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 11 Sep 2026 12:33:41 +0200
Subject: [PATCH] Drop enable = ["cpython-freethreading"] from pyproject.toml

cibuildwheel 4.2.0 (the version this repo pins) removed the cpython-freethreading
enable group outright rather than renaming it -- free-threaded (cp3XXt) wheels
build without an enable flag at all in this version. iminuit's [tool.cibuildwheel]
table still carries the token (confirmed unchanged on the scikit-hep/iminuit main
branch too, so upstream has not caught up to the newer cibuildwheel yet), and
because cibuildwheel parses the whole table up front, this is a hard parse error
-- "Failed to parse enable group. Unknown enable group: cpython-freethreading" --
before any container starts, for every interpreter in the CIBW_BUILD matrix, not
just cp313t/cp314t.

Upstream-Status: To upstream [not yet fixed on scikit-hep/iminuit main as of this port; this port may only touch riseproject-dev/python-wheels]
---
 pyproject.toml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 0caed38..d506fba 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -132,7 +132,6 @@ build-frontend = "build[uv]"
 skip = ["cp39-musllinux_i686"]                    # no numpy wheel
 test-requires = "pytest"
 test-command = "python -m pytest {package}/tests"
-enable = ["cpython-freethreading"]
 
 [tool.cibuildwheel.environment]
 # this makes sure that we build only on platforms that have a corresponding numpy wheel
-- 
