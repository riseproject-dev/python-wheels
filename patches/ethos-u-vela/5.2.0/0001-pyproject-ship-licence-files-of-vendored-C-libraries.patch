From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Wed, 30 Sep 2026 12:00:00 +0200
Subject: [PATCH] pyproject: ship licence files of vendored C++ libraries

The regor extension module compiles in the vendored FlatBuffers, fmt,
gemmlowp and pybind11 headers from ethosu/regor/dependencies/thirdparty
(see THIRDPARTY.md), but the wheel only carries Vela's own LICENSE.txt.
Their Apache-2.0, MIT and BSD-3-Clause terms require the notices to
travel with the binary, so list them in license-files. Catch2 is only
linked into the C++ unit tests and is left out.

Upstream-Status: To upstream [opening a merge request on gitlab.arm.com needs an Arm GitLab account]
---
 pyproject.toml | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -20,7 +20,13 @@
 requires-python = ">=3.10"
 authors = [{name = "Arm Ltd", email = "mlg-vela@arm.com"}]
 license = "Apache-2.0"
-license-files = ["LICENSE.txt"]
+license-files = [
+    "LICENSE.txt",
+    "ethosu/regor/dependencies/thirdparty/flatbuffers/LICENSE",
+    "ethosu/regor/dependencies/thirdparty/fmt/LICENSE",
+    "ethosu/regor/dependencies/thirdparty/gemmlowp/LICENSE",
+    "ethosu/regor/dependencies/thirdparty/pybind11/LICENSE",
+]
 classifiers = [
     "Development Status :: 5 - Production/Stable",
     "Intended Audience :: Developers",
--
2.43.0

