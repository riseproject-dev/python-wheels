From 261b0881ef4a588e976731b6efeffd9de85b6ba8 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 20:51:47 +0000
Subject: [PATCH] Add license-files for vendored fmt/nlohmann_json licences

setuptools>=77 (PEP 639) auto-discovers license files at the project
root via the LICEN[CS]E*/COPYING*/NOTICE*/AUTHORS* glob when
[project] omits an explicit license-files key, which is why
LICENSE_GPLv3.txt alone already lands in the wheel. The extension
statically compiles in two vendored dependencies with their own
permissive licences, vendor/fmt/LICENSE (MIT) and
vendor/nlohmann_json/LICENSE.MIT (MIT), which the root-only glob
never reaches. Declaring an explicit license-files list is the only
way to add nested paths (same shape as CLAUDE.md gotcha 105): it
must also keep the root GPL licence since an explicit list replaces
the glob instead of extending it.

Upstream-Status: To upstream [not yet submitted; this port may only touch riseproject-dev/python-wheels]
---
 pyproject.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/pyproject.toml b/pyproject.toml
index 6d542c0..cd2f4cd 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -11,6 +11,7 @@ dynamic = ["version"]
 description = "Infomap network clustering algorithm"
 readme = { file = "README.rst", content-type = "text/x-rst" }
 license = "GPL-3.0-or-later"
+license-files = ["LICENSE_GPLv3.txt", "vendor/fmt/LICENSE", "vendor/nlohmann_json/LICENSE.MIT"]
 authors = [
   { name = "mapequation", email = "mapequation@gmail.com" },
 ]
-- 
