From 0546637a443b2458cacaf965c5598289fb74420e Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 16 Nov 2026 20:15:00 +0000
Subject: [PATCH] drop the passagemath-conf repair step from the repair-wheel
 command

Upstream-Status: Inappropriate [avoids an unverified build-time passagemath-conf/SAGE_LOCAL dependency inside a cibuildwheel container; see .queue.yml's passagemath-buckygen/-benzene/-plantri entries]

repair_wheel.py (shipped in the sdist and wired as the first step of
[tool.cibuildwheel.linux]/[macos] repair-wheel-command) does `from
sage.config import SAGE_LOCAL` and tars SAGE_LOCAL/share/graphs into the
wheel, which only works if passagemath-conf has already been pip
installed and configured against a populated Sage root containing the
built 'graphs' data spkg (build/pkgs/graphs' own
sdh_install src/* "$SAGE_SHARE"/graphs step) - a build-time mechanism no
build-passagemath-*.yml in this repo has ever exercised (see the
buckygen/benzene/plantri/kissat/glucose .queue.yml entries, parked for
exactly this reason). Rather than making this large, central package the
first to require it sight-unseen, this drops the repair_wheel.py step and
keeps the plain auditwheel/delocate repair that every other
passagemath-* port in this repo already uses. The published PyPI wheel
already carries a runtime Requires-Dist on passagemath-conf for
non-Windows platforms regardless of whether repair_wheel.py ran (it
strips that line from METADATA on success, but the dependency is declared
by a separate metadata macro this patch does not touch), so this wheel's
own metadata is unaffected; only the bundled sage_wheels/share/graphs
database files (used by a handful of graph-database-lookup functions) are
left out, same shape as this repo's existing bliss/mcqd/cliquer ports
which already run without the full sagemath-repl/-graphs test extras.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
diff --git a/pkgs/sagemath-graphs/pyproject.toml.m4 b/pkgs/sagemath-graphs/pyproject.toml.m4
index b29e70a..e7745d6 100644
--- a/pkgs/sagemath-graphs/pyproject.toml.m4
+++ b/pkgs/sagemath-graphs/pyproject.toml.m4
@@ -78,14 +78,12 @@ standard    = [
 
 [tool.cibuildwheel.linux]
 repair-wheel-command = [
-    'python3 -m pip install passagemath-conf auditwheel',
-    'python3 {package}/repair_wheel.py {wheel}',
+    'python3 -m pip install auditwheel',
     'auditwheel repair -w {dest_dir} {wheel}',
 ]
 [tool.cibuildwheel.macos]
 repair-wheel-command = [
-    'python3 -m pip install passagemath-conf auditwheel',
-    'python3 {package}/repair_wheel.py {wheel}',
+    'python3 -m pip install delocate',
     'delocate-wheel --require-archs {delocate_archs} -w {dest_dir} -v {wheel}',
 ]
 
