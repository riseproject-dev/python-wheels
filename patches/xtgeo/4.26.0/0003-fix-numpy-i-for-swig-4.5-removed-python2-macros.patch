From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 23 Oct 2026 16:30:00 +0000
Subject: [PATCH] fix numpy.i for SWIG >=4.5's removed Python 2 macros

SWIG 4.5.0 dropped the Python 2 compatibility macros from its
pyhead.swg runtime, including PyString_Check, PyInt_Check and
PyInt_AsLong. xtgeo's project-local src/lib/numpy.i still uses those
three, so with SWIG >=4.5 the generated cxtgeoPYTHON_wrap.c calls
undeclared functions: GCC 13 only warns, and the extension then fails
to import with "undefined symbol: PyInt_AsLong"; GCC 14 rejects the
implicit declarations outright. Reproduces on any arch.

Replace each with the exact expansion SWIG <=4.4's pyhead.swg used on
Python 3 (PyBytes_Check, PyLong_Check, PyLong_AsLong), so the generated
code is unchanged for every SWIG version.

Needed because 0001 drops the swig<4.3.0 pin, and pip then resolves
the newest swig (4.5.1), which is the release with a riscv64 wheel.

Upstream-Status: Inappropriate [only reachable once the swig<4.3.0 pin is dropped for riscv64; upstream's pinned SWIG still defines these macros]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 src/lib/numpy.i | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/lib/numpy.i b/src/lib/numpy.i
index 60eb016..ff3db39 100644
--- a/src/lib/numpy.i
+++ b/src/lib/numpy.i
@@ -112,8 +112,8 @@
     if (py_obj == NULL          ) return "C NULL value";
     if (py_obj == Py_None       ) return "Python None" ;
     if (PyCallable_Check(py_obj)) return "callable"    ;
-    if (PyString_Check(  py_obj)) return "string"      ;
-    if (PyInt_Check(     py_obj)) return "int"         ;
+    if (PyBytes_Check(   py_obj)) return "string"      ;
+    if (PyLong_Check(    py_obj)) return "int"         ;
     if (PyFloat_Check(   py_obj)) return "float"       ;
     if (PyDict_Check(    py_obj)) return "dict"        ;
     if (PyList_Check(    py_obj)) return "list"        ;
@@ -1999,7 +1999,7 @@
   (PyObject* array = NULL)
 {
   npy_intp dims[1];
-  if (!PyInt_Check($input))
+  if (!PyLong_Check($input))
   {
     const char* typestring = pytype_string($input);
     PyErr_Format(PyExc_TypeError,
@@ -2007,7 +2007,7 @@
                  typestring);
     SWIG_fail;
   }
-  $2 = (DIM_TYPE) PyInt_AsLong($input);
+  $2 = (DIM_TYPE) PyLong_AsLong($input);
   dims[0] = (npy_intp) $2;
   array = PyArray_SimpleNew(1, dims, DATA_TYPECODE);
   if (!array) SWIG_fail;
@@ -2027,7 +2027,7 @@
   (PyObject* array = NULL)
 {
   npy_intp dims[1];
-  if (!PyInt_Check($input))
+  if (!PyLong_Check($input))
   {
     const char* typestring = pytype_string($input);
     PyErr_Format(PyExc_TypeError,
@@ -2035,7 +2035,7 @@
                  typestring);
     SWIG_fail;
   }
-  $1 = (DIM_TYPE) PyInt_AsLong($input);
+  $1 = (DIM_TYPE) PyLong_AsLong($input);
   dims[0] = (npy_intp) $1;
   array = PyArray_SimpleNew(1, dims, DATA_TYPECODE);
   if (!array) SWIG_fail;
