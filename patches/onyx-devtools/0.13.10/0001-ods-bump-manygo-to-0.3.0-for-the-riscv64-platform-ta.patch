From 40ec726de6d8d1ceec717652c6f7b4394b916247 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 12 Oct 2026 20:05:16 +0000
Subject: [PATCH] ods: bump manygo to 0.3.0 for the riscv64 platform tag

Upstream-Status: To upstream [not submitted yet: onyx's release-devtools.yml builds no riscv64 wheel, so the bump cannot be exercised by upstream's own release workflow; needs a maintainer discussion first]

hatch_build.py asks manygo for the wheel's platform tag from GOOS and
GOARCH. manygo 0.2.0 only knows amd64/arm64/386/arm/s390x/ppc64le/ppc64,
so with GOARCH=riscv64 is_goarch() is false, no tag is set, and
hatchling falls back to the build host's own interpreter-specific tag
(cp312-cp312-manylinux_*_x86_64 when cross-compiling from x86_64) for a
wheel that holds a riscv64 binary.

manygo 0.3.0 adds riscv64 (manylinux_2_27_riscv64) and loong64 with the
same is_goos/is_goarch/get_platform_tag API. Every Linux and Windows
platform upstream already builds keeps its tag; only darwin/amd64 moves
from macosx_10_12 to macosx_11_0, the floor of the Go 1.26 toolchain
go.mod already requires.

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 tools/ods/pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/ods/pyproject.toml b/tools/ods/pyproject.toml
index 5e48a0f..d0c5eae 100644
--- a/tools/ods/pyproject.toml
+++ b/tools/ods/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["hatchling==1.29.0", "go-bin~=1.26.4", "manygo==0.2.0"]
+requires = ["hatchling==1.29.0", "go-bin~=1.26.4", "manygo==0.3.0"]
 build-backend = "hatchling.build"
 
 [project]
