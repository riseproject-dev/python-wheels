From afa7c8bd316bf4f53f02ccf55916b75618fd229a Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Mon, 7 Sep 2026 21:02:32 +0200
Subject: [PATCH] setup.py: don't require SIMD when building libjpeg-turbo on
 riscv64

libjpeg-turbo's simd/CMakeLists.txt only ships SIMD kernels for
x86/x86-64/Arm/MIPS/PowerPC; REQUIRE_SIMD=1 turns the unsupported-arch
warning into a hard cmake configure failure on riscv64. The option's
own default (off) already falls back to a portable non-SIMD build with
just a warning, so only force it on for the architectures that have a
kernel.

Upstream-Status: Inappropriate [libjpeg-turbo has no riscv64 SIMD kernels]

Signed-off-by: Ludovic Henry <git@ludovic.dev>
---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index bfcbf6b..52d9035 100644
--- a/setup.py
+++ b/setup.py
@@ -165,7 +165,7 @@ class cmake_build_ext(build_ext):
             *flags,
             '-DWITH_CRT_DLL=1',  # fixes https://bugs.python.org/issue24872
             '-DENABLE_SHARED=0',
-            '-DREQUIRE_SIMD=1',
+            '-DREQUIRE_SIMD=' + ('0' if ARCH == 'riscv64' else '1'),
             '-DCMAKE_POSITION_INDEPENDENT_CODE=ON',
         ], env=env)
 
