Upstream-Status: To upstream [not yet submitted; upstream commits prebuilt EPANET binaries per platform, so a linux-riscv64 set needs a maintainer discussion alongside this loader change]

wntr loads the EPANET 2.0/2.2 toolkit and EPANET-MSX shared libraries via
ctypes from prebuilt binaries committed under wntr/epanet/libepanet/.
Every Linux machine is routed to linux-x64/, which only holds x86_64
builds, so on riscv64 EpanetSimulator and the MSX toolkit fail with
"OSError: ... cannot open shared object file" / wrong ELF class.

Route riscv64 to a linux-riscv64/ directory with the same file names
(libepanet20.so, libepanet22.so, libepanet2.so, libepanetmsx.so) and
include it in MANIFEST.in so setuptools packages it. The libraries
themselves are compiled from the EPANET/EPANET-MSX sources by the build.

diff --git a/MANIFEST.in b/MANIFEST.in
index 9fc11d7..bad9a25 100644
--- a/MANIFEST.in
+++ b/MANIFEST.in
@@ -4,6 +4,7 @@ include wntr/epanet/libepanet/darwin-arm/*
 include wntr/epanet/libepanet/darwin-formula/*
 include wntr/epanet/libepanet/darwin-x64/*
 include wntr/epanet/libepanet/linux-x64/*
+include wntr/epanet/libepanet/linux-riscv64/*
 include wntr/epanet/libepanet/windows-x64/*
 include wntr/sim/aml/evaluator*
 include wntr/sim/aml/numpy.i
diff --git a/wntr/epanet/msx/toolkit.py b/wntr/epanet/msx/toolkit.py
index e777c60..d1bc1fe 100644
--- a/wntr/epanet/msx/toolkit.py
+++ b/wntr/epanet/msx/toolkit.py
@@ -55,6 +55,9 @@ class MSXepanet(ENepanet):
                 else:
                     libepanet = str(files('wntr.epanet').joinpath("libepanet/darwin-x64/libepanet2.dylib"))
                     libmsx = str(files('wntr.epanet').joinpath("libepanet/darwin-x64/libepanetmsx.dylib"))
+            elif platform.machine() == "riscv64":
+                libepanet = str(files('wntr.epanet').joinpath("libepanet/linux-riscv64/libepanet2.so"))
+                libmsx = str(files('wntr.epanet').joinpath("libepanet/linux-riscv64/libepanetmsx.so"))
             else:
                 libepanet = str(files('wntr.epanet').joinpath("libepanet/linux-x64/libepanet2.so"))
                 libmsx = str(files('wntr.epanet').joinpath("libepanet/linux-x64/libepanetmsx.so"))
diff --git a/wntr/epanet/toolkit.py b/wntr/epanet/toolkit.py
index eae6ba9..0218f68 100644
--- a/wntr/epanet/toolkit.py
+++ b/wntr/epanet/toolkit.py
@@ -26,6 +26,8 @@ elif sys.platform in ["darwin"]:
         libepanet = "libepanet/darwin-arm/libepanet2.dylib"
     else:
         libepanet = "libepanet/darwin-x64/libepanet22.dylib"
+elif platform.machine() == "riscv64":
+    libepanet = "libepanet/linux-riscv64/libepanet22.so"
 else:
     libepanet = "libepanet/linux-x64/libepanet22.so"
 
