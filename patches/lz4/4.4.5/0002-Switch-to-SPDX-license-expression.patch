From 6bab9bcb9195d8ec1aab5846440590f9cbe240ae Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 25 Aug 2026 16:50:55 +0200
Subject: [PATCH] Switch to SPDX license expression

setup.py declares the licence only through the deprecated
`License :: OSI Approved :: BSD License` classifier, so the built wheel's
METADATA carries neither `License-Expression:` nor `License:` and consumers
that read either -- our own docs generator included -- see no licence at all.

Declare `license='BSD-3-Clause'` and drop the classifier, which PEP 639
forbids alongside a licence expression.

Upstream-Status: Backport [https://github.com/python-lz4/python-lz4/pull/324]
---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 8f49a53..92c9acb 100644
--- a/setup.py
+++ b/setup.py
@@ -180,6 +180,7 @@ setup(
     long_description=open('README.rst', 'r').read(),
     author='Jonathan Underwood',
     author_email='jonathan.underwood@gmail.com',
+    license='BSD-3-Clause',
     license_files=[
         'LICENSE',
         'lz4libs/LICENSE',
@@ -201,7 +202,6 @@ setup(
     },
     classifiers=[
         'Development Status :: 5 - Production/Stable',
-        'License :: OSI Approved :: BSD License',
         'Intended Audience :: Developers',
         'Programming Language :: C',
         'Programming Language :: Python',
-- 
2.50.1 (Apple Git-155)

