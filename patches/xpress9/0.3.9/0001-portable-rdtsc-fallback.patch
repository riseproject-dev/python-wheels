Upstream-Status: To upstream [not yet submitted]

Xpress9EncLz77.c calls __rdtsc() unconditionally to seed the session
signature, but only defines it (or includes a header that does) on x86 and
ARM. On any other GCC/clang target, e.g. riscv64, this is an
implicit-declaration compile error. Use the existing clock_gettime-based
fallback for every non-x86 target and keep <arm_neon.h> ARM-only.

diff --git a/src/Xpress9EncLz77.c b/src/Xpress9EncLz77.c
index 5c614b6..0b75f60 100644
--- a/src/Xpress9EncLz77.c
+++ b/src/Xpress9EncLz77.c
@@ -7,9 +7,11 @@
         // x86/x64 architecture
         #include <x86intrin.h>
         // __rdtsc available from included header
-    #elif defined(__arm__) || defined(__aarch64__) || defined(__arm64__)
+    #else
+        #if defined(__arm__) || defined(__aarch64__) || defined(__arm64__)
         // ARM architecture (including Apple Silicon)
         #include <arm_neon.h>
+        #endif
         
         // Define alternative for __rdtsc as it's commonly used for timing
         #if defined(__APPLE__)
