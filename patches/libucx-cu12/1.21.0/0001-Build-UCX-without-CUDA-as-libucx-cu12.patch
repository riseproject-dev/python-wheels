From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Tue, 13 Oct 2026 00:00:00 +0000
Subject: [PATCH] Build UCX without CUDA as libucx-cu12

NVIDIA ships no CUDA toolkit for riscv64, so `--with-cuda=/usr/local/cuda`
makes UCX's configure fail ("CUDA support is requested but cuda packages
cannot be found") and rapids-build-backend aborts before that because it
derives the `-cu12` name suffix from `nvcc --version`.

CUDA is optional in UCX: it only adds the dlopen()ed libuct_cuda,
libucm_cuda and libucx_perftest_cuda modules, while libucs/libucm/libuct/
libucp link no CUDA library. Configure `--without-cuda`, disable
rapids-build-backend's CUDA detection, and keep the distribution name
consumers depend on (libucxx-cu12 requires libucx-cu12).

Upstream-Status: Inappropriate [riscv64 has no CUDA toolkit; upstream's wheels are CUDA builds by design]
---
 python/libucx/pyproject.toml | 3 ++-
 python/libucx/setup.py       | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)
diff --git a/python/libucx/pyproject.toml b/python/libucx/pyproject.toml
index a55467c..3c4972e 100644
--- a/python/libucx/pyproject.toml
+++ b/python/libucx/pyproject.toml
@@ -8,7 +8,7 @@ requires = [
 ]
 
 [project]
-name = "libucx"
+name = "libucx-cu12"
 dynamic = ["version"]
 description = "The Unified Communication X library (UCX)"
 readme = { file = "README.md", content-type = "text/markdown" }
@@ -47,6 +47,7 @@ commit-files = [
     "libucx/GIT_COMMIT"
 ]
 dependencies-file = ""
+disable-cuda = true
 requires = [
     "packaging",
     "wheel",
diff --git a/python/libucx/setup.py b/python/libucx/setup.py
index 6ac7a0d..569cfed 100644
--- a/python/libucx/setup.py
+++ b/python/libucx/setup.py
@@ -60,7 +60,7 @@ class build_py(build_orig):
                             "--with-sysroot",
                             "--without-verbs",
                             "--without-rdmacm",
-                            "--with-cuda=/usr/local/cuda",
+                            "--without-cuda",
                         ],
                         check=True,
                     )
