From fa1b10b493a429e6b7294370c4b265018537b31f Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Fri, 23 Oct 2026 23:04:00 +0000
Subject: [PATCH 1/2] Ship the MIT license file in the wheel

meson-python only writes a licence file into the wheel's dist-info from
pyproject.toml's [project] license key. pyproject.toml declares
license = {text = "MIT"}, so every published wheel (verified on PyPI's
mahotas-1.4.19 manylinux/macOS/Windows wheels) ships no licence file.

mahotas pins meson-python>=0.17.1,<0.18, and meson-python 0.17.1 has
no PEP 639 license-files support: it only copies the file named by the
legacy table form license = {file = ...}, to dist-info/<name>. Adding
license-files = ["COPYING"] instead is a hard error at wheel-build time
on every interpreter ("project.license-files" must not be used when
"project.license" is not a SPDX license expression), and switching
license to an SPDX string as well is rejected next because of the
"License :: OSI Approved :: MIT License" classifier. Even with both
changed, 0.17.1 would only write License-File: into METADATA, never the
file itself.

Point the table form at the COPYING file that exists at the repo root.
That ships dist-info/COPYING, which holds the MIT text and the BSL-1.0
text for the dlib-derived SURF code. The classifier stays valid.

Upstream-Status: To upstream [not yet submitted; same gap exists in every mahotas wheel on PyPI and on upstream master]
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index cea8458..d736461 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -13,7 +13,7 @@ dynamic = ["version"]
 description = "Mahotas: Computer Vision Library"
 readme = "README.md"
 requires-python = ">=3.10"
-license = {text = "MIT"}
+license = {file = "COPYING"}
 authors = [
     {name = "Luis Pedro Coelho", email = "luis@luispedro.org"},
 ]
