From cb24278661cb0ed10ca5a5aa0926f0c4c5ca3144 Mon Sep 17 00:00:00 2001
From: Ludovic Henry <git@ludovic.dev>
Date: Thu, 15 Oct 2026 15:41:58 +0000
Subject: [PATCH] Ship the MIT license file in the wheel

meson-python only writes dist-info/licenses/<f> for files listed in
[project] license-files; the PEP 639 default LICEN[CS]E*/COPYING*
glob that scikit-build-core/setuptools apply is not implemented by
meson-python (gotcha 320). pyproject.toml declares license = {text
= "MIT"} with no license-files key, so every published wheel
(verified on PyPI's mahotas-1.4.19 manylinux/macOS/Windows wheels)
ships no license file at all in dist-info/licenses/.

Point license-files at the COPYING file that actually exists at the
repo root so the wheel carries the MIT text it declares.

Upstream-Status: To upstream [not yet submitted; same gap exists in every mahotas wheel on PyPI historically]
---
 pyproject.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/pyproject.toml b/pyproject.toml
index cea8458..538a3ef 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -14,6 +14,7 @@ description = "Mahotas: Computer Vision Library"
 readme = "README.md"
 requires-python = ">=3.10"
 license = {text = "MIT"}
+license-files = ["COPYING"]
 authors = [
     {name = "Luis Pedro Coelho", email = "luis@luispedro.org"},
 ]
-- 
