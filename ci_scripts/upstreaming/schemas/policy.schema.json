{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed pipeline policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "read_only",
    "control_repo",
    "fork_org",
    "dev_ref",
    "native_runner_label",
    "command_authority",
    "intake",
    "concurrency",
    "retries",
    "capacity",
    "storage",
    "human_sla_business_days",
    "recovery_minutes",
    "allowed_state_root"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_version": {
      "type": "string"
    },
    "read_only": {
      "type": "boolean"
    },
    "control_repo": {
      "const": "riseproject-dev/python-wheels"
    },
    "fork_org": {
      "const": "riseproject-upstreaming"
    },
    "dev_ref": {
      "const": "riscv64"
    },
    "native_runner_label": {
      "const": "ubuntu-24.04-riscv"
    },
    "command_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_ids",
        "team"
      ],
      "properties": {
        "actor_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "team": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_request_bytes",
        "max_distributions",
        "max_requests_per_actor_per_day",
        "max_active_per_upstream"
      ],
      "properties": {
        "max_request_bytes": {
          "type": "integer"
        },
        "max_distributions": {
          "type": "integer"
        },
        "max_requests_per_actor_per_day": {
          "type": "integer"
        },
        "max_active_per_upstream": {
          "const": 1
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coding_workers",
        "writer_operations_per_fork"
      ],
      "properties": {
        "coding_workers": {
          "type": "integer",
          "minimum": 0
        },
        "writer_operations_per_fork": {
          "const": 1
        }
      }
    },
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infrastructure_per_head_failure",
        "flaky_reruns",
        "patch_attempts_per_cluster",
        "no_progress_review_after",
        "max_attempts_per_contribution"
      ],
      "properties": {
        "infrastructure_per_head_failure": {
          "type": "integer"
        },
        "flaky_reruns": {
          "type": "integer"
        },
        "patch_attempts_per_cluster": {
          "type": "integer"
        },
        "no_progress_review_after": {
          "type": "integer"
        },
        "max_attempts_per_contribution": {
          "type": "integer"
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_url",
        "max_age_seconds",
        "max_pending_jobs_rise",
        "max_pending_age_seconds"
      ],
      "properties": {
        "usage_url": {
          "type": "string"
        },
        "max_age_seconds": {
          "type": "integer"
        },
        "max_pending_jobs_rise": {
          "type": "integer"
        },
        "max_pending_age_seconds": {
          "type": "integer"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_record_bytes",
        "max_event_bytes",
        "max_commit_bytes",
        "warn_total_bytes"
      ],
      "properties": {
        "max_record_bytes": {
          "type": "integer"
        },
        "max_event_bytes": {
          "type": "integer"
        },
        "max_commit_bytes": {
          "type": "integer"
        },
        "warn_total_bytes": {
          "type": "integer"
        }
      }
    },
    "human_sla_business_days": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledge",
        "reminder",
        "escalate",
        "decide"
      ],
      "properties": {
        "acknowledge": {
          "type": "integer"
        },
        "reminder": {
          "type": "integer"
        },
        "escalate": {
          "type": "integer"
        },
        "decide": {
          "type": "integer"
        }
      }
    },
    "recovery_minutes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "allowed_state_root": {
      "const": "upstreaming-state"
    }
  }
}
