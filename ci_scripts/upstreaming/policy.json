{
  "schema_version": 1,
  "policy_version": "2026-11-18.1-proposed",
  "read_only": true,
  "control_repo": "riseproject-dev/python-wheels",
  "fork_org": "riseproject-upstreaming",
  "dev_ref": "riscv64",
  "native_runner_label": "ubuntu-24.04-riscv",
  "command_authority": {
    "actor_ids": [],
    "team": null
  },
  "intake": {
    "max_request_bytes": 16384,
    "max_distributions": 32,
    "max_requests_per_actor_per_day": 5,
    "max_active_per_upstream": 1
  },
  "concurrency": {
    "coding_workers": 1,
    "writer_operations_per_fork": 1
  },
  "retries": {
    "infrastructure_per_head_failure": 2,
    "flaky_reruns": 1,
    "patch_attempts_per_cluster": 3,
    "no_progress_review_after": 2,
    "max_attempts_per_contribution": 12
  },
  "capacity": {
    "usage_url": "https://riseriscvrunnerappqdvknz9s-scheduler.functions.fnc.fr-par.scw.cloud/usage.json",
    "max_age_seconds": 900,
    "max_pending_jobs_rise": 100,
    "max_pending_age_seconds": 7200
  },
  "storage": {
    "max_record_bytes": 262144,
    "max_event_bytes": 65536,
    "max_commit_bytes": 2097152,
    "warn_total_bytes": 104857600
  },
  "human_sla_business_days": {
    "acknowledge": 2,
    "reminder": 3,
    "escalate": 5,
    "decide": 10
  },
  "recovery_minutes": [1, 5, 15, 60],
  "allowed_state_root": "upstreaming-state"
}
