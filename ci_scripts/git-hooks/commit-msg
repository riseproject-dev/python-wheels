#!/bin/sh
# SPDX-FileCopyrightText: 2026 The RISE Project
# SPDX-License-Identifier: MIT
#
# Installed via `git config core.hooksPath ci_scripts/git-hooks` (see
# ci_scripts/check_no_ai_attribution.sh for what this actually checks and why).
# Resolve against the shared clone's main checkout, not this worktree's own
# tree: a worktree checked out from a branch that predates this script would
# otherwise report "not found" even though the hook itself (found via the
# shared core.hooksPath) runs fine.
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
main_toplevel="$(dirname "$common_dir")"
exec "$main_toplevel/ci_scripts/check_no_ai_attribution.sh" "$1"
