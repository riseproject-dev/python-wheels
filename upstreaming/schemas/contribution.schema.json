{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstreaming contribution lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "project_id",
    "revision",
    "phase",
    "activity",
    "paused",
    "tracking_issue",
    "owners",
    "upstream",
    "budget",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "enum": [
        "queued",
        "investigation",
        "provisioning",
        "development",
        "handoff",
        "upstream_review",
        "release_wait",
        "released",
        "parked",
        "no_work",
        "deferred",
        "abandoned",
        "already_released"
      ]
    },
    "activity": {
      "enum": [
        "idle",
        "agent_running",
        "waiting_ci",
        "fix_needed",
        "waiting_capacity",
        "waiting_human"
      ]
    },
    "paused": {
      "type": "boolean"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "parked_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "terminal_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "previous_phase": {
      "enum": [
        "queued",
        "investigation",
        "provisioning",
        "development",
        "handoff",
        "upstream_review",
        "release_wait",
        "released",
        "parked",
        "no_work",
        "deferred",
        "abandoned",
        "already_released",
        null
      ]
    },
    "tracking_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "backup",
        "submitter",
        "handoff_reviewer"
      ],
      "properties": {
        "primary": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "backup": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "submitter": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff_reviewer": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "admission_class": {
      "enum": [
        "configuration_integration",
        "architecture_correctness",
        "optimized_backend",
        null
      ]
    },
    "distributions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "full_name",
        "base_ref",
        "base_sha"
      ],
      "properties": {
        "repository_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "fork": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "name",
            "head_ref",
            "head_sha",
            "pr_number"
          ],
          "properties": {
            "repository_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^riseproject-upstreaming/[A-Za-z0-9_.-]+$"
            },
            "head_ref": {
              "const": "riscv64"
            },
            "head_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "pr_number": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "upstream_pr": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "number",
            "url",
            "head_repository_id",
            "head_ref",
            "head_sha",
            "base_ref",
            "registered_by"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "number": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            },
            "head_repository_id": {
              "type": "integer"
            },
            "head_ref": {
              "type": "string"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "base_ref": {
              "type": "string"
            },
            "registered_by": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            }
          }
        }
      ]
    },
    "target_contract_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
      }
    },
    "active_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "queue_work_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "queue_claim_handle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "queue_result_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "debug_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "subject",
          "reason"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "subject": {
            "type": "string",
            "pattern": "^\\{debug\\}"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "clean_head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "handoff_request": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "head",
            "revision"
          ],
          "properties": {
            "command_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "revision": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "handoff_approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "actor",
            "head",
            "revision",
            "evidence_ids"
          ],
          "properties": {
            "command_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "revision": {
              "type": "integer"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
              }
            }
          }
        }
      ]
    },
    "last_ci_evidence_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "merge_sha",
            "merged_at",
            "target_ref",
            "evidence_id"
          ],
          "properties": {
            "merge_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "merged_at": {
              "type": "string",
              "format": "date-time"
            },
            "target_ref": {
              "type": "string"
            },
            "evidence_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            }
          }
        }
      ]
    },
    "retirement": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch_deleted",
            "fork_archived",
            "issue_closed",
            "operation_ids"
          ],
          "properties": {
            "branch_deleted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "fork_archived": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "issue_closed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "operation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
              }
            }
          }
        }
      ]
    },
    "release_acceptance": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_id",
            "as_of",
            "complete"
          ],
          "properties": {
            "evidence_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "complete": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "attempts_used"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "attempts_used": {
          "type": "integer",
          "minimum": 0
        },
        "no_progress_streak": {
          "type": "integer",
          "minimum": 0
        },
        "clusters": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "spent_estimate_usd_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pending_human_action": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requested_at",
            "reminded_at",
            "escalated_at"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "requested_at": {
              "type": "string",
              "format": "date-time"
            },
            "reminded_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "escalated_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      ]
    },
    "follows": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_poll_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
