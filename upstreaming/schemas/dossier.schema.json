{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstream investigation research-completeness contract",
  "type": "object",
  "required": ["schema_version", "contribution_id", "expected_revision", "tracking_issue_description_digest", "summary", "research", "history", "maintainers", "dependency_graph", "ecosystem_report", "proposal"],
  "properties": {
    "schema_version": {"const": 1},
    "contribution_id": {"type": "string", "minLength": 1, "maxLength": 127},
    "expected_revision": {"type": "integer", "minimum": 0},
    "tracking_issue_description_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 40, "maxLength": 8000},
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracking_issue", "upstream_issues", "upstream_pull_requests", "ci_history", "documentation", "website", "mailing_lists", "blogs", "maintainer_reviews", "release_repositories", "ecosystem_report"],
      "properties": {
        "tracking_issue": {"$ref": "#/$defs/research"},
        "upstream_issues": {"$ref": "#/$defs/research"},
        "upstream_pull_requests": {"$ref": "#/$defs/research"},
        "ci_history": {"$ref": "#/$defs/research"},
        "documentation": {"$ref": "#/$defs/research"},
        "website": {"$ref": "#/$defs/research"},
        "mailing_lists": {"$ref": "#/$defs/research"},
        "blogs": {"$ref": "#/$defs/research"},
        "maintainer_reviews": {"$ref": "#/$defs/research"},
        "release_repositories": {"$ref": "#/$defs/research"},
        "ecosystem_report": {"$ref": "#/$defs/research"}
      }
    },
    "history": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["url", "outcome", "decision", "reviewers", "review_urls"],
        "properties": {
          "url": {"$ref": "#/$defs/url"},
          "outcome": {"enum": ["accepted", "rejected", "open", "closed_unmerged", "superseded"]},
          "decision": {"type": "string", "minLength": 20, "maxLength": 4000},
          "reviewers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "review_urls": {"type": "array", "items": {"$ref": "#/$defs/url"}}
        }
      }
    },
    "maintainers": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "required": ["name", "role", "sources"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 10, "maxLength": 2000},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}}
        }
      }
    },
    "dependency_graph": {
      "type": "object",
      "required": ["tool", "success", "canonical_project", "query", "result", "assessment"],
      "properties": {
        "tool": {"const": "project_graph_query"},
        "success": {"const": true},
        "canonical_project": {"type": "string", "minLength": 1, "maxLength": 200},
        "query": {"type": "object", "minProperties": 1},
        "result": {"type": ["object", "array"], "minProperties": 1, "minItems": 1},
        "assessment": {"type": "string", "minLength": 40, "maxLength": 8000}
      }
    },
    "ecosystem_report": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "absent"]},
        "url": {"$ref": "#/$defs/url"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 100},
        "riscv64_status": {"type": "string", "minLength": 40, "maxLength": 8000},
        "used_findings": {
          "type": "object", "additionalProperties": false,
          "required": ["support_status", "dependencies", "prior_work_and_blockers"],
          "properties": {
            "support_status": {"type": "string", "minLength": 40, "maxLength": 4000},
            "dependencies": {"type": "string", "minLength": 40, "maxLength": 4000},
            "prior_work_and_blockers": {"type": "string", "minLength": 40, "maxLength": 4000}
          }
        },
        "corroboration_and_conflicts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}}
      },
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {"required": ["url", "revision", "riscv64_status", "used_findings", "corroboration_and_conflicts"]}
    },
    "proposal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["decision", "rationale", "admission_class", "allowed_paths"],
      "properties": {
        "decision": {"enum": ["develop", "park"]},
        "rationale": {"type": "string", "minLength": 40, "maxLength": 8000},
        "admission_class": {"enum": ["configuration_integration", "architecture_correctness", "optimized_backend", null]},
        "allowed_paths": {
          "type": "array", "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "develop"}}},
          "then": {"properties": {"admission_class": {"type": "string"}, "allowed_paths": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"decision": {"const": "park"}}},
          "then": {"properties": {"admission_class": {"type": "null"}, "allowed_paths": {"maxItems": 0}}}
        }
      ]
    }
  },
  "$defs": {
    "url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2000},
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "queries", "coverage", "sources", "findings"],
      "properties": {
        "status": {"enum": ["searched", "not_applicable"]},
        "queries": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 3, "maxLength": 2000}},
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["complete", "scope"],
          "properties": {
            "complete": {"const": true},
            "scope": {"type": "string", "minLength": 30, "maxLength": 4000}
          }
        },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "finding"],
            "properties": {
              "url": {"$ref": "#/$defs/url"},
              "finding": {"type": "string", "minLength": 20, "maxLength": 4000}
            }
          }
        },
        "findings": {"type": "string", "minLength": 40, "maxLength": 8000},
        "justification": {"type": "string", "minLength": 40, "maxLength": 4000}
      },
      "if": {"properties": {"status": {"const": "not_applicable"}}},
      "then": {"required": ["justification"]}
    }
  }
}
