{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence record (CI, release acceptance, dossier, probe)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "policy_version",
    "collected_at",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "contribution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "ci",
        "probe",
        "release_acceptance",
        "dossier",
        "target_contract",
        "rehearsal",
        "benchmark",
        "merge",
        "human_relay",
        "resolution"
      ]
    },
    "policy_version": {
      "type": "string"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "debug_present": {
      "type": "boolean"
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "type": "integer"
        },
        "repository": {
          "type": "string"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "test_merge_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_id": {
          "type": "integer"
        },
        "workflow_path": {
          "type": "string"
        },
        "workflow_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "event": {
          "type": "string"
        },
        "run_id": {
          "type": "integer"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "job_id",
              "name",
              "status",
              "conclusion",
              "executed",
              "runner_labels"
            ],
            "properties": {
              "job_id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "conclusion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "executed": {
                "type": "boolean"
              },
              "runner_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "expected_wheels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "filename",
              "sha256",
              "producer_job_id"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "producer_job_id": {
                "type": "integer"
              }
            }
          }
        }
      },
      "required": [
        "repository_id",
        "head_sha",
        "workflow_path",
        "event",
        "run_id",
        "run_attempt",
        "jobs"
      ]
    },
    "data": {
      "type": "object"
    },
    "digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
