{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recoverable remote-effect intent and receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "contribution_id",
    "revision",
    "kind",
    "policy_version",
    "target",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "branch_update",
        "branch_rewrite",
        "dev_pr_create",
        "dev_pr_update",
        "ci_dispatch",
        "ci_rerun",
        "notification",
        "branch_delete",
        "fork_archive",
        "issue_close",
        "fork_provision"
      ]
    },
    "policy_version": {
      "type": "string"
    },
    "reason_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_head": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "proposed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tree": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capacity_reservation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selector",
            "estimated_jobs",
            "estimated_minutes",
            "observed_run_ids"
          ],
          "properties": {
            "selector": {
              "type": "string"
            },
            "estimated_jobs": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "observed_run_ids": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "status": {
      "enum": [
        "planned",
        "applying",
        "confirmed",
        "uncertain",
        "failed",
        "not_launched"
      ]
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer"
        ]
      }
    },
    "discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "result",
          "detail"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "enum": [
              "confirmed",
              "absent",
              "unrelated",
              "error"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "resolution": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "disposition",
            "evidence_id",
            "command_id"
          ],
          "properties": {
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            "disposition": {
              "enum": [
                "confirmed",
                "not-launched",
                "failed"
              ]
            },
            "evidence_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            "command_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
