{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic lifecycle transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "sequence",
    "at",
    "kind",
    "cause",
    "revision_bumped"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "maxLength": 64
    },
    "from": {
      "type": "object"
    },
    "to": {
      "type": "object"
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "command",
            "observation",
            "result",
            "policy",
            "migration"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "revision_bumped": {
      "type": "boolean"
    }
  }
}
