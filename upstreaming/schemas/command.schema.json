{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumed control command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "comment_id",
    "issue_number",
    "content_digest",
    "command_version",
    "verb",
    "args",
    "actor",
    "result",
    "received_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "comment_id": {
      "type": "integer",
      "minimum": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "command_version": {
      "const": 1
    },
    "verb": {
      "type": "string"
    },
    "args": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "login": {
          "type": "string",
          "maxLength": 39
        }
      }
    },
    "contribution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "result": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
