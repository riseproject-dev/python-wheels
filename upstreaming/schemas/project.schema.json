{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstream project index record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "upstream",
    "parked",
    "contribution_ids",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "full_name"
      ],
      "properties": {
        "repository_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "distributions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    },
    "parked": {
      "type": "boolean"
    },
    "parked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "contribution_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
      }
    },
    "active_contribution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requires_project_id",
          "distribution",
          "version_range",
          "constraints",
          "kind",
          "index_policy",
          "evidence_id",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          },
          "requires_project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          },
          "distribution": {
            "type": "string"
          },
          "version_range": {
            "type": [
              "string",
              "null"
            ]
          },
          "constraints": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "release",
              "build"
            ]
          },
          "index_policy": {
            "enum": [
              "pypi",
              "rise-index-temporary"
            ]
          },
          "evidence_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "login"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "login": {
                    "type": "string",
                    "maxLength": 39
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "dossier_evidence_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_observation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "next_poll_at",
            "last_seen_version"
          ],
          "properties": {
            "next_poll_at": {
              "type": "string",
              "format": "date-time"
            },
            "last_seen_version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
