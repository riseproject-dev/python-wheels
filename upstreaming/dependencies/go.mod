// Dependabot inventory for stable gh-aw releases. This is not a Go application.
// A gh-aw update also requires reviewed binary hashes, regenerated workflows,
// and compatibility-patch regression tests before it can be merged.
module riseproject.dev/python-wheels/upstreaming-dependency-monitor

go 1.25.0

require github.com/github/gh-aw v1.2.2
